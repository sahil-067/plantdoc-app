public class SetuLeadWhatsAppService {

    @future(callout=true)
    public static void sendWelcomeWhatsAppAsync(Set<Id> leadIds) {
        List<Lead> leads = [
            SELECT Id, Name, FirstName, MobilePhone, LeadSource, Status 
            FROM Lead 
            WHERE Id IN :leadIds
        ];
        
        if (leads.isEmpty()) return;

        // 1. Get Token first using your Generate_Token metadata record
        String token = generateSetuToken();
        if (String.isBlank(token)) {
            System.debug('Failed to generate Setu Token.');
            return;
        }

        // 2. Load the Send_Bill metadata
        Setu_Send_Bill__mdt sendMdt = Setu_Send_Bill__mdt.getInstance('Send_Bill');
        if (sendMdt == null) return;

        List<Api_Logs__c> logsToInsert = new List<Api_Logs__c>();
        Http http = new Http();

        for (Lead ld : leads) {
            HttpRequest request = new HttpRequest();
            HttpResponse response = new HttpResponse();
            
            try {
                // Clean mobile number (ensure 10 digits before adding '91')
                String cleanMobile = ld.MobilePhone.replaceAll('[^0-9]', '');
                if (cleanMobile.length() > 10) {
                    cleanMobile = cleanMobile.right(10);
                }

                request.setEndpoint(sendMdt.Endpoint_URl__c);
                request.setMethod(sendMdt.Method__c);
                request.setHeader('Content-Type', sendMdt.Content_Type__c);
                request.setHeader('X-Setu-Product-Instance-ID', sendMdt.X_Setu_Product_Instance_ID__c);
                request.setHeader('x-setu-client-id', sendMdt.x_setu_client_id__c);
                request.setHeader('Authorization', 'Bearer ' + token);

                // Replace 'csc_lead_welcome_template' with the actual campaignID once registered
                String templateId = 'csc_lead_welcome_template'; 
                
                // Add as many template variables here as registered in your template
                String templateParams = '"customer_name":"' + ld.Name + '","lead_id":"' + ld.Id + '"';

                // Construct body (adjust 'bill' section based on your team's confirmation)
                Datetime expiryDT = Date.today().toStartOfMonth().addMonths(1).addDays(-1);
                String expiryDate = expiryDT.formatGmt('yyyy-MM-dd\'T\'HH:mm:ss\'Z\'').split('T')[0] + 'T20:55:22Z';
                String billerBillID = '91' + cleanMobile + '_' + ld.Id;

                String body = '{"bill":{"amount":{"value":0,"currencyCode":"INR"},' +
                              '"additionalInfo":{"destination":"91' + cleanMobile + '","referenceID":"' + ld.Id + '"},' +
                              '"billerBillID":"' + billerBillID + '","amountExactness":"EXACT","expiryDate":"' + expiryDate + '"},' +
                              '"channels":[{"destination":"91' + cleanMobile + '","campaignID":"' + templateId + '","channel":"whatsapp",' +
                              '"template":{' + templateParams + '}}]}';

                request.setBody(body);

                if (!Test.isRunningTest()) {
                    response = http.send(request);
                } else {
                    response.setBody('{"success":true,"status":"SUCCESS"}');
                    response.setStatusCode(200);
                }

                Api_Logs__c log = new Api_Logs__c();
                log.Name = 'Setu_Lead_WhatsApp_API';
                log.API_Request__c = request.getBody();
                log.API_Response__c = response.getBody();
                logsToInsert.add(log);

            } catch (Exception e) {
                Api_Logs__c errorLog = new Api_Logs__c();
                errorLog.Name = 'Setu_Lead_WhatsApp_API_Error';
                errorLog.API_Request__c = request.getBody();
                errorLog.API_Response__c = 'Exception: ' + e.getMessage() + ' Line: ' + e.getLineNumber();
                logsToInsert.add(errorLog);
            }
        }

        // Insert all logs at the very end (After all callouts are complete!)
        if (!logsToInsert.isEmpty()) {
            insert logsToInsert;
        }
    }

    // Helper method to get Token from your 1st metadata entry
    private static String generateSetuToken() {
        // Check your existing Token Generation class to see how they fetch the token!
        // Usually, there is already a method like SetuGenerateTokenAPI.getToken() in your org.
        return 'YOUR_EXISTING_TOKEN_METHOD_CALL';
    }
}
