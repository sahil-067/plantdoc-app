    @isTest
    static void testGetChecklistData_Success() {
        // Create a fresh Admin user to bypass FLS/Record Type limitations
        Profile adminProfile = [SELECT Id FROM Profile WHERE Name = 'System Administrator' LIMIT 1];
        User trueAdmin = new User(
            Alias = 'tadmin', Email = 'trueadmin@testorg.com', EmailEncodingKey = 'UTF-8',
            LastName = 'TrueAdmin', LanguageLocaleKey = 'en_US', LocaleSidKey = 'en_US',
            ProfileId = adminProfile.Id, TimeZoneSidKey = 'America/Los_Angeles',
            UserName = 'trueadmin' + DateTime.now().getTime() + '@testorg.com'
        );
        insert trueAdmin;

        System.runAs(trueAdmin) {
            Disbursement__c disb = [SELECT Id, Application__c FROM Disbursement__c LIMIT 1];
            
            // Force insert the mandates as the True Admin so they exist for the query
            Map<String, Schema.RecordTypeInfo> nupayRtMap = Schema.SObjectType.Nupay_Response__c.getRecordTypeInfosByName();
            List<Nupay_Response__c> mandatesToCover = new List<Nupay_Response__c>();
            
            if (nupayRtMap.containsKey('Register ACH EMI')) {
                mandatesToCover.add(new Nupay_Response__c(
                    Opportunity__c = disb.Application__c,
                    RecordTypeId = nupayRtMap.get('Register ACH EMI').getRecordTypeId(),
                    Account_Holder_Name__c = 'EMI Holder',
                    Bank_Account_No__c = '123456789',
                    Mandate_Status__c = 'Active'
                ));
            }
            if (nupayRtMap.containsKey('Register SPDC')) {
                mandatesToCover.add(new Nupay_Response__c(
                    Opportunity__c = disb.Application__c,
                    RecordTypeId = nupayRtMap.get('Register SPDC').getRecordTypeId(),
                    Account_Holder_Name__c = 'SPDC Holder',
                    Bank_Account_No__c = '987654321',
                    Mandate_Status__c = 'Active'
                ));
            }
            
            if (!mandatesToCover.isEmpty()) {
                insert mandatesToCover;
            }

            Test.startTest();
            // Call the method - the query will now find the records and run the red block
            UWDMChecklistController.ChecklistWrapper wrapper = UWDMChecklistController.getChecklistData(disb.Id);
            Test.stopTest();

            System.assertNotEquals(null, wrapper);
        }
    }
