                   Contact.City__c, Contact.State__c, Contact.Pin_Code__c,
                   Contact.Communication_Address_Line_1__c, Contact.Communication_Address_Line_2__c,
                   Contact.Communication_Address_Line_3__c, Contact.Communication_District__c,
                   Contact.Communication_City__c, Contact.Communication_State__c,
                   Contact.Communication_Pincode__c,
                   Contact.Address_Office__c, Contact.Address_Office_2__c, Contact.Address_Office_3__c,
                   Contact.City_Office__c, Contact.State_Office__c, Contact.Pin_Code_Office__c
            FROM OpportunityContactRole
            WHERE OpportunityId = :applicationId
        ]) {
            CollateralAddressData row = new CollateralAddressData();
            row.contactName = ocr.Contact.Name;
            row.role = ocr.Role;
            row.residentialAddress = joinAddressParts(new List<Object>{
                ocr.Contact.Address_Line_1__c, ocr.Contact.Address_Line_2__c,
                ocr.Contact.Address_Line_3__c, ocr.Contact.City__c,
                ocr.Contact.State__c, ocr.Contact.Pin_Code__c
            });
            row.communicationAddress = joinAddressParts(new List<Object>{
                ocr.Contact.Communication_Address_Line_1__c, ocr.Contact.Communication_Address_Line_2__c,
                ocr.Contact.Communication_Address_Line_3__c, ocr.Contact.Communication_District__c,
                ocr.Contact.Communication_City__c, ocr.Contact.Communication_State__c,
                ocr.Contact.Communication_Pincode__c
            });
            row.businessAddress = joinAddressParts(new List<Object>{
                ocr.Contact.Address_Office__c, ocr.Contact.Address_Office_2__c,
                ocr.Contact.Address_Office_3__c, ocr.Contact.City_Office__c,
                ocr.Contact.State_Office__c, ocr.Contact.Pin_Code_Office__c
            });

            if (ocr.Role == 'Loan - Main Applicant' || ocr.Role == 'Main Applicant') {
                result.addresses.add(row);
            } else {
                others.add(row);
            }
        }

        result.addresses.addAll(others);
        return result;
    }

    private static String joinAddressParts(List<Object> parts) {
        List<String> out = new List<String>();
        for (Object part : parts) {
            if (part != null && String.isNotBlank(String.valueOf(part))) {
                out.add(String.valueOf(part));
            }
        }
        return String.join(out, ', ');
    }

    /**
     * Returns all PDD__c records related to the given Application
     * (Opportunity) via PDD__c.Opportunity__c. Read-only; used only
     * by the PDD Aspect tab.
     */
    @AuraEnabled(cacheable=true)
    public static List<PddData> getPddRecords(Id applicationId) {
        List<PddData> result = new List<PddData>();

        if (applicationId == null) {
            return result;
        }

        for (PDD__c p : [
            SELECT Id, Name, Document_Name__c, Document_Received__c,
                   Document_Type__c, Document_Category__c,
                   Date_of_Disbursement__c
            FROM PDD__c
            WHERE Opportunity__c = :applicationId
            ORDER BY Document_Name__c ASC, Name ASC
            LIMIT 500
        ]) {
            PddData d = new PddData();
            d.id = p.Id;
            d.pddName = p.Name;
            d.documentName = p.Document_Name__c;
            d.documentReceived = p.Document_Received__c == null
                ? null : String.valueOf(p.Document_Received__c);
            d.documentType = p.Document_Type__c == null
                ? null : String.valueOf(p.Document_Type__c);
            d.documentCategory = p.Document_Category__c == null
                ? null : String.valueOf(p.Document_Category__c);
            d.dateOfDisbursement = p.Date_of_Disbursement__c == null
                ? null : p.Date_of_Disbursement__c.format();
            result.add(d);
        }

        return result;
    }

