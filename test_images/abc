    private static void putFirstActivePicklistValue(
        SObject recordValue,
        String fieldApiName
    ) {
        Map<String, Schema.SObjectField> fields =
            recordValue.getSObjectType()
            .getDescribe()
            .fields
            .getMap();
        
        if (!fields.containsKey(fieldApiName)) {
            return;
        }
        
        Schema.DescribeFieldResult fieldDescribe =
            fields.get(fieldApiName).getDescribe();
        
        if (!fieldDescribe.isCreateable()) {
            return;
        }
        
        if (
            fieldDescribe.getType() != Schema.DisplayType.Picklist
            && fieldDescribe.getType() != Schema.DisplayType.MultiPicklist
        ) {
            return;
        }
        
        for (
            Schema.PicklistEntry picklistValue :
            fieldDescribe.getPicklistValues()
        ) {
            if (picklistValue.isActive()) {
                recordValue.put(
                    fieldApiName,
                    picklistValue.getValue()
                );
                return;
            }
        }
    }
    
    private static Boolean isUpdateable(
        Schema.SObjectType objectType,
        String fieldApiName
    ) {
        Map<String, Schema.SObjectField> fields =
            objectType.getDescribe().fields.getMap();
        
        return fields.containsKey(fieldApiName)
            && fields.get(fieldApiName).getDescribe().isUpdateable();
    }
    
    private static void setOtpValue(
        Id applicantId,
        String fieldApiName,
        String otp
    ) {
        if (!isUpdateable(Account.SObjectType, fieldApiName)) {
            return;
        }
        
        Account applicantToUpdate = new Account(Id = applicantId);
        applicantToUpdate.put(fieldApiName, otp);
        update applicantToUpdate;
    }
    
    private static Boolean hasTestApplication() {
        return ![
            SELECT Id
            FROM Opportunity
            WHERE Name = :TEST_APPLICATION_NAME
            LIMIT 1
        ].isEmpty();
    }
    
    private static Boolean hasTestApplicant() {
        return ![
            SELECT Id
            FROM Account
            WHERE FirstName = 'Apex'
            AND LastName = 'Applicant'
            LIMIT 1
        ].isEmpty();
    }
    
    private static Boolean hasCustomerMobile() {
        List<Account> applicants = [
            SELECT Mobile__pc
            FROM Account
            WHERE FirstName = 'Apex'
            AND LastName = 'Applicant'
            LIMIT 1
        ];
        
        return !applicants.isEmpty()
            && !String.isBlank(applicants[0].Mobile__pc);
    }
    
    private static Opportunity getTestApplication() {
        List<Opportunity> applications = [
            SELECT Id,
            Name,
            AccountId,
            Loan_Number__c
            FROM Opportunity
            WHERE Name = :TEST_APPLICATION_NAME
            LIMIT 1
        ];
        
        return applications.isEmpty()
            ? null
            : applications[0];
    }
    
