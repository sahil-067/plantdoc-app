        : leadRecord.How_did_you_come_to_know_about_us__c;

    result.leadSource = String.isBlank(leadRecord.LeadSource)
        ? 'Not available'
        : leadRecord.LeadSource;

    result.status = String.isBlank(leadRecord.Status)
        ? 'Not available'
        : leadRecord.Status;

    result.residenceState = String.isBlank(leadRecord.Lead_State__c)
        ? 'Not available'
        : leadRecord.Lead_State__c;

    return result;
}

