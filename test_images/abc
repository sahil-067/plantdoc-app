public class SetuLeadWhatsAppQueueable implements Queueable, Database.AllowsCallouts {

    private Set<Id> leadIds;
    
    // Set to FALSE to send a plain no-template text payload (tests Apex & logs, but Setu may reject delivery).
    // Set to TRUE to piggyback on the existing 'setu_eng_reminder_1' payload so your phone actually receives a WhatsApp message.
    private static final Boolean USE_EXISTING_LIVE_TEMPLATE_FOR_TEST = false;

    public SetuLeadWhatsAppQueueable(Set<Id> leadIds) {
        this.leadIds = leadIds;
    }

    public void execute(QueueableContext context) {
        if (leadIds == null || leadIds.isEmpty()) {
            return;
        }

        List<Lead> leads = [
            SELECT Id, Name, MobilePhone, Phone
            FROM Lead
            WHERE Id IN :leadIds
            LIMIT 90
        ];

        List<Api_Logs__c> logsToInsert = new List<Api_Logs__c>();

        // 1. Generate Bearer Token using 'Generate_Token' metadata
        String token = generateSetuToken(logsToInsert);
        System.debug('Generated Setu Token: ' + token);

        if (String.isBlank(token)) {
            if (!logsToInsert.isEmpty()) {
                insert logsToInsert;
            }
            return;
        }

        // 2. Fetch 'Send_Bill' metadata
        Setu_Send_Bill__mdt sendMdt = Setu_Send_Bill__mdt.getInstance('Send_Bill');
        if (sendMdt == null) {
            System.debug('Error: Send_Bill metadata not found.');
            return;
        }

        Http http = new Http();
        // Send_Bill has a blank Content-Type in metadata, so default to application/json
        String contentType = String.isNotBlank(sendMdt.Content_Type__c) ? sendMdt.Content_Type__c : 'application/json';

        // 3. Send WhatsApp request for each Lead
        for (Lead ld : leads) {
            String rawPhone = String.isNotBlank(ld.MobilePhone) ? ld.MobilePhone : ld.Phone;
            if (String.isBlank(rawPhone)) {
                continue;
            }

            // Keep last 10 digits of phone number
            String mobile = rawPhone.replaceAll('[^0-9]', '');
            if (mobile.length() > 10) {
                mobile = mobile.substring(mobile.length() - 10);
            }

            HttpRequest request = new HttpRequest();
            HttpResponse response = new HttpResponse();

            try {
                request.setEndpoint(sendMdt.Endpoint_URl__c);
                request.setMethod(sendMdt.Method__c);
                request.setHeader('Content-Type', contentType);
                request.setHeader('X-Setu-Product-Instance-ID', sendMdt.X_Setu_Product_Instance_ID__c);
                request.setHeader('x-setu-client-id', sendMdt.x_setu_client_id__c);
                request.setHeader('Authorization', 'Bearer ' + token);

                String body;
                if (!USE_EXISTING_LIVE_TEMPLATE_FOR_TEST) {
                    // Option A: Generic no-template welcome message payload
                    body = '{' +
                        '"channels":[' +
                            '{' +
                                '"destination":"91' + mobile + '",' +
                                '"channel":"whatsapp",' +
                                '"message":"Welcome ' + ld.Name + '! Thank you for connecting with us."' +
                            '}' +
                        ']' +
                    '}';
                } else {
                    // Option B: Uses existing live schema from SetuSendBillAPI so a real WhatsApp message delivers during testing
                    String dummyRef = 'WELCOME-CSC';
                    String todayFormatted = DateTime.now().format('dd.MM.yyyy');
                    String expiryDate = DateTime.now().addDays(5).formatGmt('yyyy-MM-dd') + 'T20:55:22Z';
                    String billerBillID = '91' + mobile + '_' + dummyRef;

                    body = '{"bill":{"amount":{"value":100,"currencyCode":"INR"},' +
                           '"additionalInfo":{"destination":"91' + mobile + '","loan_number":"' + dummyRef + '","due_date":"' + todayFormatted + '","referenceID":"' + dummyRef + '"},' +
                           '"billerBillID":"' + billerBillID + '","amountExactness":"EXACT","expiryDate":"' + expiryDate + '"},' +
                           '"channels":[{"destination":"91' + mobile + '","campaignID":"setu_eng_reminder_1","channel":"whatsapp",' +
                           '"template":{"loan_number":"' + dummyRef + '","due_date":"' + todayFormatted + '"}}]}';
                }

                request.setBody(body);
                System.debug('WhatsApp Request Body: ' + body);

                if (!Test.isRunningTest()) {
                    response = http.send(request);
                    System.debug('WhatsApp Response Status: ' + response.getStatusCode());
                    System.debug('WhatsApp Response Body: ' + response.getBody());
                } else {
                    response.setBody('{"success":true,"status":"SUCCESS"}');
                    response.setStatusCode(200);
                }

                Api_Logs__c log = new Api_Logs__c();
                log.Name = 'Setu_Lead_Welcome_WhatsApp_API';
                log.API_Request__c = request.getBody();
                log.API_Response__c = response.getBody();
                logsToInsert.add(log);

            } catch (Exception e) {
                System.debug('Exception:: ' + e.getMessage() + ' Line: ' + e.getLineNumber());
                Api_Logs__c errLog = new Api_Logs__c();
                errLog.Name = 'Setu_Lead_Welcome_Error';
                errLog.API_Request__c = request.getBody();
                errLog.API_Response__c = 'Exception: ' + e.getMessage() + ' Line: ' + e.getLineNumber();
                logsToInsert.add(errLog);
            }
        }

        // 4. Insert logs after all callouts finish
        if (!logsToInsert.isEmpty()) {
            insert logsToInsert;
        }
    }

    private static String generateSetuToken(List<Api_Logs__c> logsToInsert) {
        HttpRequest req = new HttpRequest();
        HttpResponse res = new HttpResponse();

        try {
            Setu_Send_Bill__mdt tokenMdt = Setu_Send_Bill__mdt.getInstance('Generate_Token');
            if (tokenMdt == null) {
                return null;
            }

            req.setEndpoint(tokenMdt.Endpoint_URl__c);
            req.setMethod(tokenMdt.Method__c);
            req.setHeader('Content-Type', tokenMdt.Content_Type__c);

            Map<String, String> authPayload = new Map<String, String>{
                'clientID' => tokenMdt.clientID__c,
                'secret'   => tokenMdt.secret__c
            };
            req.setBody(JSON.serialize(authPayload));

            Http http = new Http();
            if (!Test.isRunningTest()) {
                res = http.send(req);
                System.debug('Token Response: ' + res.getBody());
            } else {
                res.setBody('{"data":{"token":"mock_token"}}');
                res.setStatusCode(200);
            }

            Api_Logs__c log = new Api_Logs__c();
            log.Name = 'Setu_Generate_Token_API';
            log.API_Request__c = req.getBody();
            log.API_Response__c = res.getBody();
            logsToInsert.add(log);

            if (res.getStatusCode() == 200 || res.getStatusCode() == 201) {
                Map<String, Object> result = (Map<String, Object>) JSON.deserializeUntyped(res.getBody());
                if (result.containsKey('data') && result.get('data') instanceof Map<String, Object>) {
                    Map<String, Object> dataMap = (Map<String, Object>) result.get('data');
                    if (dataMap.containsKey('token')) {
                        return String.valueOf(dataMap.get('token'));
                    }
                }
                if (result.containsKey('token')) {
                    return String.valueOf(result.get('token'));
                }
            }
        } catch (Exception e) {
            System.debug('Token Exception:: ' + e.getMessage());
        }
        return null;
    }
}
