    @future
    public static void saveAttachment(String objHighMarkId, String firstName, String lastName, String responseBody){
        try{
            //Insert Response as Attachment in Related
            Attachment txtFile = new Attachment();
            txtFile.Body = Blob.valueOf(responseBody);
            txtFile.Name = 'Highmark Record Response.txt';
            txtFile.parentId = objHighMarkId;
            insert txtFile;
            
            Attachment htmlFile = new Attachment();
            if(!Test.isRunningTest()){
            	htmlFile.Body = Blob.valueOf(responseBody.substring(responseBody.indexOf('<html>'), responseBody.indexOf('</html>')).remove('<html>'));
            }
            else{
                htmlFile.Body = Blob.valueOf(responseBody);
            }
            htmlFile.name = firstName + ' ' + lastName + ' Highmark Report.html';
            htmlFile.parentId = objHighMarkId;
            insert htmlFile;
        }
        catch(Exception ex) { 
            System.debug('Error occured ==>>> ' + ex.getMessage() + ' at line no. of = ' + ex.getLineNumber());
            throw ex; 
        }
    }
    
