    // =========================================================================
    // Mock HTTP Callout Handler for Token & SendBill APIs
    // =========================================================================
    private class CallBotCalloutMock implements HttpCalloutMock {
        private String mode;
        private Integer callCount = 0;

        public CallBotCalloutMock(String mode) {
            this.mode = mode;
        }

        public HTTPResponse respond(HTTPRequest req) {
            callCount++;
            HttpResponse res = new HttpResponse();
            res.setHeader('Content-Type', 'application/json');

            if (mode == 'THROW_EXCEPTION') {
                throw new CalloutException('Simulated callout failure');
            }

            // 1st callout: SetuSendBill_GenerateTokenAPI.getToken(null)
            if (callCount == 1) {
                if (mode == 'TOKEN_FAIL') {
                    res.setStatusCode(401);
                    res.setBody('');
                    return res;
                }
                res.setStatusCode(200);
                // Covers common token response shapes
                res.setBody('{"token":"mock_jwt_token_123","access_token":"mock_jwt_token_123","data":{"token":"mock_jwt_token_123"}}');
                return res;
            }

            // 2nd callout: SetuSendBillAPI.sendBillForBOT(token, paymentAPIBody)
            if (mode == 'BILL_FAIL') {
                res.setStatusCode(400);
                res.setBody('{"success":false,"status":"FAILED","message":"Bill generation failed"}');
                return res;
            }

            res.setStatusCode(200);
            res.setBody('{"success":true,"status":"SUCCESS","data":{"paymentLink":"https://setu.co/pay/mock123"}}');
            return res;
        }
    }

