    public void callNeslAPI(){
        shouldPoll = true;
        System.debug('Entered in callNeslAPI');
        Boolean duplicateFound = false;
        List<string> phoneLst = new List<string>();
        Integer count = 0;
        string checkPhone;
        for(contcRoleWrap op : ocwrList){
            if(op.isSelected == true ){
                count++;
                if(op.isSelected == true && op.ocr.Role != 'EBS'){
                    checkPhone = op.ocr.contact.Account.Mobile__pc;
                    system.debug('checkPhone++++++++'+checkPhone);
                    phoneLst.add(checkPhone);
                }
            }
        }
        //Check duplicate
        Set<String> dupSetCheck = new Set<String>();
        if(phoneLst.size() > 1){
            for(Integer i = 0;i< phoneLst.size();i++){
                dupSetCheck.add(phoneLst[i]);
            }
        }
        if(dupSetCheck.size() != 0 && (phoneLst.size() != dupSetCheck.size()) ){
            duplicateFound = true;
        }
        Leegality__c legalityNeslCustomSetting = Leegality__c.getValues('Nesl');
        Decimal stampDutyCharges;
        String acId;
        for(contcRoleWrap ocrObj: ocwrList){
            if(ocrObj.ocr.MyRole1__c == 'Loan - Main Applicant'){
                acId = ocrObj.ocr.contact.Account.id;
            }
        }
        Account mainApplicantAccount = [select id,name,Employee_Id__c,Personal_email__pc,Household__c,Pan_Card_No__pc,Drv_Licn__pc,Voter_Card__pc,
                                        Residential_Address__c,Passport_No__pc,
                                        Mobile__pc,Communication_Pincode__pc,Date_Of_Birth__pc from Account where id=:acId limit 1];
        Integer collectionCount = new List<Collection__c>([
            SELECT Id, Legality_Document_Type__c
            FROM Collection__c
            WHERE SFDC_Customer__c = :applicationId
            AND Status__c = 'Active'
            AND (Nature_of_Collection__c = 'Stamp Duty Amount' OR Nature_of_Collection__c = 'Other Administrative Charges') // Filter updated By Tushar Jain on 25 July 2025 as per Aayush
