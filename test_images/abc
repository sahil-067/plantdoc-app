    //-----------This method is use to calculate Re-KYC First Due Date.------------//
    public static void calculateReKYC_DueDate(List<Disbursement__c> dmList, Map<Id, Disbursement__c> dmListOld){
        Map<Id, Disbursement__c> appAndDisbursementMap = new Map<Id, Disbursement__c>();
        for(Disbursement__c ds : dmList){
            if(ds.Application__c != null && ds.Tranch_Details__c == 'First' && ds.Levels_Of_Tranch__c == 'First Tranche' && ds.Disb_Status__c == 'Handed over customer' && ds.Date_of_Disbursement__c != null && ds.Disb_Status__c != dmListOld.get(ds.id).Disb_Status__c ){
                appAndDisbursementMap.put(ds.Application__c, ds);
            }
        }
        System.debug('appAndDisbursementMap:: '+appAndDisbursementMap);
        if(!appAndDisbursementMap.keyset().isEmpty()){
            Map<String, String> custmerAndAppMap = new Map<String, String>();
            for(Opportunity opp : [SELECT Id, Name, Household__c FROM Opportunity WHERE Id IN : appAndDisbursementMap.keySet()]){
                if(opp.Household__c != null){
                    custmerAndAppMap.put( opp.Household__c, opp.Id);
                }
            }
            
            System.debug('custmerAndAppMap:: '+custmerAndAppMap);
            if(!custmerAndAppMap.keyset().isEmpty()){
                List<Account> accList = [SELECT Id, Name,Household__c, Re_KYC_Due_Date__pc, Risk_Category__c FROM Account
                                         WHERE Risk_Category__c != null AND Household__c IN : custmerAndAppMap.keySet()];
                System.debug('accList:: '+accList);
                if(!accList.isEmpty()){
                    List<Account> updateAccLst = new List<Account>();
                    For(Account acc : accList){
                        if(acc.Re_KYC_Due_Date__pc == null){
                            Account accObj = new Account();
                            accObj.Id = acc.Id;
                            Date dod = appAndDisbursementMap.get(custmerAndAppMap.get(acc.Household__c)).Date_of_Disbursement__c;
                            if(acc.Risk_Category__c == 'Low Risk'){
                                accObj.Re_KYC_Due_Date__pc = dod.addMonths(114);		//9.5 Years
                            }
                            else if(acc.Risk_Category__c == 'Medium Risk'){
                                accObj.Re_KYC_Due_Date__pc = dod.addMonths(90);		//7.5 Years
                            }
                            else if(acc.Risk_Category__c == 'High Risk'){
                                accObj.Re_KYC_Due_Date__pc = dod.addMonths(18);		//1.5 Years
                            }
                            updateAccLst.add(accObj);
                        }
                    }
                    if(!updateAccLst.isEmpty()){
                        update updateAccLst;
                    }
                }
            }
        }
    }
