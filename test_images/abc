private static ConsoleData getConsoleDataFromLead(Id leadId) {
    Lead leadRecord = [
        SELECT Id,
               Case__c,
               How_did_you_come_to_know_about_us__c,
               LeadSource,
               Status,
               Lead_State__c
        FROM Lead
        WHERE Id = :leadId
        LIMIT 1
    ];

    /*
     * Lead → Case → Application
     */
    if (leadRecord.Case__c == null) {
        ConsoleData result = new ConsoleData();
        result.leadDetails = buildLeadDetails(leadRecord);
        result.warning =
            'This Lead is not linked to a Foreclosure Case, so its Application could not be found.';
        return result;
    }

    Case foreclosureCase = [
        SELECT Id,
               Application_Name__c
        FROM Case
        WHERE Id = :leadRecord.Case__c
        LIMIT 1
    ];

    if (foreclosureCase.Application_Name__c == null) {
        ConsoleData result = new ConsoleData();
        result.leadDetails = buildLeadDetails(leadRecord);
        result.warning =
            'The related Foreclosure Case does not have an Application linked.';
        return result;
    }

    /*
     * Load Customer 360 using the Application Id.
     * openedLeadId ensures the same Lead opened by the user is displayed.
     */
    return getConsoleDataFromApplication(
        foreclosureCase.Application_Name__c,
        leadRecord.Id
    );
}

private static Decimal loadEmiPaidToDate(Id loanId) {
    if (loanId == null) {

        return 0;
    }

    AggregateResult[] collectionRows = [
        SELECT SUM(Amount__c) totalEmiPaid
        FROM Collection__c
        WHERE Nature_of_Collection__c = 'Emi/Advances/Part Payment'
          AND ClearenceStatus__c = 'Cleared'
          AND SFDC_Customer__c = :loanId
    ];

    if (
        collectionRows.isEmpty()
        || collectionRows[0].get('totalEmiPaid') == null
    ) {
        return 0;
    }

    return (Decimal) collectionRows[0].get('totalEmiPaid');
}

private static LeadDetails getLeadDetails(
    Id applicationId,
    Id openedLeadId
) {
    Lead selectedLead;

    /*
     * Console opened from Lead:
     * Show exactly that Lead.
     */
    if (openedLeadId != null) {
        List<Lead> openedLeadRows = [
            SELECT Id,
                   How_did_you_come_to_know_about_us__c,
                   LeadSource,
                   Status,
                   Lead_State__c
            FROM Lead
            WHERE Id = :openedLeadId
            AND RecordType.DeveloperName = 'Retention'
            LIMIT 1
        ];

        if (!openedLeadRows.isEmpty()) {
            selectedLead = openedLeadRows[0];
        }
    }

    /*
     * Console opened from Application:
     * Find the latest Lead linked to a Foreclosure Case
     * belonging to this Application.
     */
    if (selectedLead == null && applicationId != null) {
        List<Case> foreclosureCases = [
            SELECT Id
            FROM Case
            WHERE Application_Name__c = :applicationId
            ORDER BY CreatedDate DESC
            LIMIT 50
        ];

        Set<Id> caseIds = new Set<Id>();

        for (Case caseRecord : foreclosureCases) {
            caseIds.add(caseRecord.Id);
        }

        if (!caseIds.isEmpty()) {
            List<Lead> leads = [
                SELECT Id,
                       How_did_you_come_to_know_about_us__c,
                       LeadSource,
                       Status,
                       Lead_State__c,
                       CreatedDate
                FROM Lead
                WHERE Case__c IN :caseIds
                AND RecordType.DeveloperName = 'Retention'
                ORDER BY CreatedDate DESC
                LIMIT 1
            ];

            if (!leads.isEmpty()) {
                selectedLead = leads[0];
            }
        }
    }

    return buildLeadDetails(selectedLead);
}

private static LeadDetails buildLeadDetails(Lead leadRecord) {
    if (leadRecord == null) {
