    public Decimal calculateStampDutyServiceCharge(Integer stampDutyAmount,boolean chargeType){
        Integer maxDenomination;
        Integer maxDenomination1;
        Integer remainder;
        Integer quotient;
        Integer count;
        Decimal totalStampDutyServiceCharge;
        Legality_Stamp_Duty_Service_Charge__mdt stampDetail = [SELECT Id, Stamp_Denomination__c, Service_Charge__c
                                                               FROM Legality_Stamp_Duty_Service_Charge__mdt
                                                               WHERE State__c =: opp.Coll_State__c];
        List<Integer> denominationList = new List<Integer>();
        List<Integer> denominationListNew = new List<Integer>();
        List<String> stringDenominationList = stampDetail.Stamp_Denomination__c.split(',');
        for(String d : stringDenominationList){
            denominationList.add(Integer.valueOf(d));
            denominationListNew.add(Integer.valueOf(d));
        }
        count = 0;
        denominationList.sort();
        maxDenomination1 = denominationList[denominationList.size()-1];
        if(denominationList.contains(stampDutyAmount)){
            count = 1;
        }else if(stampDutyAmount < maxDenomination1){
            Integer maxList;
            Integer q;
            Integer r;
            Integer i;
            for(i=1; i<=denominationListNew.size(); i++){
                maxList = denominationList[denominationList.size()-1];
                if(stampDutyAmount < maxList){
                    denominationList.remove(denominationList.size()-1);
                    denominationList.sort();
                }else{
                    r = math.mod(stampDutyAmount, maxList);
                    q = stampDutyAmount/maxList;
                    count += q;
                    stampDutyAmount = r;
                    denominationList.remove(denominationList.size()-1);
                }
            }
        }else{
            while(stampDutyAmount != 0){
                if(!denominationList.isEmpty()){
                    denominationList.sort();
                    maxDenomination = denominationList[denominationList.size()-1];
                    if(maxDenomination == 500){
                        remainder = math.mod(stampDutyAmount, 500);
                        quotient = stampDutyAmount/500;
                        stampDutyAmount = remainder;
                        if(quotient > 0){
                            count += quotient;
                        }else{
                            count += 1;
