    @isTest
    static void testNullCreditScoreAndCatchBlock() {
        CAM__c cam = [SELECT Id, Total_Credit_Score__c FROM CAM__c LIMIT 1];

        Test.startTest();
        // 1. Cover Total_Credit_Score__c == null error path
        cam.Total_Credit_Score__c = null;
        update cam;
        GenerateROI ctrlNull = new GenerateROI(new ApexPages.StandardController(cam));
        ctrlNull.generate();

        // 2. Cover catch(Exception e) by removing Cam_Risk__c so ListCamRisk[0] throws ListException
        cam.Total_Credit_Score__c = 67;
        update cam;
        delete [SELECT Id FROM Cam_Risk__c WHERE CAM__c = :cam.Id];
        GenerateROI ctrlErr = new GenerateROI(new ApexPages.StandardController(cam));
        ctrlErr.generate();
        Test.stopTest();
    }
