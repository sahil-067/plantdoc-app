    @IsTest
    static void testFirstTrancheSTConditionErrors() {
        Opportunity opp = [SELECT Id, Sanctioned_Amont__c FROM Opportunity LIMIT 1];
        Technical_Verification__c tv = [SELECT Id FROM Technical_Verification__c LIMIT 1];
        CAM__c cam = [SELECT Id FROM CAM__c LIMIT 1];
        Property_Master__c pm = [SELECT Id FROM Property_Master__c LIMIT 1];

        String[] expectedTimes = new String[]{'Before Disbursement', '2nd Tranche', '3rd Tranche', 'Final Tranche'};

        for(String et : expectedTimes) {
            ST_Condition__c stc1 = new ST_Condition__c(CAM__c=cam.Id, Expected_Time__c=et, Document_Received__c='No');
            insert stc1;
            Disbursement__c d1 = new Disbursement__c(Application__c=opp.Id, Disbursement_Amount__c=opp.Sanctioned_Amont__c, Levels_Of_Tranch__c='First Tranche');
            PDDSecondRequest.CheckPDD(new List<Disbursement__c>{d1});
            delete stc1;

            ST_Condition__c stc2 = new ST_Condition__c(Property_Master__c=pm.Id, Expected_Time__c=et, Document_Received__c='No');
            insert stc2;
            PDDSecondRequest.CheckPDD(new List<Disbursement__c>{d1});
            delete stc2;

            ST_Condition__c stc3 = new ST_Condition__c(Technical_Verification__c=tv.Id, Expected_Time__c=et, Document_Received__c='No');
            insert stc3;
            PDDSecondRequest.CheckPDD(new List<Disbursement__c>{d1});
            delete stc3;
        }
        
        ST_Condition__c stcPartial = new ST_Condition__c(Technical_Verification__c=tv.Id, Expected_Time__c='Before Disbursement', Document_Received__c='No');
        insert stcPartial;
        Disbursement__c dPartial = new Disbursement__c(Application__c=opp.Id, Disbursement_Amount__c=opp.Sanctioned_Amont__c - 1000, Levels_Of_Tranch__c='First Tranche');
        PDDSecondRequest.CheckPDD(new List<Disbursement__c>{dPartial});
        delete stcPartial;
        
        ST_Condition__c stcPartial2 = new ST_Condition__c(Property_Master__c=pm.Id, Expected_Time__c='Before Disbursement', Document_Received__c='No');
        insert stcPartial2;
        PDDSecondRequest.CheckPDD(new List<Disbursement__c>{dPartial});
        delete stcPartial2;
        
        ST_Condition__c stcPartial3 = new ST_Condition__c(CAM__c=cam.Id, Expected_Time__c='Before Disbursement', Document_Received__c='No');
        insert stcPartial3;
        PDDSecondRequest.CheckPDD(new List<Disbursement__c>{dPartial});
        delete stcPartial3;
    }

    @IsTest
    static void testPDDErrors() {
        Opportunity opp = [SELECT Id, Sanctioned_Amont__c FROM Opportunity LIMIT 1];

        for (String et : new String[]{'2nd Tranche', '3rd Tranche', 'Final Tranche', 'At Cheque HandOver'}) {
            PDD__c p = new PDD__c(Opportunity__c=opp.Id, Expected_Time__c=et, Document_Received__c='No');
            insert p;
            Disbursement__c dFull = new Disbursement__c(Application__c=opp.Id, Disbursement_Amount__c=opp.Sanctioned_Amont__c, Levels_Of_Tranch__c='2nd Tranche');
            PDDSecondRequest.CheckPDD(new List<Disbursement__c>{dFull});
            Disbursement__c dPart = new Disbursement__c(Application__c=opp.Id, Disbursement_Amount__c=opp.Sanctioned_Amont__c - 10, Levels_Of_Tranch__c='2nd Tranche');
            PDDSecondRequest.CheckPDD(new List<Disbursement__c>{dPart});
            delete p;
        }

        for (String et : new String[]{'3rd Tranche', 'Final Tranche', 'At Cheque HandOver'}) {
            PDD__c p = new PDD__c(Opportunity__c=opp.Id, Expected_Time__c=et, Document_Received__c='No');
            insert p;
            Disbursement__c dFull = new Disbursement__c(Application__c=opp.Id, Disbursement_Amount__c=opp.Sanctioned_Amont__c, Levels_Of_Tranch__c='3rd Tranche');
            PDDSecondRequest.CheckPDD(new List<Disbursement__c>{dFull});
            Disbursement__c dPart = new Disbursement__c(Application__c=opp.Id, Disbursement_Amount__c=opp.Sanctioned_Amont__c - 10, Levels_Of_Tranch__c='3rd Tranche');
            PDDSecondRequest.CheckPDD(new List<Disbursement__c>{dPart});
            delete p;
        }

        String[] higherTranches = new String[]{'4th Tranche', '5th Tranche', '6th Tranche', '7th Tranche', '8th Tranche', '9th Tranche', '10th Tranche', '11th Tranche', '12th Tranche'};
        for (String tranche : higherTranches) {
            for (String et : new String[]{'Final Tranche', 'At Cheque HandOver'}) {
                PDD__c p = new PDD__c(Opportunity__c=opp.Id, Expected_Time__c=et, Document_Received__c='No');
                insert p;
                Disbursement__c dFull = new Disbursement__c(Application__c=opp.Id, Disbursement_Amount__c=opp.Sanctioned_Amont__c, Levels_Of_Tranch__c=tranche);
                PDDSecondRequest.CheckPDD(new List<Disbursement__c>{dFull});
                Disbursement__c dPart = new Disbursement__c(Application__c=opp.Id, Disbursement_Amount__c=opp.Sanctioned_Amont__c - 10, Levels_Of_Tranch__c=tranche);
                PDDSecondRequest.CheckPDD(new List<Disbursement__c>{dPart});
                delete p;
            }
        }

        PDD__c pExtra = new PDD__c(Opportunity__c=opp.Id, Expected_Time__c='At Cheque Print', Document_Received__c='No');
        insert pExtra;
        Disbursement__c dFirst = new Disbursement__c(Application__c=opp.Id, Disbursement_Amount__c=100, Levels_Of_Tranch__c='First Tranche');
        PDDSecondRequest.CheckPDD(new List<Disbursement__c>{dFirst});
        
        pExtra.Expected_Time__c = 'Post Disbursement';
        update pExtra;
        PDDSecondRequest.CheckPDD(new List<Disbursement__c>{dFirst});
    }

