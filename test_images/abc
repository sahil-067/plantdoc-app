        ];
    }
    

    /**
     * Rate Change History for the given Application.
     * Finnone ROI = Whatsapp_Name3__c, Sanctioned ROI = Sanctioned_ROI__c,
     * Change = |Finnone ROI - Sanctioned ROI| (always positive).
     * Read-only.
     */
    @AuraEnabled(cacheable=true)
    public static RateChangeHistoryData getRateChangeHistory(Id applicationId) {
        RateChangeHistoryData result = new RateChangeHistoryData();

        if (applicationId == null) {
            return result;
        }

        for (Opportunity opp : [
            SELECT Id, First_Sanction_Date__c, Sanctioned_ROI__c, Whatsapp_Name3__c
            FROM Opportunity
            WHERE Id = :applicationId
            LIMIT 1
        ]) {
            result.firstSanctionDate = displayValue(opp.get('First_Sanction_Date__c'));
            result.sanctionedRoi = toDecimal(opp.get('Sanctioned_ROI__c'));
            result.finnoneRoi = toDecimal(opp.get('Whatsapp_Name3__c'));

            if (result.sanctionedRoi != null && result.finnoneRoi != null) {
                result.change = Math.abs(result.finnoneRoi - result.sanctionedRoi);
            }
        }

        return result;
    }

    private static Decimal toDecimal(Object raw) {
        if (raw == null) {
            return null;
        }
        if (raw instanceof Decimal) {
            return (Decimal) raw;
        }
        String text = String.valueOf(raw).replace('%', '').replace(',', '').trim();
        if (String.isBlank(text)) {
            return null;
        }
        try {
            return Decimal.valueOf(text);
        } catch (Exception e) {
            return null;
        }
    }

    /**
     * Repayment Discipline details for the given Application.
     * Finnone Running DPD = IA_File_Audit_Date__c, Total Bounce = Ttl_bou__c,
     * MOB = MOB__c, Bounce dates = Date_of_Collection__c of Collection__c
     * records with ClearenceStatus__c = 'Bounced' (comma separated).
     * Read-only.
     */
    @AuraEnabled(cacheable=true)
    public static RepaymentDisciplineData getRepaymentDiscipline(Id applicationId) {
        RepaymentDisciplineData result = new RepaymentDisciplineData();

        if (applicationId == null) {
            return result;
        }

        for (Opportunity opp : [
            SELECT Id, IA_File_Audit_Date__c, Ttl_bou__c, MOB__c
            FROM Opportunity
            WHERE Id = :applicationId
            LIMIT 1
        ]) {
            result.finnoneRunningDpd = displayValue(opp.get('IA_File_Audit_Date__c'));
            result.totalBounce = displayValue(opp.get('Ttl_bou__c'));
            result.mob = displayValue(opp.get('MOB__c'));
        }

        List<String> bounceDateList = new List<String>();
        Set<Date> seenDates = new Set<Date>();

        for (Collection__c coll : [
            SELECT Id, Date_of_Collection__c
            FROM Collection__c
            WHERE SFDC_Customer__c = :applicationId
              AND ClearenceStatus__c = 'Bounce'
              AND Date_of_Collection__c != null
            ORDER BY Date_of_Collection__c ASC
            LIMIT 500
        ]) {
            Date d = coll.Date_of_Collection__c;
            if (seenDates.add(d)) {
                bounceDateList.add(d.format());
            }
        }

        result.bounceDates = String.join(bounceDateList, ', ');
        return result;
    }

    private static String displayValue(Object raw) {
        if (raw == null) {
            return null;
        }
        if (raw instanceof Date) {
            return ((Date) raw).format();
        }
        if (raw instanceof Datetime) {
            return ((Datetime) raw).format();
        }
        return String.valueOf(raw);
    }

