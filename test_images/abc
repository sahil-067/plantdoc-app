    @isTest
    static void testNullCases() {
        Test.startTest();
        LeadScoreCalculator.generateScore(null);
        LeadScoreCalculator.generateScore(new List<Lead>());
        Test.stopTest();
    }

    @isTest
    static void testScoringAndRoutingScenarios() {
        List<Lead> setupLeads = [SELECT Id, LastName, How_did_you_come_to_know_about_us__c, Campaign_Type__c,
                   				 Advt_Name__c, Loan_Amount__c, PostalCode FROM Lead];

        Test.startTest();
        LeadScoreCalculator.generateScore(setupLeads);
        Test.stopTest();

        Map<String, Lead> resultByName = new Map<String, Lead>();
        for (Lead ld : [
            SELECT LastName, Lead_Score__c, Lead_Grade__c, Call_Centre_Type__c, Agent_Tier__c, Login_Probability__c
            FROM Lead
            WHERE Id IN :setupLeads
        ]) {
            resultByName.put(ld.LastName, ld);
        }


        Lead blankLead = resultByName.get('Blank Lead');
        System.assertEquals(0, blankLead.Lead_Score__c);
        System.assertEquals('D', blankLead.Lead_Grade__c);
        System.assertEquals('General Call Centre', blankLead.Call_Centre_Type__c);
        System.assertEquals('Tier 3', blankLead.Agent_Tier__c);
        System.assertEquals(0.0, blankLead.Login_Probability__c);


        Lead southT1 = resultByName.get('South Tier 1');
        System.assertNotEquals(null, southT1.Lead_Score__c);
        System.assertEquals('A', southT1.Lead_Grade__c);
        System.assertEquals('South Call Centre', southT1.Call_Centre_Type__c);
        System.assertEquals('Tier 1', southT1.Agent_Tier__c);


        Lead southT3 = resultByName.get('South Tier 3 Ad Fallback');
        System.assertEquals('South Call Centre', southT3.Call_Centre_Type__c);
        System.assertEquals('Tier 3', southT3.Agent_Tier__c);


        Lead genT1 = resultByName.get('General Tier 1');
        System.assertEquals('General Call Centre', genT1.Call_Centre_Type__c);
        System.assertEquals('Tier 1', genT1.Agent_Tier__c);


        Lead otherSouth = resultByName.get('Other Source South Ad');
        System.assertEquals('South Call Centre', otherSouth.Call_Centre_Type__c);
        System.assertNotEquals(null, otherSouth.Lead_Score__c);
    }

