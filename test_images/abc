    private static OtpContext getOtpContext(
        Id applicationId,
        String recipientValue
    ) {
        if (
            applicationId == null
            || applicationId.getSObjectType() != Opportunity.SObjectType
        ) {
            throw new AuraHandledException(
                'Select a valid Application before sending OTP.'
            );
        }

        String recipient = normalizeRecipient(recipientValue);

        Opportunity app = [
            SELECT Id,
                   AccountId,
                   Branch__r.Branch_Approver__r.MobilePhone,
                   Branch__r.Branch_User__r.MobilePhone
            FROM Opportunity
            WHERE Id = :applicationId
            LIMIT 1
        ];

        if (app.AccountId == null) {
            throw new AuraHandledException(
                'Main applicant Account is required for the Retention OTP flow.'
            );
        }

        Account account = [
            SELECT Id,
                   Mobile__pc,
                   CustomerOtp__c,
                   EBSOtp__c,
                   Underwriter_Otp__c
            FROM Account
            WHERE Id = :app.AccountId
            LIMIT 1
        ];

        OtpContext context = new OtpContext();
        context.account = account;
        context.recipient = recipient;

        if (recipient == 'CUSTOMER') {
            context.phoneNumber = account.Mobile__pc;
        } else if (recipient == 'BRANCH_APPROVER') {
            context.phoneNumber =
                app.Branch__r == null
                || app.Branch__r.Branch_Approver__r == null
                ? null
                : app.Branch__r.Branch_Approver__r.MobilePhone;
        } else {
            context.phoneNumber =
                app.Branch__r == null
                || app.Branch__r.Branch_User__r == null
                ? null
                : app.Branch__r.Branch_User__r.MobilePhone;
        }

        if (String.isBlank(context.phoneNumber)) {
            String label = recipient == 'CUSTOMER'
                ? 'Customer'
                : recipient == 'BRANCH_APPROVER'
                    ? 'Branch Approver'
                    : 'EBS/Branch User';

            throw new AuraHandledException(
                label
                + ' mobile number is not available on the selected Application.'
            );
        }

        return context;
    }

    private static String normalizeRecipient(String value) {
        String recipient = String.isBlank(value)
            ? 'CUSTOMER'
            : value.trim().toUpperCase();

        if (
            recipient != 'CUSTOMER'
            && recipient != 'BRANCH_APPROVER'
            && recipient != 'EBS_BRANCH_USER'
        ) {
            throw new AuraHandledException(
                'Unsupported OTP recipient.'
            );
        }

        return recipient;
    }

    private static String generateSixDigitOtp() {
    Integer randomValue = Crypto.getRandomInteger();

    /*
     * Avoid Math.abs() edge case for the lowest possible Integer.
     * Convert negative value manually, then keep only the last 6 digits.
     */
    String numericValue = String.valueOf(randomValue).replace('-', '');

    if (numericValue.length() > 6) {
        numericValue = numericValue.substring(
            numericValue.length() - 6
        );
    }

    Integer otpNumber = Integer.valueOf(numericValue);

    /*
     * Ensure the OTP remains a valid 6-digit number.
     */
    if (otpNumber < 100000) {
        otpNumber += 100000;
    }

    return String.valueOf(otpNumber);
}

    private static String storedOtp(
        Account account,
        String recipient
    ) {
        if (recipient == 'CUSTOMER') {
            return account.CustomerOtp__c;
        }

        if (recipient == 'BRANCH_APPROVER') {
            return account.Underwriter_Otp__c;
        }

        return account.EBSOtp__c;
    }

    private static void validateOtp(
        Account account,
        String recipient,
        String enteredOtp,
        String label
    ) {
        String expectedOtp = storedOtp(account, recipient);

        if (
            String.isBlank(enteredOtp)
            || String.isBlank(expectedOtp)
            || expectedOtp != enteredOtp.trim()
        ) {
            throw new AuraHandledException(
                label + ' OTP is not verified.'
            );
        }
    }

