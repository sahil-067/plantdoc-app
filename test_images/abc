    public static void sendOTPOnWhatsapp(String mobile, String otp, String loanNumber) {
        String toMobile;
        try {
            Infobip_WhatsApp_API__mdt cred = Infobip_WhatsApp_API__mdt.getInstance('Send_OTP');
            if (cred != null && String.isNotBlank(mobile)) {
                if (mobile.length() == 10) {
                    toMobile = '91' + mobile;
                }
                HttpRequest request = new HttpRequest();
                request.setEndpoint(cred.Endpoint_URL__c);
                request.setMethod(cred.Method__c);
                request.setHeader('Authorization', cred.Authorization__c);
                request.setHeader('Content-Type', cred.Content_Type__c);
                String body = '{"messages":[{"from":"' + cred.Sender__c + '","to":"' + toMobile + '","content":{' +
                    '"templateName":"key_fact_statement",' +
                    '"templateData":{' +
                    '"body":{"placeholders":["' + loanNumber + '","' + otp + '"]}' +
                    '},' +
                    '"language":"en"' +
                    '}}]}';
                request.setBody(body);
                HttpResponse response;
                if (!Test.isRunningTest()) {
                    Http http = new Http();
                    try {
                        response = http.send(request);
                        if (response.getStatusCode() != 200 && response.getStatusCode() != 202) {
                            System.debug('Unexpected status code: ' + response.getStatusCode());
                        }
                    } catch (System.CalloutException calloutEx) {
                        System.debug('CalloutException occurred: ' + calloutEx.getMessage());
                    }
                }
            } else {
                System.debug('Credentials are null or mobile is blank.');
            }
        } catch (Exception e) {
            System.debug('Line Number: ' + e.getLineNumber());
            System.debug('Error Message: ' + e.getMessage());
        }
    }
