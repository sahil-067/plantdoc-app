    @IsTest
    static void testHappyPathAndUpdates() {
        Opportunity opp = createApplication();
        Disbursement__c disbRec = createDisbursement(opp.Id, 'First Tranche', 16000);

        Test.startTest();
        // Test Insert
        insert disbRec;

        // Test Update with Commitment Charge bypass
        disbRec.Commitment_Charge__c = 500;
        update disbRec;

        // Test Update Amount change
        disbRec.Disbursement_Amount__c = 20000;
        update disbRec;
        
        // Test Update Status Cancelled Bypass
        disbRec.Disb_Status__c = 'Cancelled by branch';
        update disbRec;
        Test.stopTest();
    }

    @IsTest
    static void testAmountValidations() {
        Opportunity opp = createApplication();
        // Setup existing DM
        Disbursement__c disbRec = createDisbursement(opp.Id, 'First Tranche', 100000);
        insert disbRec;

        Test.startTest();
        // 1. Exceed sanctioned amount on Insert
        Disbursement__c disbRec2 = createDisbursement(opp.Id, '2nd Tranche', 250000);
        try { insert disbRec2; } catch (DmlException e) {}

        // 2. Exceed sanctioned amount on Update
        disbRec.Disb_Status__c = 'Pending';
        disbRec.Disbursement_Amount__c = 350000;
        try { update disbRec; } catch (DmlException e) {}

        // 3. Pending Amount > 10,000 Check (Requires DE_Done_By != By-Pass)
        opp.DE_Done_By__c = 'Normal'; 
        update opp;

        Disbursement__c disbRec3 = createDisbursement(opp.Id, '2nd Tranche', 195000); 
        try { insert disbRec3; } catch (DmlException e) {}
        
        disbRec.Disbursement_Amount__c = 195000;
        try { update disbRec; } catch (DmlException e) {}
        Test.stopTest();
    }

    @IsTest
    static void testNACHNotRegisteredTranches() {
        Opportunity opp = createApplication();
        opp.ACH_Registration_Status__c = 'Pending'; // Must be pending to trigger validations
        update opp;

        List<Disbursement__c> disbList = new List<Disbursement__c>();
        String[] tranches = new String[]{'2nd Tranche', '3rd Tranche', '4th Tranche', '5th Tranche', 
                                         '6th Tranche', '7th Tranche', '8th Tranche', '9th Tranche', 
                                         '10th Tranche', '11th Tranche', '12th Tranche'};

        for(String tranche : tranches) {
            disbList.add(createDisbursement(opp.Id, tranche, 10000));
        }

        Test.startTest();
        // Database.insert(list, false) runs completely through the list, catching errors on every row.
        Database.insert(disbList, false); 
        Test.stopTest();
    }

    @IsTest
    static void testBouncedCollections() {
        Opportunity opp = createApplication();
        
        // Ensure Collection record exists to hit Lines 192-200
        Collection__c coll = new Collection__c(
            SFDC_Customer__c = opp.Id,
            Status__c = 'Bounced',
            Instrument__c = 'ACH',
            Amount__c = 6000,
            Date_of_Deposit__c = System.today(),
            Deposited_In_bank__c = true,
            ClearenceStatus__c = 'Handover pending',
            RMobile_No__c = '1234567891',
            Nature_of_Collection__c = 'Other Administrative Charges'
        );
        insert coll;

        Test.startTest();
        // ACH Bounce
        Disbursement__c disbRec1 = createDisbursement(opp.Id, '2nd Tranche', 10000);
        try { insert disbRec1; } catch (Exception e) {}
        
        // ECS Bounce
        coll.Instrument__c = 'ECS';
        update coll;
        Disbursement__c disbRec2 = createDisbursement(opp.Id, '2nd Tranche', 10000);
        try { insert disbRec2; } catch (Exception e) {}
        Test.stopTest();
    }

    @IsTest
    static void testLMStatusValidations() {
        Opportunity opp = createApplication();
        List<String> statuses = new List<String>{
            'Fully Disbursed (Active)',
            'Sanctioned Expired',
            'Rejected by Call Center',
            'Rejected By Operation',
            'Rejected Post Disbursement'
        };

        Test.startTest();
        // Loops through all 5 statuses sequentially to hit all validations at bottom of trigger
        for (String status : statuses) {
            opp.LM_Loan_Status__c = status;
            update opp;
            Disbursement__c disbRec = createDisbursement(opp.Id, 'First Tranche', 16000);
            try { insert disbRec; } catch(DmlException e) {}
        }
        Test.stopTest();
    }
