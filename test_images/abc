    // =========================================================================
    // Helper to invoke the REST endpoint
    // =========================================================================
    private static RestResponse invokeDoPost(String jsonBody) {
        RestRequest req = new RestRequest();
        req.requestURI = '/services/apexrest/CallBotCollection/';
        req.httpMethod = 'POST';
        req.requestBody = Blob.valueOf(jsonBody != null ? jsonBody : '');

        RestResponse res = new RestResponse();
        RestContext.request = req;
        RestContext.response = res;

        CallBotCollectionWebhookService.doPost();
        return RestContext.response;
    }

