    // Universal HTTP Callout Mock to handle the API hit
    public class MockHttpResponseGenerator implements HttpCalloutMock {
        private Integer statusCode;
        private String body;
        
        public MockHttpResponseGenerator(Integer statusCode, String body) {
            this.statusCode = statusCode;
            this.body = body;
        }
        
        public HTTPResponse respond(HTTPRequest req) {
            HttpResponse res = new HttpResponse();
            res.setHeader('Content-Type', 'application/json');
            res.setBody(this.body);
            res.setStatusCode(this.statusCode);
            return res;
        }
    }
    
    // Covers the Queueable Execution + Successful JSON Parsing
    @isTest
    static void testCalloutSuccess() {
        Opportunity opp = [SELECT Id FROM Opportunity LIMIT 1];
        User u = [SELECT Id FROM User WHERE Alias = 'Tcode' LIMIT 1];
        Nucleus_Deposit_Bank__c nbt = [SELECT Id FROM Nucleus_Deposit_Bank__c LIMIT 1];
        Bank_Detail__c bank = [SELECT Id FROM Bank_Detail__c LIMIT 1];
        
        Disbursement__c disb = new Disbursement__c(
            Application__c = opp.id, BraUsr__c = u.Id, Nucleus_Deposit_Bank__c = nbt.id,
            Bank_Detail__c = bank.Id, Disbursement_Amount__c = 12000, 
            Insurance_Company__c = 'TATA AIG INSURANCE', 
            Loan_Cancellation_type__c = 'Other', // CRITICAL FIX: Avoids SObjectException for unqueried fields
            Insurance_Premium__c = 10, caseTyp__c = 'Purchase', Beneficiary_Name__c = 'Test Ben',
            Date_of_Disbursement__c = System.today()
        );
        insert disb;
        
        // Mock successful JSON
        String successJson = '{"status":"SUCCESS","requestReferenceNumber":"123","globalCollateralNumber":"GCN123","referenceNumber":"REF123","collateralType":"T","collateralSubType":"S"}';
        Test.setMock(HttpCalloutMock.class, new MockHttpResponseGenerator(200, successJson));
        
        Test.startTest();
        System.enqueueJob(new CollateralServiceHitAPIJSON(opp.id, disb.id, 'success'));
        Test.stopTest(); // Forces asynchronous execution
        
        List<Nucleus_Reciept__c> receipts = [SELECT Id FROM Nucleus_Reciept__c WHERE Application__c = :opp.Id];
        System.assert(receipts.size() > 0, 'Nucleus Receipt should be inserted upon successful Callout.');
    }
    
