    public static void creationOfPDD(List<Disbursement__c> disList,Map<Id, Disbursement__c> oldMap){
        
        
        Set< Id > setApplicationId = new Set< Id >();
        Date dod;
        List<String> stDocumentRecieveValues = Label.ST_DocumentRecieveValues.split(',');   //Added by @Siddhart (10-2-2025) (Suggested By Abdul)
        System.debug('stDocumentRecieveValues: '+stDocumentRecieveValues);
        //----------------------------------------------- if the Disbursement record having Tranch Details value and Disbursement Status as per label then fetching its application Id ------------------------------------------
        for( Disbursement__c objDisbur : ( List < Disbursement__c > ) Trigger.new ){
            
            if( objDisbur.Application__c <> null && objDisbur.Tranch_Details__c == Label.Disbursement_TranchDetails && objDisbur.Disb_Status__c == Label.Disbursement_DisbursementStatus  ){
                if(objDisbur.Date_Send_to_Finance__c!= null)
                    dod=objDisbur.Date_Send_to_Finance__c;
                //----------------------------------------------------  only work if there is change in respective fields ---------------------------------------------------------------------------------------------
                if( Trigger.isUpdate ){
                    Integer temp=0;
                     if(objDisbur.Disb_Status__c!=oldMap.get(objDisbur.Id).Disb_Status__c)
                    {
                        temp=1;
                    }
                    if(temp==1 || label.allowPDD=='Yes')
                    {
                        setApplicationId.add( objDisbur.Application__c );
                    }
                    
                }
                //----------------------------------------------------- in case of insert, user can direct select respected values ------------------------------------------------------------------------------------
                if( Trigger.isInsert ){
                    setApplicationId.add( objDisbur.Application__c );
                }
                
            }
        }// end of triggerNew Loop
        
        if( Boolean.valueOf( Label.showDebugForDisbursementTriggerHelper )){ system.debug('setApplicationId'+setApplicationId); }
        
        if( setApplicationId.size() > 0 ){
            
            //---------------------------------------------- mapping ST-condition( CAM,Technical Verification, Property Master ) and Document_Check_List_History_Line_Item__c with existing pdd -----------------
            Map<  String, PDD__c > mapParentIdWithExistingPdd = new Map<  String, PDD__c >();
            List< PDD__c > listPdd = new List< PDD__c >();
            
            //Karan Singh 23Jan2020 to update st-condition flag when new pdd is created
            List< ST_Condition__c > listSt_Condition = new List< ST_Condition__c >();
            List<PDD__C> list_Pdd=[SELECT Id, Document_Check_List_History_Line_Item__c, ST_Condition__c FROM PDD__C WHERE Opportunity__c IN :setApplicationId];
            System.debug('list_Pdd.size()-> '+list_Pdd.size());
            for( PDD__C objPdd : list_Pdd )
            {
                
                if( objPdd.Document_Check_List_History_Line_Item__c <> Null ){
                    
                    //for operation
                    mapParentIdWithExistingPdd.put( objPdd.Document_Check_List_History_Line_Item__c, objPdd );
                }
                else if( objPdd.ST_Condition__c <> Null){
                    
                    //for Credit,Technical,Legal
                    mapParentIdWithExistingPdd.put( objPdd.ST_Condition__c, objPdd );
                }
                
            }// end of existing pdd loop
            
            if( Boolean.valueOf( Label.showDebugForDisbursementTriggerHelper )){ 
                system.debug('mapParentIdWithExistingPdd'+mapParentIdWithExistingPdd);
                system.debug('mapParentIdWithExistingPdd'+mapParentIdWithExistingPdd.size());
            }
            
            //@Karan Singh( Saif ) 6Jan2019 added Label.Document_Check_List_History_Line_Items_CPU_RPU_Comments condition as instead of "No", it can be any value as per in label
            if( String.isNotBlank( Label.Document_Check_List_History_Line_Items_CPU_RPU_Comments ) ){
                
                //-----------------------------------------------   fetching Check_List_History_Line_Item__c who's grandParent's application iD is in setApplicationId ----------------------------------
                Map < id, Check_List_History_Line_Item__c > mapIdToChckListHistryLineItem = new Map < id, Check_List_History_Line_Item__c >( [ SELECT Id,Document_Question_Master__r.Name,( SELECT Id FROM PDDs__r),LastModifiedBy.name,LastModifiedDate,Document_Checklist_History__r.Document_Checklist__r.Application__c,CPU_RPU_Comments__c
                                                                                                                                              FROM  Check_List_History_Line_Item__c 
                                                                                                                                              WHERE Document_Checklist_History__r.Document_Checklist__r.Application__c  IN: setApplicationId 
                                                                                                                                              AND CPU_RPU_Comments__c IN: Label.Document_Check_List_History_Line_Items_CPU_RPU_Comments.split(',') ] ); //AND CPU_RPU_Comments__c = 'No'
                
                if( Boolean.valueOf( Label.showDebugForDisbursementTriggerHelper )){ system.debug('mapIdToChckListHistryLineItem'+mapIdToChckListHistryLineItem); }
                
                if( mapIdToChckListHistryLineItem.size() > 0 ){
                    
                    for( Id ChckListHistryLineItemId : mapIdToChckListHistryLineItem.keySet() ){
                        
                        //--------------------------------------------------  if doesnot have any existing Pdd records then made new Pdd records  ---------------------------------------------------------------
                        if( mapIdToChckListHistryLineItem.get( ChckListHistryLineItemId ).PDDs__r.size() == 0 ){
                            String dt=mapIdToChckListHistryLineItem.get(ChckListHistryLineItemId).LastModifiedDate.format();
                            listPdd.add( new Pdd__c( Document_Check_List_History_Line_Item__c = ChckListHistryLineItemId,
                                                    Condition_Last_Modified_by__c=mapIdToChckListHistryLineItem.get(ChckListHistryLineItemId).lastmodifiedby.name+' '+dt,
                                                    Opportunity__c = mapIdToChckListHistryLineItem.get( ChckListHistryLineItemId ).Document_Checklist_History__r.Document_Checklist__r.Application__c,
                                                    Document_Received__c = 'No', Document_Name__c = mapIdToChckListHistryLineItem.get( ChckListHistryLineItemId ).Document_Question_Master__r.Name, Condition_Applied_By__c = 'Operations',
                                                    Expected_Time__c = mapIdToChckListHistryLineItem.get( ChckListHistryLineItemId ).CPU_RPU_Comments__c )
                                       );
                        }
                        
                        // ------------------------------------------------- If not then update only those records who are child of application  ------------------------------------------------------------
                        else {
                            
                            for( Pdd__c objPdd : mapIdToChckListHistryLineItem.get( ChckListHistryLineItemId ).PDDs__r ){
                                
                                if( mapParentIdWithExistingPdd.containsKey( ChckListHistryLineItemId ) ){
                                    objPdd.Document_Name__c = mapIdToChckListHistryLineItem.get( ChckListHistryLineItemId ).Document_Question_Master__r.Name;
                                    objPdd.Expected_Time__c = mapIdToChckListHistryLineItem.get( ChckListHistryLineItemId ).CPU_RPU_Comments__c ; 
                                    objPdd.Condition_Last_Modified_by__c=mapIdToChckListHistryLineItem.get(ChckListHistryLineItemId).lastmodifiedby.name;
                                    
                                    listPdd.add( objPdd ); 
                                }
                            }
                            
                        }//end of if else of existing PDD
                    }//end of for loop
                }//end of mapIdToChckListHistryLineItem size()
            }//end of Label.Document_Check_List_History_Line_Items_CPU_RPU_Comments
            
            if( Boolean.valueOf( Label.showDebugForDisbursementTriggerHelper )){ system.debug('listPdd'+listPdd); }
            
            //---------------------------------------------------  Fetching ST-Condition of Technical Verification, CAM and Property Master whose Parent Id in setApplicationId  -------------------------------------
            for( ST_Condition__c objST: [ SELECT Id,Remark__c, Document_Name__c,Flag__c, Expected_Time__c, CAM__r.Loan_Application__c, Technical_Verification__r.Application__c,Document_Received__c,Document_executed__c,Received_Date__c,Date_of_Document__c,Document_Category__c
                                         ,( SELECT Id FROM PDDs__r ),Property_Master__c,Property_Master__r.Household__r.LoanAppID__c,LastModifiedDate,lastmodifiedby.name FROM ST_Condition__c
                                         WHERE ( CAM__r.Loan_Application__c IN :setApplicationId OR Technical_Verification__r.Application__c IN :setApplicationId OR Property_Master__r.Household__r.LoanAppID__c IN :setApplicationId )
                                         And Flag__c=false] )
            {
                if( Boolean.valueOf( Label.showDebugForDisbursementTriggerHelper )){ system.debug('objST'+objST); }
                
                //-----------------------------  if the ST-Condition Id  exists in the PDDs whose are under Application, Then we will update those PDDs with new data from ST Conditions  -----------------------------------
                if( mapParentIdWithExistingPdd.containsKey( objST.Id ) && objST.PDDs__r.size() > 0 ){
                    
                    for( PDD__c  objPdd : objST.PDDs__r ){
                        
                        objPdd.Document_Name__c = objST.Document_Name__c;
                        objPdd.Expected_Time__c = objST.Expected_Time__c;
                        objPdd.Document_Received__c = objST.Document_Received__c;
                        String dt=objST.LastModifiedDate.format();
                        objPdd.Condition_Last_Modified_by__c=objST.lastmodifiedby.name+' '+dt;
                        listPdd.add( objPdd );
                        
                        if( Boolean.valueOf( Label.showDebugForDisbursementTriggerHelper )){ system.debug('objPdd'+objPdd); }
                    }
                }//end of existing pdd
                
                //-------------------------------------------------------------- If Pdd doesnot exists then make new PDD -----------------------------------------------------------------------------------------------
                else if(!stDocumentRecieveValues.isEmpty() && stDocumentRecieveValues.contains(objST.Document_Received__c) && !mapParentIdWithExistingPdd.containsKey( objST.Id ) ){	//stDocumentRecieveValues Check added by @Siddhart (10-2-2025) (Suggested By Abdul)
                    
                    if( Boolean.valueOf( Label.showDebugForDisbursementTriggerHelper )){ system.debug('objST'+objST); }
                    
                    if( objST.CAM__r.Loan_Application__c <> Null ){
                        
                        Pdd__c objPdd = new Pdd__c();
                        objPdd.Document_Name__c = objSt.Document_Name__c;
                        objPdd.Expected_Time__c = objSt.Expected_Time__c;
                        objPdd.Document_Received__c = objSt.Document_Received__c;
                        objPdd.Condition_Applied_By__c = 'Credit';
                        if(dod!= null)
                            objPdd.Date_of_Disbursement1__c=dod;
                        objPdd.Remark__c=objSt.Remark__c;
                        objPdd.Opportunity__c = objSt.CAM__r.Loan_Application__c;
                        objPdd.ST_Condition__c = objSt.Id;
                        String dt=objST.LastModifiedDate.format();
                        objPdd.Condition_Last_Modified_by__c=objST.lastmodifiedby.name+' '+dt;
                        
                        //---added by @Siddhart (3-4-2025) (Suggested By Abdul) ---//
                        if(objSt.Document_Received__c == 'Yes' && objSt.Document_Category__c == 'Original'){
                            objPdd.Document_Category__c = 'Original Document';					
                        }
                        else if(objSt.Document_Received__c == 'Yes' && objSt.Document_Category__c == 'Photocopy'){
                            objPdd.Document_Category__c = 'Photocopy';					
                        }
                        else if(objSt.Document_Received__c == 'Yes' && objSt.Document_Category__c == 'CTC'){
                            objPdd.Document_Category__c = 'CTC (Online Receipt)';					
                        }
                        
                        objPdd.Document_Executed__c = objSt.Document_executed__c;					 
                        objPdd.Received_Date__c = objSt.Received_Date__c;							
                        objPdd.Date_of_Document_Executed__c = objSt.Date_of_Document__c;	
                        //-------------------End-------------------------//
                        
                        listPdd.add( objPdd ); 
                        
                        if( Boolean.valueOf( Label.showDebugForDisbursementTriggerHelper )){ system.debug('objPdd'+objPdd); }
                    }
                    else if( objST.Technical_Verification__r.Application__c <> Null ){
                        
                        Pdd__c objPdd = new Pdd__c();
                        objPdd.Document_Name__c = objSt.Document_Name__c;
                        objPdd.Expected_Time__c = objSt.Expected_Time__c;
                        objPdd.Document_Received__c = objSt.Document_Received__c;
                        objPdd.Condition_Applied_By__c = 'Technical';
                        if(dod!= null)
                            objPdd.Date_of_Disbursement1__c=dod;
                        objPdd.Remark__c=objSt.Remark__c;
                        objPdd.Opportunity__c = objSt.Technical_Verification__r.Application__c;
                        objPdd.ST_Condition__c = objSt.Id;
                        String dt=objST.LastModifiedDate.format();
                        objPdd.Condition_Last_Modified_by__c=objST.lastmodifiedby.name+' '+dt;
                        
                        //---added by @Siddhart (3-4-2025) (Suggested By Abdul) ---//
                        if(objSt.Document_Received__c == 'Yes' && objSt.Document_Category__c == 'Original'){
                            objPdd.Document_Category__c = 'Original Document';					
                        }
                        else if(objSt.Document_Received__c == 'Yes' && objSt.Document_Category__c == 'Photocopy'){
                            objPdd.Document_Category__c = 'Photocopy';					
                        }
                        else if(objSt.Document_Received__c == 'Yes' && objSt.Document_Category__c == 'CTC'){
                            objPdd.Document_Category__c = 'CTC (Online Receipt)';					
                        }
                        
                        objPdd.Document_Executed__c = objSt.Document_executed__c;					 
                        objPdd.Received_Date__c = objSt.Received_Date__c;							
                        objPdd.Date_of_Document_Executed__c = objSt.Date_of_Document__c;	
                        //-------------------End-------------------------//
                        
                        listPdd.add( objPdd ); 
                        
                        if( Boolean.valueOf( Label.showDebugForDisbursementTriggerHelper )){ system.debug('objPdd'+objPdd); }
                    }
                    else if( objST.Property_Master__r.Household__r.LoanAppID__c <> Null ){
                        
                        Pdd__c objPdd = new Pdd__c();
                        objPdd.Document_Name__c = objSt.Document_Name__c;
                        objPdd.Expected_Time__c = objSt.Expected_Time__c;
                        objPdd.Document_Received__c = objSt.Document_Received__c;
                        objPdd.Condition_Applied_By__c = 'Legal';
                        if(dod!= null)
                            objPdd.Date_of_Disbursement1__c=dod;
                        objPdd.Remark__c=objSt.Remark__c;
                        objPdd.Opportunity__c = objSt.Property_Master__r.Household__r.LoanAppID__c;
                        objPdd.ST_Condition__c = objSt.Id;
                        String dt=objST.LastModifiedDate.format();
                        objPdd.Condition_Last_Modified_by__c=objST.lastmodifiedby.name+' '+dt;
                        
                        //---added by @Siddhart (3-4-2025) (Suggested By Abdul) ---//
                        if(objSt.Document_Received__c == 'Yes' && objSt.Document_Category__c == 'Original'){
                            objPdd.Document_Category__c = 'Original Document';					
                        }
                        else if(objSt.Document_Received__c == 'Yes' && objSt.Document_Category__c == 'Photocopy'){
                            objPdd.Document_Category__c = 'Photocopy';					
                        }
                        else if(objSt.Document_Received__c == 'Yes' && objSt.Document_Category__c == 'CTC'){
                            objPdd.Document_Category__c = 'CTC (Online Receipt)';					
                        }
                        
                        objPdd.Document_Executed__c = objSt.Document_executed__c;					 
                        objPdd.Received_Date__c = objSt.Received_Date__c;							
                        objPdd.Date_of_Document_Executed__c = objSt.Date_of_Document__c;	
                        //-------------------End-------------------------//
                        
                        listPdd.add( objPdd ); 
                        
                        if( Boolean.valueOf( Label.showDebugForDisbursementTriggerHelper )){ system.debug('objPdd'+objPdd); }
