@IsTest
public class MicroSoftCreateAccountAPITest {

    @IsTest
    static void testApiMethodsAndWrapper() {
        Test.startTest();

        // Cover all 7 public Wrapper properties (both setters and getters)
        MicroSoftCreateAccountAPI.Wrapper reqObj = new MicroSoftCreateAccountAPI.Wrapper();
        reqObj.id = '12345';
        reqObj.inviteRedeemUrl = 'https://myapp.com/redeem';
        reqObj.invitedUserType = 'Guest';
        reqObj.invitedUserEmailAddress = 'test@example.com';
        reqObj.sendInvitationMessage = true;
        reqObj.inviteRedirectUrl = 'https://myapp.com';
        reqObj.status = 'Success';

        // Read getters explicitly
        System.assertEquals('12345', reqObj.id);
        System.assertEquals('https://myapp.com/redeem', reqObj.inviteRedeemUrl);
        System.assertEquals('Guest', reqObj.invitedUserType);
        System.assertEquals('test@example.com', reqObj.invitedUserEmailAddress);
        System.assertEquals(true, reqObj.sendInvitationMessage);
        System.assertEquals('https://myapp.com', reqObj.inviteRedirectUrl);
        System.assertEquals('Success', reqObj.status);

        // Cover all reachable lines in both API methods
        MicroSoftCreateAccountAPI.doPostForGetAccessToken('test@example.com', 'sId');
        MicroSoftCreateAccountAPI.doPostInvitationsAPI('mockToken', 'test@example.com', 'sId');

        Test.stopTest();
    }
}
