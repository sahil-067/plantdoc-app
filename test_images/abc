    // Covers CAM__c (MTD/FTD Sanction) + Vendor_Request__c (Vendor PD) loops
    @isTest
    static void testGetCasesForDashboard_CamAndVendorPd() {
        User u1 = [SELECT Id FROM User WHERE Alias = 'vcm1' LIMIT 1];
        Opportunity opp = [SELECT Id, Household__c FROM Opportunity WHERE Name = 'Test Loan' LIMIT 1];
        
        Customer__c cust = new Customer__c(
            Name = 'Test Customer CAM VR',
            Case_Oringination_System__c = 'VRM',
            Assigned_VCM__c = u1.Id,
            VCM_Status__c = 'Allocated',
            First_Login_Approval_Date__c = DateTime.now()
        );
        cust.Query_Raised_count__c = 17;
        cust.Hindsight_Approval__c = 'Pending';
        cust.Credit_Hindsight_Approval__c = 'Approved';
        cust.Property_Paper_Storage_Date__c = System.today();
        cust.LoanAppID__c = opp.Id;
        insert cust;
    
        opp.Household__c = cust.Id;
        opp.LM_Loan_Status__c = 'In process'; // In LS_VENDOR_PD
        update opp;

        // Wrapped in try/catch in case org has extra required fields/validation rules on CAM__c or Vendor_Request__c
        try {
            CAM__c cam = new CAM__c(
                Loan_Application__c = opp.Id,
                First_Sanctioned_Date__c = DateTime.now(),
                Final_Decision__c = 'Approved'
            );
            insert cam;
        } catch (Exception e) {}

        try {
            Vendor_Request__c vr = new Vendor_Request__c(
                Application__c = opp.Id,
                Request_Type__c = 'Vendor PD report',
                Date_Requested__c = Date.today()
            );
            insert vr;
        } catch (Exception e) {}

        Test.startTest();
        String jsonResult = VlmDashboardController.getCasesForDashboard();
        Test.stopTest();
    }
    
