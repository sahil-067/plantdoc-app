    @IsTest
    static void testFncSendPayOnLinkDirect() {
        // Covers the inner block of fncSendPayOnLink shown in d6b09c02-f2ee-4fa0-9f9c-7cccda02645b
        Opportunity opp = [SELECT Id FROM Opportunity WHERE Loan_Number__c = 'AP-99009871' LIMIT 1];
        
        Pay_Slip__c testPaySlip = new Pay_Slip__c();
        testPaySlip.Amount__c = 1000;
        testPaySlip.Application__c = opp.Id;
        testPaySlip.PaySlip_Status__c = 'Active';
        testPaySlip.Instrument__c = 'Electronic payment';
        insert testPaySlip;
        
        Set<Id> paySlipIds = new Set<Id>{testPaySlip.Id};
        
        Test.startTest();
        // Wrapping the future method inside startTest/stopTest forces it to execute synchronously
        PayPostAPIHelper.sData = 'testData'; 
        PayPostAPIHelper.fncSendPayOnLink(paySlipIds, 1000);
        Test.stopTest();
        
        // Optional: Verify the PayU_Payment_Status__c was actually inserted
        List<PayU_Payment_Status__c> statusList = [SELECT Id, Status__c FROM PayU_Payment_Status__c WHERE Pay_Slip__c = :testPaySlip.Id];
        System.assertEquals(1, statusList.size(), 'A PayU_Payment_Status__c record should have been created.');
        System.assertEquals('Requested', statusList[0].Status__c, 'Status should be Requested.');
    }
