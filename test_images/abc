    @isTest
    public static void testPennydropEdgeCases() {
        // 1. Fetch existing setup data
        Opportunity op = [SELECT Id, Name, Household__c FROM Opportunity LIMIT 1];
        Customer__c cus = [SELECT Id, LoanAppID__c FROM Customer__c WHERE Id = :op.Household__c LIMIT 1];

        // 2. Setup a Bank Account specifically to hit the SECOND red block
        // We set Is_PennyDrop_Done__c = false to fail the 1st block, but keep Percentage > 90 to pass the 2nd block
        Bank_Account_Detail__c badc2 = new Bank_Account_Detail__c(
            Bank_name__c = 'SBI',
            Household__c = cus.Id,
            Bank_Account_Number__c = '55555555',
            Percentage__c = '95',
            Is_PennyDrop_Done__c = false, 
            Name_of_Account_Holder__c = 'Jane Doe',
            PennyDrop_Status_Code__c = 'NP001', 
            Disbursement_in_this_Account__c = 'Yes'
        );

        // 3. Setup a Bank Account specifically to hit the THIRD red block
        // We set Percentage to null to fail the 1st and 2nd blocks entirely
        Bank_Account_Detail__c badc3 = new Bank_Account_Detail__c(
            Bank_name__c = 'AXIS',
            Household__c = cus.Id,
            Bank_Account_Number__c = '77777777',
            Percentage__c = null, 
            Is_PennyDrop_Done__c = false,
            Name_of_Account_Holder__c = 'Jack Doe',
            PennyDrop_Status_Code__c = 'NP001', 
            Disbursement_in_this_Account__c = 'Yes'
        );
        insert new List<Bank_Account_Detail__c>{ badc2, badc3 };

        // 4. Create Disbursements linked to these specific dummy bank accounts
        Disbursement__c disb2 = new Disbursement__c(
            Application__c = op.Id,
            Disbursement_Amount__c = 10000,
            Disbursement_Mode__c = 'Direct Transfer',
            Bank_Account_No__c = '55555555', // Links to badc2
            caseTyp__c = 'Normal',
            Insurance_Premium__c = 0,
            IFSC_Code__c = 'BARBOMUZRAM'
        );

        Disbursement__c disb3 = new Disbursement__c(
            Application__c = op.Id,
            Disbursement_Amount__c = 10000,
            Disbursement_Mode__c = 'Direct Transfer',
            Bank_Account_No__c = '77777777', // Links to badc3
            caseTyp__c = 'Normal',
            Insurance_Premium__c = 0,
            IFSC_Code__c = 'BARBOMUZRAM'
        );
        insert new List<Disbursement__c>{ disb2, disb3 };

        // 5. Create the Deviation needed to trigger the Third Block
        Deviation__c dev = new Deviation__c(
            Opportunity__c = op.Id,
            Approval_Status__c = 'Approved',
            Waiver__c = 'Pennydrop Name Mismatch',
            Disbursement__c = disb3.Id,
            Bank_Account_Number__c = '77777777' // Matches disb3
        );
        insert dev;

        // 6. Query back to populate the CreatedDate field in memory!
        List<Disbursement__c> listToTest = [
            SELECT Id, Application__c, Disbursement_Mode__c, Bank_Account_No__c, caseTyp__c, createddate
            FROM Disbursement__c WHERE Id IN (:disb2.Id, :disb3.Id)
        ];

        Test.startTest();
        // Fire the function using our edge-case data
        DisbursementLTVHandler.pennydropFunction(listToTest);
        Test.stopTest();
    }
