    public static String checkLatestError(Id applicationId) {
        System.debug('applicationId++' + applicationId);
        List<Legality__c> errors = [
            SELECT Error_Message__c
            FROM Legality__c
            WHERE Application__c = :applicationId AND Leegality_Status__c = 'Accepted'
