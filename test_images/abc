@isTest
public class AttendanceCalculatorTest {

    @testSetup
    static void setupTestData() {
        Profile p = [SELECT Id FROM Profile WHERE Name = 'Standard User' LIMIT 1];
        String uniqueSuffix = String.valueOf(System.currentTimeMillis());

        // 1. Insert Users first without Branch__c (Setup Object)
        User hoUser = createTestUser('HO', 'User', 'ho' + uniqueSuffix + '@test.com', p.Id, 'EMP_HO');
        User ncmUser = createTestUser('NCM', 'User', 'ncm' + uniqueSuffix + '@test.com', p.Id, 'EMP_NCM');
        User zcmUser = createTestUser('ZCM', 'User', 'zcm' + uniqueSuffix + '@test.com', p.Id, 'EMP_ZCM');
        User rcmUser = createTestUser('RCM', 'User', 'rcm' + uniqueSuffix + '@test.com', p.Id, 'EMP_RCM');
        User acmUser = createTestUser('ACM', 'User', 'acm' + uniqueSuffix + '@test.com', p.Id, 'EMP_ACM');
        User noBranchUser = createTestUser('None', 'User', 'none' + uniqueSuffix + '@test.com', p.Id, 'EMP_NONE');

        insert new List<User>{ hoUser, ncmUser, zcmUser, rcmUser, acmUser, noBranchUser };

        Branch__c hoBranch;
        Branch__c br1;

        // 2. Insert non-setup objects inside System.runAs to avoid MIXED_DML_OPERATION
        System.runAs(hoUser) {
            Id accRecordTypeId = Schema.SObjectType.Account.getRecordTypeInfosByName().get('ISFCL - Employee').getRecordTypeId();
            Id attRecordTypeId = Schema.SObjectType.Attendance__c.getRecordTypeInfosByName().get('iCollect').getRecordTypeId();

            hoBranch = new Branch__c(
                Name = 'Headoffice',
                Branch_State__c = 'Delhi',
                Branch_City__c = 'New Delhi'
            );

            br1 = new Branch__c(
                Name = 'Test Branch 1',
                Branch_State__c = 'Haryana',
                Branch_City__c = 'Gurugram',
                National_Collection_Manager__c = ncmUser.Id,
                Zonal_Collection_Manager__c = zcmUser.Id,
                Branch_Regional_Collection__c = rcmUser.Id,
                Branch_Area_Collection__c = acmUser.Id
            );

            Branch__c br2 = new Branch__c(
                Name = 'Test Branch 2',
                Branch_State__c = 'Haryana',
                Branch_City__c = 'Rohtak',
                National_Collection_Manager__c = ncmUser.Id,
                Zonal_Collection_Manager__c = zcmUser.Id,
                Branch_Regional_Collection__c = rcmUser.Id,
                Branch_Area_Collection__c = acmUser.Id
            );
            insert new List<Branch__c>{ hoBranch, br1, br2 };

            // Create Person Accounts for BCMs and COs on both branches
            Account bcm1 = new Account(
                RecordTypeId = accRecordTypeId,
                FirstName = 'BCM',
                LastName = 'One',
                Branch__c = br1.Id,
                Empl_Code__pc = 'EMP_BCM1',
                Designation__pc = 'BCM',
                Mobile__pc = '9876543210'
            );
            Account bcm2 = new Account(
                RecordTypeId = accRecordTypeId,
                FirstName = 'BCM',
                LastName = 'Two',
                Branch__c = br2.Id,
                Empl_Code__pc = 'EMP_BCM2',
                Designation__pc = 'BCM',
                Mobile__pc = '9876543211'
            );
            Account co1 = new Account(
                RecordTypeId = accRecordTypeId,
                FirstName = 'CO',
                LastName = 'One',
                Branch__c = br1.Id,
                Empl_Code__pc = 'EMP_CO1',
                Designation__pc = 'C.O',
                Mobile__pc = '9876543212'
            );
            Account co2 = new Account(
                RecordTypeId = accRecordTypeId,
                FirstName = 'CO',
                LastName = 'Two',
                Branch__c = br2.Id,
                Empl_Code__pc = 'EMP_CO2',
                Designation__pc = 'CO',
                Mobile__pc = '9876543213'
            );
            insert new List<Account>{ bcm1, bcm2, co1, co2 };

            Map<Id, Account> insertedAccMap = new Map<Id, Account>([
                SELECT Id, PersonContactId FROM Account WHERE Id IN :new List<Id>{ bcm1.Id, bcm2.Id }
            ]);

            br1.Collection_Manager__c = insertedAccMap.get(bcm1.Id).PersonContactId;
            br2.Collection_Manager__c = insertedAccMap.get(bcm2.Id).PersonContactId;
            update new List<Branch__c>{ br1, br2 };

            // Attendance records: active (< 45 mins) and inactive (>= 45 mins)
            DateTime recentTime = DateTime.now().addMinutes(-10);
            DateTime oldTime = DateTime.now().addMinutes(-60);

            insert new List<Attendance__c>{
                new Attendance__c(
                    RecordTypeId = attRecordTypeId,
                    Account__c = bcm1.Id,
                    Date__c = recentTime,
                    Active__c = true
                ),
                new Attendance__c(
                    RecordTypeId = attRecordTypeId,
                    Account__c = co1.Id,
                    Date__c = oldTime,
                    Active__c = true
                ),
                new Attendance__c(
                    RecordTypeId = attRecordTypeId,
                    Account__c = bcm2.Id,
                    Date__c = recentTime,
                    Active__c = true
                ),
                new Attendance__c(
                    RecordTypeId = attRecordTypeId,
                    Account__c = co2.Id,
                    Date__c = oldTime,
                    Active__c = false
                )
            };

            insert new List<Opportunity>{
                new Opportunity(
                    Name = 'Test Opp 1',
                    StageName = 'Prospecting',
                    CloseDate = Date.today().addDays(30),
                    Legal_Action_Person__c = 'EMP_BCM1'
                ),
                new Opportunity(
                    Name = 'Test Opp 2',
                    StageName = 'Prospecting',
                    CloseDate = Date.today().addDays(30),
                    Legal_Action_Person__c = 'EMP_NCM'
                )
            };
        }

        // 3. Update User.Branch__c lookup IDs in a separate runAs context to prevent MIXED_DML_OPERATION
        System.runAs(new User(Id = UserInfo.getUserId())) {
            hoUser.Branch__c = hoBranch.Id;
            ncmUser.Branch__c = br1.Id;
            zcmUser.Branch__c = br1.Id;
            rcmUser.Branch__c = br1.Id;
            acmUser.Branch__c = br1.Id;
            noBranchUser.Branch__c = br1.Id;
            update new List<User>{ hoUser, ncmUser, zcmUser, rcmUser, acmUser, noBranchUser };
        }
    }

    private static User createTestUser(String fName, String lName, String email, Id profileId, String empNum) {
        return new User(
            FirstName = fName,
            LastName = lName,
            Email = email,
            Username = email,
            Alias = (fName.substring(0, 1) + lName.substring(0, 3)).toLowerCase(),
            TimeZoneSidKey = 'Asia/Kolkata',
            LocaleSidKey = 'en_US',
            EmailEncodingKey = 'UTF-8',
            LanguageLocaleKey = 'en_US',
            ProfileId = profileId,
            EmployeeNumber = empNum,
            MobilePhone = '9999999999'
        );
    }

    private static User getUserByEmpNum(String empNum) {
        return [SELECT Id, Name, EmployeeNumber, MobilePhone, Branch__c FROM User WHERE EmployeeNumber = :empNum LIMIT 1];
    }

    @isTest
    static void testUtil1_AsNCM_AllFilters() {
        User ncmUser = getUserByEmpNum('EMP_NCM');
        DateTime startDt = DateTime.now().addHours(-2);
        DateTime endDt = DateTime.now().addHours(1);

        Test.startTest();
        System.runAs(ncmUser) {
            // Both startDate & endDate, status = null, with state & selectedTimeFilter
            String res1 = AttendanceCalculator.Util_1('Haryana', null, startDt, endDt, 120);
            System.assertNotEquals(null, res1, 'NCM response should not be null');

            // Only startDate, status = true
            String res2 = AttendanceCalculator.Util_1('Haryana', true, startDt, null, null);
            System.assertNotEquals(null, res2);

            // Only endDate, status = false
            String res3 = AttendanceCalculator.Util_1(null, false, null, endDt, null);
            System.assertNotEquals(null, res3);
        }
        Test.stopTest();
    }

