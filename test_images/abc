                LocationWrapper rec = new LocationWrapper();
                rec.id = key;
                rec.latitude = atendanceMap.get(key).Current_Location__Latitude__s;
                rec.longitude = atendanceMap.get(key).Current_Location__Longitude__s;
                rec.title = atendanceMap.get(key).Account__r.Name +' | '+ atendanceMap.get(key).Employee_ID__c;
                rec.description = '';
                if(atendanceMap.get(key).CreatedDate.addMinutes(45) < gmtNow){
                    inActiveCount++;
