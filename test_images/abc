@RestResource(urlMapping='/CallBotCollection/*')
global class CallBotCollectionWebhookService {
    @HttpPost
    global static void doPost(){
        
        RestRequest req = RestContext.request;
        RestResponse res = RestContext.response;
        
        CallResponse response = new CallResponse();
        
        Integer payAmount;
        Opportunity opp;
        Id recordTypeId;
        String mobile;
        String body;
        
        try{
            body = req.requestBody.toString();
            System.debug('body24: '+body);
            Whatsapp_collect_send_request__c wc = new Whatsapp_collect_send_request__c();
            wc.Request_Body__c = body; 
            
            if(String.isBlank(body)){
                response.success = false;
                response.message = 'Empty request body';
                res.statusCode = 400;
                res.responseBody = Blob.valueOf(JSON.serializePretty(response));
                
                wc.BOT_Request__c = String.valueOf(JSON.serializePretty(response));
                wc.Response__c = String.valueOf(JSON.serializePretty(response));
                insert wc;
                return;
            }
            
            CallWebhookWrapper payload = (CallWebhookWrapper) JSON.deserialize(body, CallWebhookWrapper.class);
            
            if(String.isBlank(payload.loan_id) || (String.isBlank(payload.phone_Number) && String.isBlank(payload.customer_number))){
                response.success = false;
                response.message = 'Required parameters are missing like Loan Id, Phone Number etc.';
                res.statusCode = 400;
                res.responseBody = Blob.valueOf(JSON.serializePretty(response));
                
                wc.BOT_Request__c = String.valueOf(JSON.serializePretty(response));
                wc.Response__c = String.valueOf(JSON.serializePretty(response));
                insert wc;
                
                return;
            }
            
            System.debug('payload.loan_id: '+payload.loan_id);
            opp =  [SELECT Id,Name,Loan_Number__c,BouncingcountFTM__c, Balance_Collectable__c,Due_For_the_Month__c,Due_for_the_Month_PEMI__c
                    FROM Opportunity WHERE Loan_Number__c = :payload.loan_id LIMIT 1];
            wc.Application__c = opp.Id;
            wc.Source__c=payload.source;
              if(payload.OnlyDueFortheMonth=='Yes' && opp.Due_For_the_Month__c == 0)
            {
                response.success = false;
                response.message = 'If OnlyDueFortheMonth is Yes then Due For the Month should not be zero';
                res.statusCode = 403;
                res.responseBody = Blob.valueOf(JSON.serializePretty(response));
                
                wc.BOT_Request__c = body;
                wc.Response__c = String.valueOf(JSON.serializePretty(response));
                insert wc;
                return;
            }
            else if(opp.Balance_Collectable__c==0 && payload.OnlyDueFortheMonth!='Yes')
            {
                 if(opp.BouncingcountFTM__c<=0){
                  
                response.success = false;
                response.message = 'Balance Collectable Should not be Zero ';
                res.statusCode = 403;
                res.responseBody = Blob.valueOf(JSON.serializePretty(response));
                
                wc.BOT_Request__c = body;
                wc.Response__c = String.valueOf(JSON.serializePretty(response));
                insert wc;
                return;
                 }
            }
            Double emiDueForMonth = Math.min((opp.Balance_Collectable__c != null ? opp.Balance_Collectable__c : 0), (opp.Due_For_the_Month__c != null ? opp.Due_For_the_Month__c : 0) + (opp.Due_for_the_Month_PEMI__c != null ? opp.Due_for_the_Month_PEMI__c : 0));
            Double arrearEmi = Math.max(0,((opp.Balance_Collectable__c != null ? opp.Balance_Collectable__c : 0)  - (opp.Due_For_the_Month__c != null ? opp.Due_For_the_Month__c : 0) - (opp.Due_for_the_Month_PEMI__c != null ? opp.Due_for_the_Month_PEMI__c : 0)));
            
            if(payload.source == 'CC-003'){
                recordTypeId = Schema.sObjectType.Whatsapp_collect_send_request__c.getRecordTypeInfosByName().get('GreyLabs').getRecordTypeId();
                mobile = payload.customer_number;
            }
            else if(payload.source == 'CC-002'){
                recordTypeId = Schema.sObjectType.Whatsapp_collect_send_request__c.getRecordTypeInfosByName().get('Gnani').getRecordTypeId();
                mobile = payload.phone_Number;
            }
            else if(payload.source == 'CC-004'){
                recordTypeId = Schema.sObjectType.Whatsapp_collect_send_request__c.getRecordTypeInfosByName().get('Internal bot').getRecordTypeId();
                mobile = payload.phone_Number;
            }
            wc.RecordTypeId = recordTypeId;
            String token = SetuSendBill_GenerateTokenAPI.getToken(null);
            System.debug('Token::: '+token);
            if(String.isBlank(token)){
                response.success = false;
                response.message = 'Payment API Authentication failed.';
                res.statusCode = 403;
                res.responseBody = Blob.valueOf(JSON.serializePretty(response));
                
                wc.BOT_Request__c = body;
                wc.Response__c = String.valueOf(JSON.serializePretty(response));
                insert wc;
                return;
            }
            
            
            if(payload.OnlyDueFortheMonth=='Yes')
            {
                payAmount = Integer.ValueOf((opp.Due_For_the_Month__c != null ? opp.Due_For_the_Month__c : 0)*100);
            	wc.Amount__c = payAmount;
            }
            else
            {
                Integer temp=0;
                if(opp.BouncingcountFTM__c>0){
                    temp=Integer.valueof((opp.BouncingcountFTM__c*700));
                }
                System.debug('Temp val '+temp);
                payAmount = Integer.ValueOf(((emiDueForMonth + arrearEmi) * 100)+(temp*100));
           	    wc.Amount__c = payAmount;
            }
            
            
            // Calculate the due date as the 7th of the current                     
            Date dueDate = Date.today().toStartOfMonth().addDays(6);
            
            // Convert Date → DateTime so that custom format works
            DateTime dt = DateTime.newInstance(dueDate, Time.newInstance(0, 0, 0, 0));
            String formattedDate = dt.format('dd.MM.yyyy');
            
            // Calculate the expiry date as the last day of the current month
           /* Datetime expiryDT = Date.today().toStartOfMonth().addMonths(1).addDays(-1);
            String expiryDate = expiryDT.formatGmt('yyyy-MM-dd\'T\'HH:mm:ss\'Z\'').split('T')[0]+'T20:55:22Z';
            System.debug('Due Date: ' + formattedDate+' Expiry Date: ' + expiryDate); */
            Date expiry = Date.today().toStartOfMonth().addMonths(1).addDays(-1);
            String expiryDate = Datetime.newInstanceGmt(expiry, Time.newInstance(0, 0, 0, 0)).formatGmt('yyyy-MM-dd\'T\'HH:mm:ss\'Z\'');
            System.debug('Due Date: ' + formattedDate + ' Expiry Date: ' + expiryDate);
			
            
            String paymentAPIBody = '{"bill":{"amount":{"value":'+payAmount+',"currencyCode":"INR"},"additionalInfo":{"destination":"'+mobile+'","loan_number":"'+payload.loan_id+'","due_date":"'+formattedDate+'","referenceID":"123412","Collector_Name":"'+payload.collector_name+'","Source":"'+payload.source+'" ,"MobileTriggered":"'+mobile+'"},"billerBillID":"INDIA SHELTER FINANCE CORPORATION","amountExactness":"EXACT","expiryDate":"'+expiryDate+'"},"channels":[{"destination":"'+mobile+'","campaignID":"setu_eng_reminder_1","channel":"whatsapp","template":{"loan_number":"'+payload.loan_id+'","due_date":"'+formattedDate+'"}}]}';
            System.debug('paymentAPIBody: '+paymentAPIBody);
            
            // FIX: sendBillForBOT returns SetuSendBillAPI.ResponseWrapper, not String.
            SetuSendBillAPI.ResponseWrapper botResponse = SetuSendBillAPI.sendBillForBOT(token, paymentAPIBody);
            
            if(botResponse != null && botResponse.success == true){
                response.success = true;
                response.message = 'Call data received and Payment Link sent successfully.';
                res.statusCode = 200;
                res.responseBody = Blob.valueOf(JSON.serializePretty(response));
                wc.Request_Body__c = botResponse.result;
                wc.BOT_Request__c = body;
                wc.Response__c = String.valueOf(JSON.serializePretty(response));
                insert wc;
                
            }
            else{
                response.success = false;
                response.message = 'Payment Link generation failed, Please connect admin.';
                res.statusCode = 400;
                res.responseBody = Blob.valueOf(JSON.serializePretty(response));
                wc.BOT_Request__c = body;
                wc.Response__c = botResponse != null ? botResponse.result : String.valueOf(JSON.serializePretty(response));
                insert wc;
            }
            
            
        }
        catch(Exception e){
            System.debug('Exception: '+e.getMessage()+' Line '+e.getLineNumber());
            
            response.success = false;
            response.message = 'Error processing call data';
            response.errors.add(e.getMessage());
            response.errors.add(e.getStackTraceString());
            res.statusCode = 500;
            res.responseBody = Blob.valueOf(JSON.serializePretty(response));
            
            if(opp != null){
                Whatsapp_collect_send_request__c wc = new Whatsapp_collect_send_request__c();
                System.debug('recordTypeId '+recordTypeId);
                wc.RecordTypeId = recordTypeId;
                wc.Application__c = opp.Id;
                wc.Amount__c = payAmount;
                wc.Request_Body__c = body;
                wc.BOT_Request__c = body;
                wc.Response__c = String.valueOf(JSON.serializePretty(response));
                insert wc;
            }
        } 
    }
    
