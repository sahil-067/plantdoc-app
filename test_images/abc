@isTest
private class UWDMChecklistControllerTest {

    private static final String PERM_MANAGE = 'Manage_UW_DM_Checklist';

    @testSetup
    static void setupTestData() {
        // 1. Create Test User and Assign Permissions (Wrapped in runAs to avoid Mixed DML Operations)
        User adminUser = new User(Id = UserInfo.getUserId());
        User testUser;
        
        System.runAs(adminUser) {
            // Using System Administrator profile to prevent WITH USER_MODE and stripInaccessible 
            // from failing due to unknown Object/Field Level Security in your specific org.
            Profile p = [SELECT Id FROM Profile WHERE Name = 'System Administrator' LIMIT 1];
            
            testUser = new User(
                Alias = 'uwtest',
                Email = 'uwtestuser@testorg.com',
                EmailEncodingKey = 'UTF-8',
                LastName = 'UWTesting',
                LanguageLocaleKey = 'en_US',
                LocaleSidKey = 'en_US',
                ProfileId = p.Id,
                TimeZoneSidKey = 'America/Los_Angeles',
                UserName = 'uwtestuser' + DateTime.now().getTime() + '@testorg.com'
            );
            insert testUser;

            // Create and assign a Permission Set for the required Custom Permission
            PermissionSet ps = new PermissionSet(Name = 'UW_DM_Manage_Test', Label = 'UW DM Manage Test');
            insert ps;
            
            List<CustomPermission> managePerms = [SELECT Id FROM CustomPermission WHERE DeveloperName = :PERM_MANAGE LIMIT 1];
            if (!managePerms.isEmpty()) {
                insert new SetupEntityAccess(ParentId = ps.Id, SetupEntityId = managePerms[0].Id);
                insert new PermissionSetAssignment(AssigneeId = testUser.Id, PermissionSetId = ps.Id);
            }
        }

        // 2. Create Standard/Custom Object Data
        System.runAs(testUser) {
            Opportunity opp = new Opportunity(
                Name = 'Test Loan Application',
                StageName = 'Prospecting',
                CloseDate = Date.today().addDays(30)
            );
            insert opp;

            Disbursement__c disb = new Disbursement__c(
                Application__c = opp.Id,
                disb_Status__c = 'Send to UW', // An eligible status
                Tranch_Details__c = 'Tranche 1'
            );
            insert disb;

            // Dynamically query Record Types to avoid hardcoding ID failures
            Map<String, Schema.RecordTypeInfo> nupayRtMap = Schema.SObjectType.Nupay_Response__c.getRecordTypeInfosByName();
            List<Nupay_Response__c> mandates = new List<Nupay_Response__c>();

            if (nupayRtMap.containsKey('Register ACH EMI')) {
                mandates.add(new Nupay_Response__c(
                    Opportunity__c = opp.Id,
                    RecordTypeId = nupayRtMap.get('Register ACH EMI').getRecordTypeId(),
                    Account_Holder_Name__c = 'EMI Holder',
                    Bank_Account_No__c = '123456789',
                    Mandate_Status__c = 'Active'
                ));
            }

            if (nupayRtMap.containsKey('Register SPDC')) {
                mandates.add(new Nupay_Response__c(
                    Opportunity__c = opp.Id,
                    RecordTypeId = nupayRtMap.get('Register SPDC').getRecordTypeId(),
                    Account_Holder_Name__c = 'SPDC Holder',
                    Bank_Account_No__c = '987654321',
                    Mandate_Status__c = 'Active'
                ));
            }

            if (!mandates.isEmpty()) {
                insert mandates;
            }
        }
    }

    /**
     * Helper method to dynamically generate a valid Checklist JSON payload 
     * exactly matching the active Custom Metadata in the org to prevent validation failures.
     */
    private static String generateValidChecklistJson() {
        List<UW_DM_Checklist_Item__mdt> mdtItems = [
            SELECT DeveloperName, MasterLabel, Answer_Options__c, Remarks_Required_Values__c
            FROM UW_DM_Checklist_Item__mdt
            WHERE Is_Active__c = true
        ];

        List<UWDMChecklistController.ChecklistItemWrapper> payload = new List<UWDMChecklistController.ChecklistItemWrapper>();

        for (UW_DM_Checklist_Item__mdt mdt : mdtItems) {
            UWDMChecklistController.ChecklistItemWrapper item = new UWDMChecklistController.ChecklistItemWrapper();
            item.developerName = mdt.DeveloperName;
            item.label = mdt.MasterLabel;

            // Pick the first available answer option to pass validation
            String validAns = 'Yes';
            if (String.isNotBlank(mdt.Answer_Options__c)) {
                validAns = mdt.Answer_Options__c.split(';')[0].trim();
            }
            item.selectedAnswer = validAns;
            item.remarks = 'Valid test remark'; // Provided to pass potential mandatory remarks rules
            payload.add(item);
        }

        return JSON.serialize(payload);
    }

    @isTest
    static void testGetChecklistData_Success() {
        User u = [SELECT Id FROM User WHERE Alias = 'uwtest' LIMIT 1];
        Disbursement__c disb = [SELECT Id FROM Disbursement__c LIMIT 1];

        System.runAs(u) {
            Test.startTest();
            UWDMChecklistController.ChecklistWrapper wrapper = UWDMChecklistController.getChecklistData(disb.Id);
            Test.stopTest();

            System.assertNotEquals(null, wrapper, 'Wrapper should not be null');
            System.assertEquals(disb.Id, wrapper.disbursementId, 'Disbursement ID should match');
            System.assertEquals(false, wrapper.isReadOnly, 'Checklist should not be read-only for Send to UW status');
            System.assertNotEquals(null, wrapper.items, 'Items list should be initialized');
        }
    }

    @isTest
    static void testSaveChecklist_InsertAndUpdate() {
        User u = [SELECT Id FROM User WHERE Alias = 'uwtest' LIMIT 1];
        Disbursement__c disb = [SELECT Id FROM Disbursement__c LIMIT 1];

        System.runAs(u) {
            String payloadJson = generateValidChecklistJson();

            Test.startTest();
            
            // 1. Test Insert
            UWDMChecklistController.SaveResult insertRes = UWDMChecklistController.saveChecklist(disb.Id, payloadJson);
            System.assert(insertRes.success, 'Checklist should be saved successfully on Insert');

            // 2. Validate Get retrieves the saved generated status
            UWDMChecklistController.ChecklistWrapper wrapper = UWDMChecklistController.getChecklistData(disb.Id);
            System.assertEquals(true, wrapper.alreadyGenerated, 'Generated flag should be updated to true');

            // 3. Test Update (Modifying an existing checklist record)
            UWDMChecklistController.SaveResult updateRes = UWDMChecklistController.saveChecklist(disb.Id, payloadJson);
            System.assert(updateRes.success, 'Checklist should be saved successfully on Update');
            
            Test.stopTest();

            // Assert exact database record count
            List<UW_DM_Checklist_Record__c> records = [
                SELECT Id FROM UW_DM_Checklist_Record__c WHERE Disbursement__c = :disb.Id
            ];
            System.assertEquals(1, records.size(), 'There should be exactly one Checklist Record to enforce the 1-to-1 relationship');
        }
    }

    @isTest
    static void testSaveChecklist_ValidationErrors() {
        User u = [SELECT Id FROM User WHERE Alias = 'uwtest' LIMIT 1];
        Disbursement__c disb = [SELECT Id FROM Disbursement__c LIMIT 1];

        System.runAs(u) {
            Test.startTest();

            // 1. Invalid JSON Structure
            try {
                UWDMChecklistController.saveChecklist(disb.Id, 'Malformed JSON {');
                System.assert(false, 'Expected AuraHandledException for unparseable JSON');
            } catch (AuraHandledException e) {
                System.assert(e.getMessage().contains('Could not read'), 'Expected parse error message');
            }

            // 2. Missing Items (Valid JSON array but mismatching size vs metadata)
            List<UW_DM_Checklist_Item__mdt> mdtItems = [SELECT Id FROM UW_DM_Checklist_Item__mdt WHERE Is_Active__c = true];
            if (!mdtItems.isEmpty()) {
                try {
                    UWDMChecklistController.saveChecklist(disb.Id, '[]');
                    System.assert(false, 'Expected Exception for empty items list');
                } catch (AuraHandledException e) {
                    System.assert(e.getMessage().contains('Fill the checklist'), 'Expected missing items validation message');
                }
            }

            Test.stopTest();
        }
    }

    @isTest
    static void testFrozenDisbursementStatus() {
        User u = [SELECT Id FROM User WHERE Alias = 'uwtest' LIMIT 1];
        Disbursement__c disb = [SELECT Id FROM Disbursement__c LIMIT 1];

        System.runAs(u) {
            // Update the disbursement to the Frozen status
            disb.disb_Status__c = 'Handed over customer';
            update disb;

            Test.startTest();
            
            // Getting checklist data should show readOnly = true
            UWDMChecklistController.ChecklistWrapper wrapper = UWDMChecklistController.getChecklistData(disb.Id);
            System.assertEquals(true, wrapper.isReadOnly, 'Checklist should be read-only for frozen status');

            // Attempting to save should fail due to the freeze restriction
            try {
                UWDMChecklistController.saveChecklist(disb.Id, generateValidChecklistJson());
                System.assert(false, 'Expected Exception due to frozen status block');
            } catch (AuraHandledException e) {
                System.assert(e.getMessage().contains('frozen after DM approval'), 'Expected frozen error message');
            }

            Test.stopTest();
        }
    }

    @isTest
    static void testNoAccessPermission() {
        // Create a standard user strictly without the required Custom Permission
        Profile p = [SELECT Id FROM Profile WHERE Name = 'Standard User' LIMIT 1];
        User noPermUser = new User(
            Alias = 'noperm', Email = 'noperm@testorg.com', EmailEncodingKey = 'UTF-8', 
            LastName = 'NoPerm', LanguageLocaleKey = 'en_US', LocaleSidKey = 'en_US', 
            ProfileId = p.Id, TimeZoneSidKey = 'America/Los_Angeles', 
            UserName = 'noperm' + DateTime.now().getTime() + '@testorg.com'
        );
        insert noPermUser;

        Disbursement__c disb = [SELECT Id FROM Disbursement__c LIMIT 1];

        System.runAs(noPermUser) {
            Test.startTest();
            try {
                UWDMChecklistController.getChecklistData(disb.Id);
                System.assert(false, 'Expected access denied exception');
            } catch (AuraHandledException e) {
                System.assert(e.getMessage().contains('You do not have access'), 'Expected missing custom permission error');
            }
            Test.stopTest();
        }
    }

    @isTest
    static void testInvalidDisbursementId() {
        User u = [SELECT Id FROM User WHERE Alias = 'uwtest' LIMIT 1];
        
        System.runAs(u) {
            Test.startTest();
            try {
                // Pass a fake ID
                UWDMChecklistController.getChecklistData('a00000000000000AAA'); 
                System.assert(false, 'Expected an exception for invalid record Id');
            } catch (AuraHandledException e) {
                System.assert(e.getMessage().contains('record not found or not accessible'), 'Expected not found error');
            }
            Test.stopTest();
        }
    }
}
