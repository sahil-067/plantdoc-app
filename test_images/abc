    @AuraEnabled
    public static String generateOTP(String mobileNumber, String appName,String loanNo,String otpType) {
        try {
            List<OTP_Authorization__c> otpAuth = [SELECT Id, Name, OTP__c, APP_ID__c,Request__c, OPT_Generated_Date__c, OTP_Expiration_Time__c,OTP_Used__c
                                                  FROM OTP_Authorization__c
                                                  WHERE APP_ID__c =:mobileNumber AND App_Name__c =:appName LIMIT 1];
            String rand = string.valueof(Math.abs(Crypto.getRandomInteger()));
            String otp = rand.substring(0,6);
            system.debug('Verification Code:: '+otp);
            String message = 'Dear+Customer,+With+respect+to+your+Loan+Application+no.+'+loanNo+',+please+confirm+your+acceptance+on+the+Key+Fact+Statement+(KFS)+MITC+already+reviewed+by+you.+By+confirming,+you+agree+to+the+terms+and+conditions+outlined+in+the+KFS+MITC.+Your+OTP+is:+'+otp+'+This+OTP+is+valid+for+10+minutes.+Please+use+it+to+confirm+acceptance.+India+Shelter+Finance+Corporation+Limited';
            if(otpType == 'SMS'){
                sendSMS(message, mobileNumber,'');
            }
            if(otpType == 'WhatsApp'){
                sendOTPOnWhatsapp(mobileNumber,otp,loanNo);
            }
            OTP_Authorization__c obj = new OTP_Authorization__c();
            if(!otpAuth.isEmpty()){
                obj.Id = otpAuth[0].Id;
            }
            obj.APP_ID__c = mobileNumber;
            obj.OTP__c = otp;
            obj.OPT_Generated_Date__c = System.now();
            obj.Request__c = '{"MobileNumber":'+mobileNumber+',"AppName":'+appName+'}';
            obj.App_Name__c = appName;
            obj.OTP_Used__c = false;
            upsert obj;
            return 'OK';
        }catch(Exception e) {
            System.debug('Exception::'+e.getMessage()+' '+e.getLineNumber());
            return  'Exception::'+e.getMessage()+' '+e.getLineNumber();
        }
    }
