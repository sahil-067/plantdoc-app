    // METHOD 3: Full API Callout and XML Parsing (Maximum Coverage)
    @isTest
    static void testAPI_Callout_And_XML_Parsing(){
        Test.setMock(HttpCalloutMock.class, new MockForCibilIntegration());
        
        Account acc = [SELECT Id, FirstName, LastName, Date_Of_Birth__pc, Sex__pc, Mobile__pc, 
                       Pan_Card_No__pc, Passport_No__pc, Voter_Card__pc, Drv_Licn__pc, 
                       Ration_Card__pc, Aadhar_Card__pc, Address_Line_1__pc, Address_Line_2__pc, 
                       City__pc, State_Code__c, Pin_Code__pc, PersonEmail, Generate_Cibil_Flag__c 
                       FROM Account LIMIT 1];
                       
        Opportunity opp = [Select Id from Opportunity LIMIT 1];
        Customer__c cus = [Select Id, Customer_Status__c, LoanAppID__c from Customer__c LIMIT 1];
        cus.LoanAppID__c = opp.Id;
        
        Map<Id, Customer__c> oldMap = new Map<Id, Customer__c>();
        Customer__c oldCus = cus.clone(true, false, false, false);
        oldCus.Customer_Status__c = 'Pending';
        oldMap.put(oldCus.Id, oldCus);
        cus.Customer_Status__c = 'Approved';
        
        Test.startTest();
        // 1. Triggers standard logic
        CIBILIntegrationTriggerHelper.generateCIBILFromCustomer(new List<Customer__c>{cus}, oldMap);
        
        // 2. Direct hit to generateCIBILNew to force Mock response and XML parsing
        try {
            CIBILIntegrationTriggerHelper.generateCIBILNew(JSON.serialize(acc), 200000);
        } catch (Exception e) {
            System.debug('Exception in generateCIBILNew: ' + e.getMessage());
        }
        
        // 3. Fallback queue execution logic from original test class
        try { system.enqueueJob(new CibiliIntegartionQueue(JSON.serialize(acc), 2000)); } catch(Exception e){}
        try { CibilUploadDocumentByTriggerQueue.uploadDocumentMethod(opp.Id,'5570439',acc.Id); } catch(Exception e){}
        Test.stopTest();
    }
    
    // METHOD 4: Isolate Name/DOB Validation (Prevents Duplicate ID Error)
    @isTest
    static void testValidation_NameAndAge(){
        Account acc = [SELECT Id, FirstName, LastName, Date_Of_Birth__pc, Sex__pc, Mobile__pc, Pan_Card_No__pc, Passport_No__pc, Voter_Card__pc, Drv_Licn__pc, Ration_Card__pc, Aadhar_Card__pc, Address_Line_1__pc, Address_Line_2__pc, City__pc, State_Code__c, Pin_Code__pc FROM Account LIMIT 1];
        
        Test.startTest();
        
        // Break 1: Short Name
        Account badAcc1 = acc.clone(true, false, false, false);
        badAcc1.FirstName = 'A';
        badAcc1.LastName = 'B';
        try { CIBILIntegrationTriggerHelper.generateCIBILNew(JSON.serialize(badAcc1), 2000); } catch(Exception e){}
        
        // Break 2: Age
        Account badAcc2 = acc.clone(true, false, false, false);
        badAcc2.Date_Of_Birth__pc = Date.today().addYears(-10);
        try { CIBILIntegrationTriggerHelper.generateCIBILNew(JSON.serialize(badAcc2), 2000); } catch(Exception e){}
        
        Test.stopTest();
    }
    
