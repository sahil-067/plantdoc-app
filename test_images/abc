    /*
     * Type-safe helpers for fields whose type (Picklist / Boolean / Number / Date / String)
     * may vary across orgs.
     */
    private static void putTypedValueIfCreateable(
        SObject recordValue,
        String fieldApiName,
        String textVal,
        Decimal numVal,
        Date dateVal
    ) {
        Map<String, Schema.SObjectField> fields =
            recordValue.getSObjectType().getDescribe().fields.getMap();
        if (!fields.containsKey(fieldApiName)) {
            return;
        }
        Schema.DescribeFieldResult d = fields.get(fieldApiName).getDescribe();
        if (!d.isCreateable()) {
            return;
        }
        assignByDisplayType(recordValue, fieldApiName, d, textVal, numVal, dateVal);
    }

    private static void putTypedValueIfUpdateable(
        SObject recordValue,
        String fieldApiName,
        String textVal,
        Decimal numVal,
        Date dateVal
    ) {
        Map<String, Schema.SObjectField> fields =
            recordValue.getSObjectType().getDescribe().fields.getMap();
        if (!fields.containsKey(fieldApiName)) {
            return;
        }
        Schema.DescribeFieldResult d = fields.get(fieldApiName).getDescribe();
        if (!d.isUpdateable()) {
            return;
        }
        assignByDisplayType(recordValue, fieldApiName, d, textVal, numVal, dateVal);
    }

    private static void assignByDisplayType(
        SObject recordValue,
        String fieldApiName,
        Schema.DescribeFieldResult d,
        String textVal,
        Decimal numVal,
        Date dateVal
    ) {
        Schema.DisplayType t = d.getType();
        if (t == Schema.DisplayType.Picklist || t == Schema.DisplayType.MultiPicklist) {
            for (Schema.PicklistEntry pe : d.getPicklistValues()) {
                if (pe.isActive()) {
                    recordValue.put(fieldApiName, pe.getValue());
                    return;
                }
            }
        } else if (t == Schema.DisplayType.Boolean) {
            recordValue.put(fieldApiName, true);
        } else if (t == Schema.DisplayType.Date && dateVal != null) {
            recordValue.put(fieldApiName, dateVal);
        } else if (t == Schema.DisplayType.DateTime && dateVal != null) {
            recordValue.put(fieldApiName, Datetime.newInstance(dateVal, Time.newInstance(10, 0, 0, 0)));
        } else if (
            (t == Schema.DisplayType.Double ||
             t == Schema.DisplayType.Currency ||
             t == Schema.DisplayType.Percent) &&
            numVal != null
        ) {
            recordValue.put(fieldApiName, numVal);
        } else if (t == Schema.DisplayType.Integer && numVal != null) {
            recordValue.put(fieldApiName, numVal.intValue());
        } else if (textVal != null) {
            recordValue.put(fieldApiName, textVal);
        }
    }
