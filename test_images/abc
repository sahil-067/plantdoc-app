    // ═════════════════════════════════════════════════════════════
    //  TEST DATA SETUP
    // ═════════════════════════════════════════════════════════════
    @testSetup
    static void setupTestData() {
        // 1. Setup Profiles and Users
        Profile p = [SELECT Id FROM Profile WHERE Name = 'Standard User' OR Name = 'System Administrator' LIMIT 1];
        
        // User with Department (To test the parseList helper comma/semicolon split)
        User u1 = new User(
            Alias = 'vcm1', Email = 'verifier1@testorg.com',
            EmailEncodingKey = 'UTF-8', LastName = 'Testing Verifier One', LanguageLocaleKey = 'en_US',
            LocaleSidKey = 'en_US', ProfileId = p.Id,
            TimeZoneSidKey = 'America/Los_Angeles', UserName = 'verifier1_' + DateTime.now().getTime() + '@testorg.com',
            Title = 'Senior Verifier', Department = 'North,West;South', IsActive = true
        );
        
        // User without Department and single word name (To test initials helper and blank Department)
        User u2 = new User(
            Alias = 'vcm2', Email = 'verifier2@testorg.com',
            EmailEncodingKey = 'UTF-8', LastName = 'Two', LanguageLocaleKey = 'en_US',
            LocaleSidKey = 'en_US', ProfileId = p.Id,
            TimeZoneSidKey = 'America/Los_Angeles', UserName = 'verifier2_' + DateTime.now().getTime() + '@testorg.com',
            Title = 'Verifier', IsActive = true
        );
        insert new List<User>{u1, u2};
            
        // 2. Setup Group & Group Members for VCM_Auto_Allocate
        Group grp = new Group(Name = 'VCM Auto Allocate', DeveloperName = 'VCM_Auto_Allocate', Type = 'Regular');
        insert grp;
        
        GroupMember gm1 = new GroupMember(GroupId = grp.Id, UserOrGroupId = u1.Id);
        GroupMember gm2 = new GroupMember(GroupId = grp.Id, UserOrGroupId = u2.Id);
        insert new List<GroupMember>{gm1, gm2};
            
        // 3. Setup Account
        Account acc = new Account(
            Name = 'Test Applicant',
            Designation_Occupation__c = 'Salaried',
            Bureau_Flag__c = true,
            EKYC_Completed__c = 'Yes'
        );
        insert acc;
        
        // 4. Setup Customer__c (Household / VRM Case)
        Customer__c cust = new Customer__c(
            Name = 'Test Customer',
            Case_Oringination_System__c = 'VRM',
            Assigned_VCM__c = u1.Id,
            VCM_Status__c = 'Pending'
        );
        insert cust;
        
        // 5. Setup Opportunity
        Opportunity opp = new Opportunity(
            Name = 'Test Loan',
            AccountId = acc.Id,
            StageName = 'Prospecting',
            CloseDate = Date.today().addDays(30),
            LM_Loan_Status__c = 'In process',
            Login_Date__c = Date.today(),
            Household__c = cust.Id,
            Loan_Amount_Applied__c = 2500000,
            Purpose_of_loan__c = 'Home Purchase',
            Risk_Weight__c = 45,
            LTV__c = 80,
            BM_PD_Done__c = true
        );
        insert opp;
        
        // Link Customer to Opportunity to fulfill the nested subquery requirement: 
        // "Id IN (SELECT LoanAppID__c FROM Customer__c ...)"
        cust.LoanAppID__c = opp.Id;
        update cust;
    }
    
    // ═════════════════════════════════════════════════════════════
    //  TEST METHODS
    // ═════════════════════════════════════════════════════════════

    @isTest
    static void testGetCasesForDashboard() {
        Test.startTest();
        String jsonResult = VlmDashboardController.getCasesForDashboard();
        Test.stopTest();
        
        System.assertNotEquals(null, jsonResult, 'JSON Result should not be null');
        List<VlmDashboardController.CaseRow> cases = (List<VlmDashboardController.CaseRow>) JSON.deserialize(jsonResult, List<VlmDashboardController.CaseRow>.class);
        
        System.assert(!cases.isEmpty(), 'Dashboard should return at least one case record');
        VlmDashboardController.CaseRow firstCase = cases[0];
        
        System.assertEquals('Test Loan', firstCase.loanNumber, 'Loan name should match');
        System.assertEquals(2500000, firstCase.amount, 'Applied amount should match');
        System.assertEquals('Test Applicant', firstCase.applicantName, 'Account name should match');
        System.assertEquals('PENDING', firstCase.status, 'Status should be Pending based on VCM status mapping');
    }
    
    @isTest
    static void testGetCasesForDashboard_StatusVariations() {
        // This test modifies setup data to test different ternary branches & private status normalizer maps
        Opportunity opp = [SELECT Id, Household__c FROM Opportunity LIMIT 1];
        Customer__c cust = [SELECT Id, VCM_Status__c, First_Login_Approval_Date__c FROM Customer__c WHERE Id = :opp.Household__c LIMIT 1];
        
        // Test 1: First_Login_Approval_Date__c != null triggers "COMPLETED"
        cust.First_Login_Approval_Date__c = DateTime.now();
        update cust;
        String jsonResult1 = VlmDashboardController.getCasesForDashboard();
        System.assert(jsonResult1.contains('COMPLETED'), 'Status should normalize to COMPLETED if final approval date exists');
        
        // Test 2: Blank VCM_Status relies on normaliseStatus(Opportunity.StageName)
        cust.First_Login_Approval_Date__c = null;
        cust.VCM_Status__c = null;
        update cust;
        
        opp.StageName = 'IN_REVIEW';
        update opp;
        
        String jsonResult2 = VlmDashboardController.getCasesForDashboard();
        System.assert(jsonResult2.contains('IN_REVIEW'), 'Status should normalize based on Opp StageName when VCM status is blank');
    }
    
    @isTest
    static void testAssignVerifier() {
        Customer__c cust = [SELECT Id FROM Customer__c LIMIT 1];
        User u2 = [SELECT Id FROM User WHERE Alias = 'vcm2' LIMIT 1];
        
        Test.startTest();
        VlmDashboardController.assignVerifier(cust.Id, u2.Id, true, 'Allocated');
        Test.stopTest();
        
        Customer__c updatedCust = [SELECT Assigned_VCM__c, Case_Escalated__c, VCM_Status__c FROM Customer__c WHERE Id = :cust.Id];
        
        System.assertEquals(u2.Id, updatedCust.Assigned_VCM__c, 'VCM User assignment failed');
        System.assertEquals(true, updatedCust.Case_Escalated__c, 'Escalation flag was not updated');
        System.assertEquals('Allocated', updatedCust.VCM_Status__c, 'VCM Status was not updated');
    }
    
    @isTest
    static void testAssignVerifier_Exception() {
        Test.startTest();
        try {
            // Passing a dummy/invalid ID forces a DML update exception, triggering the catch block
            VlmDashboardController.assignVerifier('001000000000000', null, false, null);
            System.assert(false, 'Expected an AuraHandledException to be thrown');
        } catch (AuraHandledException e) {
            System.assert(e.getMessage().contains('assignVerifier'), 'Exception message should reference the method name');
        }
        Test.stopTest();
    }
    
    @isTest
    static void testGetVerifiersForAlloc() {
        Test.startTest();
        String jsonResult = VlmDashboardController.getVerifiersForAlloc();
        Test.stopTest();
        
        System.assertNotEquals(null, jsonResult, 'Result should not be null');
        List<VlmDashboardController.VerifierRow> verifiers = (List<VlmDashboardController.VerifierRow>) JSON.deserialize(jsonResult, List<VlmDashboardController.VerifierRow>.class);
        
        System.assert(verifiers.size() >= 2, 'Should fetch the users added to the VCM_Auto_Allocate group');
        
        Boolean foundUser1 = false;
        Boolean foundUser2 = false;
        
        for (VlmDashboardController.VerifierRow v : verifiers) {
            if (v.name.contains('Testing Verifier One')) {
                foundUser1 = true;
                // Verifies private method initials()
                System.assertEquals('TO', v.initials, 'Initials should combine first letter of First and Last Name');
                // Verifies private method parseList()
                System.assertEquals(3, v.regions.size(), 'Department string should be split into 3 regions (North, West, South)');
            }
            if (v.name.contains('Two')) {
                foundUser2 = true;
                System.assertEquals('T', v.initials, 'Single name should result in one-letter initial');
            }
        }
        
        System.assert(foundUser1 && foundUser2, 'Expected verifiers were not returned by the method');
    }
    
    @isTest
    static void testUnusedInnerClasses() {
        // The AllocPreview wrapper classes are declared in the controller but not instantiated in its methods.
        // Explicitly initializing them here ensures 100% lines coverage across the entire class file.
        Test.startTest();
        
        VlmDashboardController.AllocPreview preview = new VlmDashboardController.AllocPreview();
        preview.total = 5;
        preview.rows = new List<VlmDashboardController.AllocPreviewRow>();
        
        VlmDashboardController.AllocPreviewRow row = new VlmDashboardController.AllocPreviewRow();
        row.verifierId = '005000000000000';
        row.verifierName = 'Test Verifier Name';
        row.caseIds = new List<Id>{'006000000000000'};
        row.caseCount = 1;
        
        preview.rows.add(row);
        
        System.assertEquals(5, preview.total, 'AllocPreview total should be set');
        System.assertEquals(1, preview.rows.size(), 'AllocPreview should contain 1 row');
        System.assertEquals('Test Verifier Name', preview.rows[0].verifierName, 'Row variables should be accessible');
        
        Test.stopTest();
    }
}
