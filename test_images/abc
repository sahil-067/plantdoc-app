    private static void createBouncedCollections(List<Id> oppIds) {
        Schema.SObjectType collectionType;
        String oppLookupField;

        for (Schema.ChildRelationship cr : Opportunity.SObjectType.getDescribe().getChildRelationships()) {
            Schema.DescribeSObjectResult childDesc = cr.getChildSObject().getDescribe();
            if (childDesc.getLabel() == 'Collection' || childDesc.getName().equalsIgnoreCase('Collection__c')) {
                collectionType = cr.getChildSObject();
                oppLookupField = cr.getField().getDescribe().getName();
                break;
            }
        }

        if (collectionType == null || String.isBlank(oppLookupField)) {
            return;
        }

        Map<String, Schema.SObjectField> fieldMap = collectionType.getDescribe().fields.getMap();
        String dateField, statusField, natureField, remarksField;
        Boolean isDateTime = false;

        for (Schema.SObjectField f : fieldMap.values()) {
            Schema.DescribeFieldResult dfr = f.getDescribe();
            if (!dfr.isCreateable()) {
                continue;
            }
            String lbl = dfr.getLabel();
            if (lbl.equalsIgnoreCase('Date of Collection')) {
                dateField = dfr.getName();
                isDateTime = (dfr.getType() == Schema.DisplayType.DATETIME);
            } else if (lbl.equalsIgnoreCase('Status')) {
                statusField = dfr.getName();
            } else if (lbl.equalsIgnoreCase('Nature of collection')) {
                natureField = dfr.getName();
            } else if (lbl.equalsIgnoreCase('Cancel Remarks New')) {
                remarksField = dfr.getName();
            }
        }

        List<Date> targetDates = new List<Date>{
            Date.newInstance(2026, 10, 15),
            Date.today().toStartOfMonth().addDays(5)
        };

        List<SObject> collectionsToInsert = new List<SObject>();
        for (Id oppId : oppIds) {
            for (Date d : targetDates) {
                SObject col = collectionType.newSObject();
                col.put(oppLookupField, oppId);
                if (dateField != null) {
                    col.put(
                        dateField,
                        isDateTime ? (Object) DateTime.newInstance(d, Time.newInstance(12, 0, 0, 0)) : (Object) d
                    );
                }
                if (statusField != null) col.put(statusField, 'Bounced');
                if (natureField != null) col.put(natureField, 'Emi/Advances/Part Payment');
                if (remarksField != null) col.put(remarksField, 'Insufficient Fund');
                collectionsToInsert.add(col);
            }
        }

        if (!collectionsToInsert.isEmpty()) {
            insert collectionsToInsert;
        }
    }

    // =========================================================================
    // Helpers
    // =========================================================================
    private static RestResponse invokeDoPost(String jsonBody) {
        RestRequest req = new RestRequest();
        req.requestURI = '/services/apexrest/CallBotCollection/';
        req.httpMethod = 'POST';
        req.requestBody = Blob.valueOf(jsonBody != null ? jsonBody : '');

        RestResponse res = new RestResponse();
        RestContext.request = req;
        RestContext.response = res;

        CallBotCollectionWebhookService.doPost();
        return RestContext.response;
    }

    private static RestResponse invokeDoPost(CallBotCollectionWebhookService.CallWebhookWrapper wrapper) {
        return invokeDoPost(JSON.serialize(wrapper, true));
    }

    private static String getLoanNumberByName(String oppName) {
        return [SELECT Loan_Number__c FROM Opportunity WHERE Name = :oppName LIMIT 1].Loan_Number__c;
    }

