trigger LeadTrigger on Lead (after insert) {
    if (Trigger.isAfter && Trigger.isInsert) {
        Set<Id> cscLeadIds = new Set<Id>();

        for (Lead ld : Trigger.new) {
            Boolean isCscSource = (ld.LeadSource != null && ld.LeadSource.equalsIgnoreCase('CSC')) ||
                                  (ld.How_did_you_come_to_know_about_us__c != null && ld.How_did_you_come_to_know_about_us__c.equalsIgnoreCase('CSC'));
            
            Boolean isOpenStatus = ld.Status != null && ld.Status.containsIgnoreCase('Open');
            
            Boolean hasPhone = String.isNotBlank(ld.Lead_Phone_Number_1__c) || 
                               String.isNotBlank(ld.MobilePhone) || 
                               String.isNotBlank(ld.Phone);

            System.debug('CSC Trigger Check -> isCscSource: ' + isCscSource + ', isOpenStatus: ' + isOpenStatus + ', hasPhone: ' + hasPhone);

            if (isCscSource && isOpenStatus && hasPhone) {
                cscLeadIds.add(ld.Id);
            }
        }

        if (!cscLeadIds.isEmpty()) {
            System.enqueueJob(new SetuLeadWhatsAppQueueable(cscLeadIds));
        }
    }
}
