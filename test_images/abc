global class ForeclosureSMSBatch implements Database.Batchable<sObject>, Database.AllowsCallouts {
    
    global Database.QueryLocator start(Database.BatchableContext BC) {
        // Query only open leads that hit the exact ageing thresholds
        String query = 'SELECT Id, MobilePhone, Ageing__c FROM Lead ' +
                       'WHERE Status != \'Closed\' AND Ageing__c IN (1, 4, 7, 10, 13, 16, 19, 21) AND MobilePhone != null';
        return Database.getQueryLocator(query);
    }

    global void execute(Database.BatchableContext BC, List<Lead> scope) {
        List<SmsRequest> smsPayloads = new List<SmsRequest>();

        for (Lead l : scope) {
            String templateId = getDltTemplateId(Integer.valueOf(l.Ageing__c));
            
            if (templateId != null) {
                smsPayloads.add(new SmsRequest(l.MobilePhone, templateId));
            }
        }

        if (!smsPayloads.isEmpty()) {
            sendSms(smsPayloads);
        }
    }

    global void finish(Database.BatchableContext BC) {
        // Execute any post-batch logic, like emailing admin on completion
    }

    // Maps the day threshold to the DLT Template IDs provided in the email thread
    private String getDltTemplateId(Integer ageingDays) {
        switch on ageingDays {
            when 1 { return '1077217930046105549'; } // Template-1
            when 4 { return '1077471770046203926'; } // Template-2
            when 7 { return '1077595490046192356'; } // Template-3
            when 10 { return '1077284850050929992'; } // Template-4
            when 13 { return '1077441020046153887'; } // Template-5
            when 16 { return '1077303510036497254'; } // Template-6
            when 19 { return '1077325840046148293'; } // Template-7
            when 21 { return '1077511520046174433'; } // Template-8
            when else { return null; }
        }
    }

    // REST Wrapper class for the payload
    private class SmsRequest {
        String phone;
        String templateId;
        
        SmsRequest(String phone, String templateId) {
            this.phone = phone;
            this.templateId = templateId;
        }
    }

