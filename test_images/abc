global class ForeclosureSMSScheduler implements Schedulable {
    global void execute(SchedulableContext SC) {
        ForeclosureSMSBatch batch = new ForeclosureSMSBatch();
        // Enforcing a batch size of 50 to safely handle API callouts
        Database.executeBatch(batch, 50); 
    }
}






@isTest
private class ForeclosureSMSBatchTest {
    
    @testSetup
    static void setupTestData() {
        List<Lead> testLeads = new List<Lead>();
        // Insert leads mapping to different thresholds
        testLeads.add(new Lead(LastName='Test 1', Company='Comp1', Status='Open', MobilePhone='9000000001', Ageing__c=1));
        testLeads.add(new Lead(LastName='Test 4', Company='Comp4', Status='Open', MobilePhone='9000000004', Ageing__c=4));
        testLeads.add(new Lead(LastName='Test Closed', Company='CompClosed', Status='Closed', MobilePhone='9000000000', Ageing__c=13));
        insert testLeads;
    }

    @isTest
    static void testBatchExecution() {
        Test.setMock(HttpCalloutMock.class, new SMSCalloutMock());

        Test.startTest();
        Database.executeBatch(new ForeclosureSMSBatch(), 200);
        Test.stopTest();

        // The closed lead should be ignored. Assert against standard limits or updated fields if applicable.
        System.assertEquals(2, [SELECT count() FROM Lead WHERE Status != 'Closed'], 'Only open leads should be processed');
    }

    @isTest
    static void testSchedulerExecution() {
        Test.startTest();
        String cronExpression = '0 0 10 * * ?'; 
        String jobId = System.schedule('Test Foreclosure SMS 10 AM', cronExpression, new ForeclosureSMSScheduler());
        Test.stopTest();

        System.assertNotEquals(null, jobId, 'The scheduled job ID should not be null');
    }

    // Mock response for the SMS API
    private class SMSCalloutMock implements HttpCalloutMock {
