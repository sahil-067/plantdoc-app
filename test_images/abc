@isTest
private class SubseqLoanServiceWrapper_Test {
    
    @isTest
    static void testWrapperInstantiation() {
        // 1. Instantiate the main wrapper
        SubseqLoanServiceWrapper wrapper = new SubseqLoanServiceWrapper();
        wrapper.curtailmentFlag = 'Y';
        wrapper.loanAccountNumber = 'HLHLSVLONS000005175520';
        wrapper.scheduleProvided = 0;
        
        // 2. Instantiate requestHeader and userDetail
        wrapper.requestHeader = new SubseqLoanServiceWrapper.requestHeader();
        wrapper.requestHeader.tenantId = '505';
        
        wrapper.requestHeader.userDetail = new SubseqLoanServiceWrapper.userDetail();
        wrapper.requestHeader.userDetail.branchId = 5000042;
        wrapper.requestHeader.userDetail.userCode = 'krishna';
        
        // 3. Instantiate loanDisbursalStatus
        wrapper.loanDisbursalStatus = new SubseqLoanServiceWrapper.loanDisbursalStatus();
        wrapper.loanDisbursalStatus.key = '2';
        wrapper.loanDisbursalStatus.value = 'String';
        
        // 4. Instantiate inner key-value pair classes
        SubseqLoanServiceWrapper.loanDisbursalType disbursalType = new SubseqLoanServiceWrapper.loanDisbursalType();
        disbursalType.key = 'Normal';
        disbursalType.value = 'String';
        
        SubseqLoanServiceWrapper.moratoriumTreatmentType moratType = new SubseqLoanServiceWrapper.moratoriumTreatmentType();
        moratType.key = 'Standard';
        moratType.value = 'String';
        
        SubseqLoanServiceWrapper.accountType accType = new SubseqLoanServiceWrapper.accountType();
        accType.key = 'SavingAccount';
        accType.value = 'String';
        
        SubseqLoanServiceWrapper.paymentMode payMode = new SubseqLoanServiceWrapper.paymentMode();
        payMode.key = 'ELECTRONIC_FUND_TRANSFER';
        payMode.value = 'String';
        
        SubseqLoanServiceWrapper.subPaymentMode subPayMode = new SubseqLoanServiceWrapper.subPaymentMode();
        subPayMode.key = 'NEFT';
        subPayMode.value = 'String';
        
        SubseqLoanServiceWrapper.businessPartner bp = new SubseqLoanServiceWrapper.businessPartner();
        bp.key = '2890';
        bp.value = 'Long';
        
        // Even empty classes need to be instantiated for coverage
        SubseqLoanServiceWrapper.printingBranch pBranch = new SubseqLoanServiceWrapper.printingBranch();
        
        // 5. Instantiate disbursalPaymentDetail
        SubseqLoanServiceWrapper.disbursalPaymentDetail paymentDetail = new SubseqLoanServiceWrapper.disbursalPaymentDetail();
        paymentDetail.accountByName = 'John Doe';
        paymentDetail.accountNumber = '26910100000474';
        paymentDetail.accountType = accType;
        paymentDetail.bankIdentificationCode = 'YESB0000172';
        paymentDetail.bankIdentificationType = 'IFSC_CODE_KEY';
        paymentDetail.instrumentDate = '07/07/2025';
        paymentDetail.instrumentNumber = 552527;
        paymentDetail.paymentAmount = 208098;
        paymentDetail.paymentMode = payMode;
        paymentDetail.payoutbankId = 5000080;
        paymentDetail.printingBranch = pBranch;
        paymentDetail.sourcePaymentReferenceNumber = 552527;
        paymentDetail.subPaymentMode = subPayMode;
        
        // 6. Instantiate disbursalBreakUpDetail
        SubseqLoanServiceWrapper.disbursalBreakUpDetail breakUp = new SubseqLoanServiceWrapper.disbursalBreakUpDetail();
        breakUp.disbursalAmount = 211300;
        breakUp.disbursalChargeAmount = 3202;
        breakUp.duesAdjustmentAmount = 0;
        breakUp.netDisbursalAmount = 208098;
        breakUp.disbursalPaymentDetail = new List<SubseqLoanServiceWrapper.disbursalPaymentDetail>{ paymentDetail };
        
        // 7. Instantiate disbursalChargeDetail
        SubseqLoanServiceWrapper.disbursalChargeDetail charge = new SubseqLoanServiceWrapper.disbursalChargeDetail();
        charge.adjustChargeAtDisbursement = 'Y';
        charge.applicableChargeAmount = 2494.0;
        charge.businessPartner = bp;
        charge.chargeAmount = 2494.0;
        charge.chargeId = 5002300;
        charge.chargeReferenceId = 10411969;
        charge.dueDate = '07/07/2025';
        charge.effectiveChargeAmount = 2494.0;
        charge.originalChargeAmount = 2494;
        
        // 8. Instantiate disbursalDetails and attach everything
        SubseqLoanServiceWrapper.disbursalDetails detail = new SubseqLoanServiceWrapper.disbursalDetails();
        detail.disbursalAmount = 211300;
        detail.disbursalAuthorName = 'System';
        detail.disbursalBreakUpDetail = new List<SubseqLoanServiceWrapper.disbursalBreakUpDetail>{ breakUp };
        detail.disbursalChargeDetail = new List<SubseqLoanServiceWrapper.disbursalChargeDetail>{ charge };
        detail.disbursalDate = '07/07/2025';
        detail.disbursalNo = 2;
        detail.disbursalReference = 359548;
        detail.disbursalRemarks = 'Second';
        detail.interestStartDate = '07/07/2025';
        detail.loanDisbursalType = disbursalType;
        detail.moratoriumPeriod = 0;
        detail.moratoriumTreatmentType = moratType;
        detail.principalRecoveryFlag = 'Y';
        
        wrapper.disbursalDetails = new List<SubseqLoanServiceWrapper.disbursalDetails>{ detail };
        
        // Assertions
        System.assertEquals('HLHLSVLONS000005175520', wrapper.loanAccountNumber, 'Loan account number should match');
        System.assertEquals('505', wrapper.requestHeader.tenantId, 'Tenant ID should match');
        System.assertEquals(1, wrapper.disbursalDetails.size(), 'Disbursal details list should contain 1 item');
    }
    
    @isTest
    static void testJSONDeserialization() {
        // A JSON string mapped to the class structure to test JSON.deserialize
        String jsonString = '{' +
            '\"curtailmentFlag\": \"Y\",' +
            '\"loanAccountNumber\": \"HLHLSVLONS000005175520\",' +
            '\"scheduleProvided\": 0,' +
            '\"requestHeader\": {' +
                '\"tenantId\": \"505\",' +
                '\"userDetail\": {' +
                    '\"branchId\": 5000042,' +
                    '\"userCode\": \"krishna\"' +
                '}' +
            '},' +
            '\"loanDisbursalStatus\": {' +
                '\"key\": \"2\",' +
                '\"value\": \"String\"' +
            '},' +
            '\"disbursalDetails\": [' +
                '{' +
                    '\"disbursalAmount\": 211300,' +
                    '\"disbursalNo\": 2,' +
                    '\"loanDisbursalType\": {' +
                        '\"key\": \"Normal\",' +
                        '\"value\": \"String\"' +
                    '},' +
                    '\"disbursalBreakUpDetail\": [' +
                        '{' +
                            '\"netDisbursalAmount\": 208098,' +
                            '\"disbursalPaymentDetail\": [' +
                                '{' +
                                    '\"accountNumber\": \"26910100000474\",' +
                                    '\"accountType\": {' +
                                        '\"key\": \"SavingAccount\",' +
                                        '\"value\": \"String\"' +
                                    '}' +
                                '}' +
                            ']' +
                        '}' +
                    '],' +
                    '\"disbursalChargeDetail\": [' +
                        '{' +
                            '\"chargeAmount\": 2494.0,' +
                            '\"businessPartner\": {' +
                                '\"key\": \"2890\",' +
                                '\"value\": \"Long\"' +
                            '}' +
                        '}' +
                    ']' +
                '}' +
            ']' +
        '}';
        
        SubseqLoanServiceWrapper parsedResult = (SubseqLoanServiceWrapper) JSON.deserialize(jsonString, SubseqLoanServiceWrapper.class);
        
        // Assertions to verify the JSON mapped correctly
        System.assertNotEquals(null, parsedResult, 'Parsed result should not be null');
        System.assertEquals('HLHLSVLONS000005175520', parsedResult.loanAccountNumber, 'Loan account number should parse correctly');
        System.assertEquals('krishna', parsedResult.requestHeader.userDetail.userCode, 'User code should parse correctly');
        System.assertEquals(211300, parsedResult.disbursalDetails[0].disbursalAmount, 'Disbursal amount should parse correctly');
        System.assertEquals('SavingAccount', parsedResult.disbursalDetails[0].disbursalBreakUpDetail[0].disbursalPaymentDetail[0].accountType.key, 'Deeply nested account type key should parse correctly');
    }
}
