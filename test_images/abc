                    '"messageArguments": ["11014697"],' +
                    '"type": "INFO",' +
                    '"isParent": true,' +
                    '"value": "msg.00003359 : Transaction processed successfully with Receipt # 11014697"' +
                '}]' +
            '}' +
        '}';
    }

