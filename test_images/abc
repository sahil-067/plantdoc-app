    private static Id createValidLookupRecordForField(
        Schema.SObjectType sourceObjectType,
        String fieldApiName
    ) {
        Map<String, Schema.SObjectField> fields =
            sourceObjectType.getDescribe().fields.getMap();
        
        if (!fields.containsKey(fieldApiName)) {
            return null;
        }
        
        Schema.DescribeFieldResult fieldDescribe =
            fields.get(fieldApiName).getDescribe();
        
        List<Schema.SObjectType> referenceTypes =
            fieldDescribe.getReferenceTo();
        
        if (referenceTypes == null || referenceTypes.isEmpty()) {
            return null;
        }
        
        for (Schema.SObjectType referenceType : referenceTypes) {
            Schema.DescribeSObjectResult objectDescribe =
                referenceType.getDescribe();
            
            if (!objectDescribe.isCreateable()) {
                continue;
            }
            
            SObject lookupRecord = referenceType.newSObject();
            
            Map<String, Schema.SObjectField> lookupFields =
                objectDescribe.fields.getMap();
            
            if (
                lookupFields.containsKey('Name')
                && lookupFields.get('Name').getDescribe().isCreateable()
            ) {
                lookupRecord.put(
                    'Name',
                    'Test Lookup ' + String.valueOf(Math.mod(Math.abs(Crypto.getRandomInteger()), 100000))
                );
            }
            
            Database.SaveResult insertResult =
                Database.insert(lookupRecord, false);
            
            if (insertResult.isSuccess()) {
                return insertResult.getId();
            }
        }
        
        return null;
    }
    
    
    
