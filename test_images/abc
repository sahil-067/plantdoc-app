    return result;
}


    private static String loadLatestSavedBureauResponse(Id applicantId) {
        if (applicantId == null) {
            return null;
        }

        List<Bureau_Soft_Pull__c> rows = [
            SELECT Id,
                   Bureau_Soft_Pull_API_Response__c,
                   CreatedDate
            FROM Bureau_Soft_Pull__c
            WHERE Applicant__c = :applicantId
            ORDER BY CreatedDate DESC
            LIMIT 20
        ];

        /*
         * Bureau_Soft_Pull_API_Response__c is a Long Text Area field,
         * so it cannot be used in the SOQL WHERE clause.
         */
        for (Bureau_Soft_Pull__c row : rows) {
            if (String.isNotBlank(row.Bureau_Soft_Pull_API_Response__c)) {
                return row.Bureau_Soft_Pull_API_Response__c;
            }
        }

        return null;
    }

    private static Decimal loadInsuranceFinancedPremium(Id camId) {
        if (camId == null) {
