@IsTest
public class MicroSoftCreateAccountAPITest {

    @IsTest
    static void testMaxPossibleCoverage() {
        String fullWrapperJson = '{' +
            '"id": "12345",' +
            '"inviteRedeemUrl": "https://myapp.com/redeem",' +
            '"invitedUserDisplayName": {},' +
            '"invitedUserType": "Guest",' +
            '"invitedUserEmailAddress": "test@example.com",' +
            '"sendInvitationMessage": true,' +
            '"inviteRedirectUrl": "https://myapp.com",' +
            '"status": "PendingAcceptance",' +
            '"invitedUserMessageInfo": {' +
                '"messageLanguage": "en-US",' +
                '"customizedMessageBody": "Welcome",' +
                '"ccRecipients": [{' +
                    '"emailAddress": {' +
                        '"name": "Admin",' +
                        '"address": "admin@example.com"' +
                    '}' +
                '}]' +
            '},' +
            '"invitedUser": {' +
                '"id": "fe3184c1-4154-4833-ab07-3694ba57e0b1"' +
            '}' +
        '}';

        Test.startTest();
        // Covers all setters and getters on Wrapper + all private inner classes
        MicroSoftCreateAccountAPI.Wrapper parsedWrapper =
            (MicroSoftCreateAccountAPI.Wrapper) JSON.deserialize(
                fullWrapperJson,
                MicroSoftCreateAccountAPI.Wrapper.class
            );
        String serializedBack = JSON.serialize(parsedWrapper);

        // Covers all reachable lines in both API methods
        MicroSoftCreateAccountAPI.doPostForGetAccessToken('test@example.com', 'sId');
        MicroSoftCreateAccountAPI.doPostInvitationsAPI('mockToken', 'test@example.com', 'sId');
        Test.stopTest();

        System.assertNotEquals(null, serializedBack, 'Wrapper serialization should succeed.');
    }
}
