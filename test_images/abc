    @isTest
    static void testGetDetail_SuccessPath() {
        // Mocks a valid GET request with a matching phone number
        RestRequest req = new RestRequest();
        RestResponse res = new RestResponse();
        
        req.requestURI = '/services/apexrest/dashboardApiV1/getDetail';
        req.httpMethod = 'GET';
        // Note: Supplying the raw number. If DecryptionUtil fails during test context, 
        // you might need to supply the pre-encrypted string depending on your Decryption logic.
        req.params.put('Mobile', '9999999999'); 
        req.params.put('Source', 'TestApp');
        req.params.put('currentVersion', '1.0');
        
        RestContext.request = req;
        RestContext.response = res;
        
        Test.startTest();
        DashboardApi_V1.WrapperClass responseWrapper = DashboardApi_V1.getDetail();
        Test.stopTest();
        
        // Assertions
        System.assertNotEquals(null, responseWrapper, 'Wrapper should not be null');
        System.assertEquals('200', responseWrapper.response.resCode, 'Response Code should be 200 Success');
        System.assertEquals('success', responseWrapper.response.resMessage, 'Message should be success');
        System.assert(responseWrapper.loanList.size() > 0, 'Loan list should have records populated');
        System.assertEquals(true, responseWrapper.EaseBuzzPayment, 'EaseBuzzPayment should be true');
        System.assertEquals(true, responseWrapper.PayUPayment, 'PayUPayment should be true');
    }
    
    @isTest
