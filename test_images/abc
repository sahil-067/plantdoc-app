    @isTest
    static void testHighBaseROIAndVarianceBoost() {
        CAM__c cam = [
            SELECT Id, Branch__c, Loan_Type__c, Total_Credit_Score__c
            FROM CAM__c
            LIMIT 1
        ];

        cam.Occupation__c = 'Salaried';
        cam.Occ_2__c = 'Salaried';
        cam.Occ_3__c = 'Salaried';
        cam.Occ_4__c = 'Salaried';
        cam.Income__c = 100000;
        cam.Income_2__c = 10000;
        cam.Income_3__c = 10000;
        cam.Income_4__c = 10000;
        cam.Total_Credit_Score__c = 67;
        if (Schema.sObjectType.CAM__c.fields.CAM_Profile__c.isUpdateable()) {
            cam.put('CAM_Profile__c', 'Salaried');
        }
        update cam;

        // Re-query formula & parent fields after update so Base_Rate__c matches 100%
        cam = [
            SELECT Id, Branch__r.Branch_Category__c, Loan_Application__r.Loan_Type__c,
                   Combined_Exposure__c, Loan_Type__c
            FROM CAM__c
            WHERE Id = :cam.Id
        ];

        // 1. Guarantee LAP_AGorCommercial_ROI_Variance__c matches (+2 lines)
        insert new LAP_AGorCommercial_ROI_Variance__c(
            Name = 'BoostMatch',
            Condition_1__c = cam.Loan_Type__c,
            Scorings__c = '1'
        );

        delete [SELECT Id FROM Base_Rate__c];

        // 2. Match Base_Rate__c with Base_ROI__c = 16 -> hits ListBase > 0 + else block (+9 lines)
        Decimal exp = cam.Combined_Exposure__c != null ? cam.Combined_Exposure__c : 0;
        insert new Base_Rate__c(
            Base_ROI__c = 16,
            Branch_Category_New__c = cam.Branch__r.Branch_Category__c,
            Branch_Category__c = cam.Branch__r.Branch_Category__c,
            Condition1__c = exp - 10,
            Condition_2__c = exp + 10,
            Combined_Exposure_Start__c = '0 Lakhs',
            Combined_Exposure_End__c = '100 Lakhs',
            Loan_Type__c = cam.Loan_Application__r.Loan_Type__c,
            Profile__c = 'Salaried'
        );

        Test.startTest();
        PageReference pageRef = Page.GenerateROI;
        pageRef.getParameters().put('id', String.valueOf(cam.Id));
        Test.setCurrentPage(pageRef);

        GenerateROI ctrlHigh = new GenerateROI(new ApexPages.StandardController(cam));
        ctrlHigh.generate();

        // 3. Re-run with Base_ROI__c = 10 so if(Baseroi < 15.00) + ListLap match execute
        Base_Rate__c br = [SELECT Id, Base_ROI__c FROM Base_Rate__c LIMIT 1];
        br.Base_ROI__c = 10;
        update br;

        GenerateROI ctrlLow = new GenerateROI(new ApexPages.StandardController(cam));
        ctrlLow.generate();
        Test.stopTest();
    }
