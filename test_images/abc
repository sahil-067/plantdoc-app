@AuraEnabled
public static void updateDispositionNotesAndStatus(
    String disposition,
    String notes,
    String leadStatus,
    Id leadId
) {
    if (leadId == null) {
        throw new AuraHandledException(
            'Retention Lead is not available to save disposition.'
        );
    }

    if (String.isBlank(leadStatus)) {
        throw new AuraHandledException(
            'Select a Lead Status before saving.'
        );
    }

    Set<String> activeLeadStatuses = new Set<String>();

    Schema.DescribeFieldResult statusFieldDescribe =
        Lead.Status.getDescribe();

    for (
        Schema.PicklistEntry statusEntry :
        statusFieldDescribe.getPicklistValues()
    ) {
        if (statusEntry.isActive()) {
            activeLeadStatuses.add(statusEntry.getValue());
        }
    }

    if (!activeLeadStatuses.contains(leadStatus)) {
        throw new AuraHandledException(
            'The selected Lead Status is not active or valid.'
        );
    }

    Lead leadToUpdate = new Lead(
        Id = leadId,
        Other_Lender_Disposition__c = disposition,
        Agent_Notes__c = notes,
        Status = leadStatus
    );

    update leadToUpdate;
}

