    private Boolean isValidOtp(String mobileNumber,String otpVerificationCode) {
        try{
            if(String.isNotBlank(mobileNumber) && String.isNotBlank(otpVerificationCode)){
                List<OTP_Authorization__c> otpAuth = [SELECT Id, Name, OTP__c, APP_ID__c,Request__c, OPT_Generated_Date__c, OTP_Expiration_Time__c,OTP_Used__c
                                                      FROM OTP_Authorization__c
                                                      WHERE APP_ID__c =:mobileNumber AND OTP__c =:otpVerificationCode AND App_Name__c = :System.label.Esign LIMIT 1];
                System.debug('otpAuth: '+otpAuth);
                if(!otpAuth.isEmpty() && System.now() <= otpAuth[0].OTP_Expiration_Time__c && otpAuth[0].OTP_Used__c == false && otpVerificationCode == otpAuth[0].OTP__c){
                    otpAuth[0].OTP_Used__c = true;
                    update otpAuth;
                    return True;
                }
            }
            return False;
        }
        catch(Exception e){
            System.debug('Exception:: '+e.getMessage()+' '+e.getLineNumber());
            return False;
        }
    }
