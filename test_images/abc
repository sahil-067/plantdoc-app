public with sharing class AttendanceTrackerMapController {
    @AuraEnabled
    public static RecordLocationWrapper getCurrentUserDetails() {
        try{
            List<User> userList = new List<User>();
            RecordLocationWrapper rlw = new RecordLocationWrapper();
            String currentUserId = UserInfo.getUserId();
            User u = [SELECT Id, Name, Profile.Name,Base_Location__c FROM User WHERE Id = :currentUserId LIMIT 1];
            rlw.baseLocation = u.Base_Location__c;
            if(u.Base_Location__c == 'Branch'){
                return AttendanceTrackerMapController.loadAttendance(currentUserId, null, false);
            }
            else{
                List<String> profileList = System.Label.AttendanceTrackerMapProfiles.split(',');
                userList = [SELECT Id, Name,Username, Designation__c FROM User  WHERE IsActive = true AND Profile.Name IN : profileList AND Base_Location__c = 'Branch' AND (Designation__c = 'RCM' OR Designation__c = 'ZCM' OR Designation__c = 'ACM') ORDER BY Name];
                rlw.userList = userList;
                rlw.isHO = true;
            }
            return rlw;
        }
        catch(Exception e){
            System.debug('Error:: '+e.getMessage()+' LineNumber: '+e.getLineNUmber());
            return null;
        }
    }
    
    @AuraEnabled(cacheable=true)
    public static List<String> getUserState(String selectedUserId) {
        System.debug('selectedUserId: '+selectedUserId);
        try{
            if(String.isNotBlank(selectedUserId)){
                Set<String> stateSet = new Set<String>();
                for(Branch__c br : [SELECT Id, Name, Branch_State__c FROM Branch__c WHERE Zonal_Collection_Manager__c =: selectedUserId OR Branch_Regional_Collection__c =: selectedUserId OR Branch_Area_Collection__c =: selectedUserId ORDER BY Name]){
                    stateSet.add(br.Branch_State__c);
                }
                return new List<String>(stateSet);
            }
            return null;
        }
        catch(Exception e){
            System.debug('Error:: '+e.getMessage()+' LineNumber: '+e.getLineNUmber());
            return null;
        }
    }
    
    @AuraEnabled
    public Static List<LocationWrapper> toggleBranchView(String selectedUserId, String selectedState, Boolean isPanIndia) {
        System.debug('selectedUserId: '+selectedUserId+' selectedBranchId: '+selectedState+ ' isPanIndia: '+isPanIndia);
        List<LocationWrapper> locationWrapperLst = new List<LocationWrapper>();
        if(isPanIndia == false && String.isBlank(selectedUserId)){
            selectedUserId = UserInfo.getUserId();
        }
        if(String.isNotBlank(selectedUserId) || isPanIndia){
            List<Branch__c> branchList = new List<Branch__c>();
            if(isPanIndia){
                branchList = [SELECT Id, Name,Branch_PinCode__c,Branch_State__c, Branch_Regional_Collection__c, Zonal_Collection_Manager__c, Geo_tag_for_Technical__Latitude__s, Geo_tag_for_Technical__Longitude__s 
                              FROM Branch__c WHERE Geo_tag_for_Technical__Latitude__s != null AND Geo_tag_for_Technical__Longitude__s != null];
            }
            else{
                branchList = [SELECT Id, Name,Branch_PinCode__c,Branch_State__c, Branch_Regional_Collection__c, Zonal_Collection_Manager__c, Geo_tag_for_Technical__Latitude__s, Geo_tag_for_Technical__Longitude__s 
                              FROM Branch__c
                              WHERE (Branch_Area_Collection__c =: selectedUserId OR Branch_Regional_Collection__c =: selectedUserId OR Zonal_Collection_Manager__c =: selectedUserId)];
            }
            for(Branch__c br : branchList){
                LocationWrapper lw = new LocationWrapper();
                if(String.isBlank(selectedState) || (br.Branch_State__c == selectedState)){
                    lw.id = br.id;
                    lw.status = 'Branch';
                    lw.latitude = br.Geo_tag_for_Technical__Latitude__s;
                    lw.longitude = br.Geo_tag_for_Technical__Longitude__s;
                    lw.title = br.Name +' | '+ br.Branch_PinCode__c;
                    locationWrapperLst.add(lw);
                }
            }
            System.debug('userBranchList: '+locationWrapperLst.size());
        }  
        return locationWrapperLst;
    }
    
    @AuraEnabled
    public static RecordLocationWrapper loadAttendance(String selectedUserId, String selectedState, Boolean isHO) {
        try {
            System.debug('selectedUserId: '+selectedUserId+' selectedBranchId: '+selectedState+ ' isHO: '+isHO);
            
            Integer activeCount = 0;
            Integer inActiveCount = 0;
            RecordLocationWrapper recordWrp = new RecordLocationWrapper();
            recordWrp.selectedUserId = selectedUserId;
            recordWrp.isHO = isHO;
               
            if((String.isNotBlank(selectedUserId) && String.isNotBlank(selectedState)) || isHO == false){
                List<Attendance__c> attList = new List<Attendance__c>();
                user u = [SELECT Id,EmployeeNumber, Name, Branch__c FROM User WHERE Id =: selectedUserId LIMIT 1];
                Id employeeRecordTypeId = Schema.SObjectType.Account.getRecordTypeInfosByName().get('ISFCL - Employee').getRecordTypeId();
                List<Account> acc = [SELECT Id, Name, RecordTypeId, branch__r.Branch_Location__Latitude__s,branch__r.Branch_Location__Longitude__s,Designation__pc  
                                     FROM Account 
                                     WHERE RecordTypeId =: employeeRecordTypeId AND Empl_Code__pc =: u.EmployeeNumber LIMIT 1];
                System.debug(acc);
                if(!acc.isEmpty()){
                    recordWrp.currentlat = acc[0].branch__r.Branch_Location__Latitude__s;
                    recordWrp.currentlong = acc[0].branch__r.Branch_Location__Longitude__s;
                }
                String recordType = Schema.sObjectType.Attendance__c.getRecordTypeInfosByName().get('iCollect').getRecordTypeId();
                if(attList.isEmpty()){
                    attList = [SELECT Id,Active__c, Name,Employee_ID__c,Account__c,Account__r.Name, Branch__c, Branch__r.Branch_State__c,Branch__r.Area_Technical_Manager__c, Current_Location__Latitude__s, Current_Location__Longitude__s,Designation__c,CreatedDate 
                               FROM Attendance__c 
                               WHERE RecordTypeId =:recordType 
                               AND Current_Location__Latitude__s != null 
                               AND Current_Location__Longitude__s != null 
                               AND (Branch__r.Branch_Area_Collection__c =: selectedUserId OR Branch__r.Branch_Regional_Collection__c =: selectedUserId OR Branch__r.Zonal_Collection_Manager__c =: selectedUserId)  
                               AND CreatedDate = TODAY 
                               AND Account__r.Resigned__pc = false 
                               AND (Account__r.Designation__pc = 'C.O' OR Account__r.Designation__pc = 'BCM-Collections')
                               AND Account__r.PersonDepartment = 'Collections' Order by CreatedDate];
                    System.debug('Q1 '+attList.Size());
                }                
                System.debug(attList.size());
                Map<Id, Attendance__c> atendanceMap = new  Map<Id, Attendance__c>();
                
                for(Attendance__c att : attList){
                    if(!atendanceMap.containsKey(att.Id)){
                        atendanceMap.put(att.Account__c, att);
                    }
                }
                System.debug(atendanceMap.size());
                List<LocationWrapper> locations = new List<LocationWrapper>();
                LocationWrapper current = new LocationWrapper();
                current.id = acc[0].id;
                current.latitude = acc[0].branch__r.Branch_Location__Latitude__s;
                current.longitude = acc[0].branch__r.Branch_Location__Longitude__s;
                current.title = acc[0].Name +' | '+ acc[0].Designation__pc;
                locations.add(current);
                for(String key : atendanceMap.keySet()){
                    DateTime gmtNow = DateTime.now();
                    //System.debug('Key '+key);
                    //System.debug('Acive '+atendanceMap.get(key).Active__c+ ' :: '+atendanceMap.get(key).Branch__c +' :: '+ selectedState);
                    LocationWrapper rec = new LocationWrapper();
                    rec.id = key;
                    rec.latitude = atendanceMap.get(key).Current_Location__Latitude__s;
                    rec.longitude = atendanceMap.get(key).Current_Location__Longitude__s;
                    rec.title = atendanceMap.get(key).Account__r.Name +' | '+ atendanceMap.get(key).Employee_ID__c;
                    rec.description = '';
                    if(atendanceMap.get(key).CreatedDate.addMinutes(45) < gmtNow){
                        if((isHO && atendanceMap.get(key).Branch__r.Branch_State__c == selectedState) || !isHO){
                            System.debug('1st If');
                            inActiveCount++;
                            rec.status = 'Inactive';
                            locations.add(rec);
                        }
                    }
                    else if(atendanceMap.get(key).Active__c == true){
                        if((isHO && atendanceMap.get(key).Branch__r.Branch_State__c == selectedState) || !isHO){
                            System.debug('2nd If');
                            activeCount++;
                            rec.status = 'Active';
                            locations.add(rec);
                        }
                    }
                    else if(atendanceMap.get(key).Active__c == false){
                        if((isHO && atendanceMap.get(key).Branch__r.Branch_State__c == selectedState) || !isHO){
                            System.debug('3rd If');
                            inActiveCount++;
                            rec.status = 'Inactive';
                            locations.add(rec);
                        }
                    }
                }
                
                recordWrp.totalInActive = inActiveCount;
                recordWrp.totalActive	= activeCount;
                recordWrp.locationWrapperList = locations;
                
                System.debug(recordWrp.locationWrapperList.size()+' recordWrp:');
            }
            return recordWrp;
            
        } catch(Exception e){
            System.debug('Error: ' + e.getMessage() + ' Line: ' + e.getLineNumber());
            return null;
        }
    }
    
