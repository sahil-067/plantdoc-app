    private static NameParts splitName(String fullName) {
        List<String> pieces = String.isBlank(fullName)
            ? new List<String>{ 'Customer' }
            : fullName.trim().split('\\s+');

        NameParts parts = new NameParts();
        parts.firstName = pieces[0];

        List<String> lastNameParts = new List<String>();

        for (Integer index = 1; index < pieces.size(); index++) {
            lastNameParts.add(pieces[index]);
        }

        parts.lastName = lastNameParts.isEmpty()
            ? 'Customer'
            : String.join(lastNameParts, ' ');

        return parts;
    }

