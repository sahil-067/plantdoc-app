    // 6. Covers trStatus = 'X' (Cancelled), empty Scheme_Master__mdt fallback,
    //    Processing Fee (incl. Service tax) branch (when DELIVERABLE_CHARGE metadata exists), and dofuture()
    @isTest
    static void testDoPostCancelledAndProcessingFee() {
        Opportunity opp = [SELECT Id FROM Opportunity LIMIT 1];
        opp.Loan_Product__c = null;
        update opp;

        Nucleus_Deposit_Bank__c chequeBank = [SELECT Id FROM Nucleus_Deposit_Bank__c WHERE BankType__c = 'Cheque' LIMIT 1];

        List<Nucleus_Receipt_For_Collection__mdt> pfCharge = [
            SELECT MasterLabel
            FROM Nucleus_Receipt_For_Collection__mdt
            WHERE MasterLabel = 'Processing Fee (incl. Service tax)'
              AND Receipt_Purpose_Type__c = 'DELIVERABLE_CHARGE'
            LIMIT 1
        ];
        String nature = pfCharge.isEmpty() ? 'Emi/Advances/Part Payment' : 'Processing Fee (incl. Service tax)';

        Collection__c col = buildCollection(
            opp.Id, chequeBank.Id, 'Cheque', 'Cancelled', 'Deposited',
            nature, System.today(), System.today(), 9999
        );
        insert col;

        Test.setMock(HttpCalloutMock.class, new ProcessReceiptMock(200, getSuccessResponseBody()));

        Test.startTest();
        ProcessReceiptService.dofuture(col.Id);
        Test.stopTest();

        List<Nucleus_API_Log__c> logs = [SELECT Id, status__c FROM Nucleus_API_Log__c WHERE Collection__c = :col.Id];
        System.assert(!logs.isEmpty(), 'Expected API log to be created');
    }
