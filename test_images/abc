public class DMAmountLimit {
    public static void doValidate(List<Disbursement__c> dmList){
        try{
            Set<String> dmIdSet = new Set<String>();
            for(Disbursement__c dmObj : dmList) {
                dmIdSet.add(dmObj.Id);
            }
            
            Map<String, DM_Approval_Matrix__c> dmApprovalMatrixMap = new Map<String, DM_Approval_Matrix__c>();
            for(DM_Approval_Matrix__c dmAppMat : [SELECT Id, HL__c, LAP__c, Recommended_For__c, Recommended_For__r.UserName FROM DM_Approval_Matrix__c where Status__c = 'Approved' AND Recommended_For__r.UserName =: UserInfo.getUserName()]){
                dmApprovalMatrixMap.put(dmAppMat.Recommended_For__r.UserName, dmAppMat);
            }
            
            Map<String, Disbursement__c> dmToApplicationLoanTypeMap = new Map<String, Disbursement__c>();
            for(Disbursement__c dm : [SELECT Id, Application__c, Application__r.Loan_Type__c, Application__r.Sanctioned_Amont__c FROM Disbursement__c where Id IN: dmIdSet]){
                dmToApplicationLoanTypeMap.put(dm.Id, dm);
            }
            if(dmIdSet.size() > 0){
                List<ProcessInstance> pi = [SELECT Id, LastActor.Name, (SELECT Id, ActorId, ProcessInstanceId FROM Workitems LIMIT 1) FROM ProcessInstance where TargetObjectId IN: dmIdSet order by CompletedDate DESC LIMIT 1];
                for(Disbursement__c dmObj : dmList) {
                    if(dmApprovalMatrixMap.containskey(UserInfo.getUserName())){
                        if((dmObj.Disb_Status__c == 'Send to CPU' || dmObj.Disb_Status__c == 'Payment Under Process' || dmObj.Disb_Status__c == 'Cancelled by PRE-CPU' || dmObj.Disb_Status__c == 'Cancelled by CPU') && dmToApplicationLoanTypeMap.containskey(dmObj.Id) && dmToApplicationLoanTypeMap.get(dmObj.Id).Application__r.Loan_Type__c.contains('LAP') && dmToApplicationLoanTypeMap.get(dmObj.Id).Application__r.Sanctioned_Amont__c > dmApprovalMatrixMap.get(UserInfo.getUserName()).LAP__c) {
                            dmObj.addError(Label.DMAmountLimitValidation);
                        } 
                        if((dmObj.Disb_Status__c == 'Send to CPU' || dmObj.Disb_Status__c == 'Payment Under Process' || dmObj.Disb_Status__c == 'Cancelled by PRE-CPU' || dmObj.Disb_Status__c == 'Cancelled by CPU') && dmToApplicationLoanTypeMap.containskey(dmObj.Id) && dmToApplicationLoanTypeMap.get(dmObj.Id).Application__r.Loan_Type__c.contains('Housing Loan') && dmToApplicationLoanTypeMap.get(dmObj.Id).Application__r.Sanctioned_Amont__c > dmApprovalMatrixMap.get(UserInfo.getUserName()).HL__c) {
                            dmObj.addError(Label.DMAmountLimitValidation); 
                        }
                    }
                    else{
                        dmObj.addError('Sorry!! You don\'t have rights on the DM Approval Matrix'); 
                    }
                }
            }
        }
        catch(Exception ex){
            System.debug('Error occured ==>>> ' + ex.getMessage() + ' at line no. of = ' + ex.getLineNumber());        
        }
    }
}

