    /*
* Helper for Branch Approver and EBS Branch User OTP success coverage.
* Uses existing dynamic lookup helper from this test class.
*/
    private static Id createBranchWithApproverAndEbsUsers() {
        Id branchId = createValidLookupRecordForField(
            Opportunity.SObjectType,
            'Branch__c'
        );
        
        if (branchId == null) {
            return null;
        }
        
        User approverUser = createRetentionTestUserWithMobile('Approver');
        User ebsUser = createRetentionTestUserWithMobile('EbsUser');
        
        if (approverUser == null || ebsUser == null) {
            return null;
        }
        
        SObject branchRecord =
            branchId.getSObjectType().newSObject(branchId);
        
        Schema.DescribeSObjectResult branchDescribe =
            branchId.getSObjectType().getDescribe();
        
        Map<String, Schema.SObjectField> branchFields =
            branchDescribe.fields.getMap();
        
        Boolean hasAnyUpdate = false;
        
        if (
            branchFields.containsKey('Branch_Approver__c') &&
            branchFields.get('Branch_Approver__c').getDescribe().isUpdateable()
        ) {
            branchRecord.put('Branch_Approver__c', approverUser.Id);
            hasAnyUpdate = true;
        }
        
        if (
            branchFields.containsKey('Branch_User__c') &&
            branchFields.get('Branch_User__c').getDescribe().isUpdateable()
        ) {
            branchRecord.put('Branch_User__c', ebsUser.Id);
            hasAnyUpdate = true;
        }
        
        if (!hasAnyUpdate) {
            return null;
        }
        
        Database.SaveResult branchUpdateResult =
            Database.update(branchRecord, false);
        
        if (!branchUpdateResult.isSuccess()) {
            return null;
        }
        
        return branchId;
    }
    
    private static User createRetentionTestUserWithMobile(String suffixValue) {
        Profile profileRecord = [
            SELECT Id
            FROM Profile
            WHERE UserType = 'Standard'
            LIMIT 1
        ];
        
        String uniqueValue =
            String.valueOf(DateTime.now().getTime()) +
            String.valueOf(Math.abs(Crypto.getRandomInteger()));
        
        User userRecord = new User(
            FirstName = 'Retention',
            LastName = suffixValue,
            Alias = suffixValue.length() > 8
            ? suffixValue.substring(0, 8)
            : suffixValue,
            Email = 'retention.' + uniqueValue + '@example.com',
            Username = 'retention.' + uniqueValue + '@example.com',
            CommunityNickname = 'ret' + uniqueValue.left(10),
            ProfileId = profileRecord.Id,
            TimeZoneSidKey = 'Asia/Kolkata',
            LocaleSidKey = 'en_IN',
            EmailEncodingKey = 'UTF-8',
            LanguageLocaleKey = 'en_US',
            MobilePhone = TEST_MOBILE
        );
        
        Database.SaveResult userResult =
            Database.insert(userRecord, false);
        
        if (!userResult.isSuccess()) {
            return null;
        }
        
        return userRecord;
    }
    
