// Conceptual example if you have a Pincode Master object in Object Manager:
Map<String, String> pinToState = new Map<String, String>();
for (Pincode_Master__c pm : [SELECT Name, State__c FROM Pincode_Master__c WHERE Name IN :pinCodes]) {
    pinToState.put(pm.Name, pm.State__c);
}
return pinToState;
