    private static void insertRetentionLead(Lead retentionLead) {
        System.debug(
            LoggingLevel.INFO,
            'insertRetentionLead START'
            + ' | FirstName=' + retentionLead.FirstName
            + ' | LastName=' + retentionLead.LastName
            + ' | Company=' + retentionLead.Company
            + ' | LeadPhone='
            + maskPhone(
                String.valueOf(
                    retentionLead.Lead_Phone_Number_1__c
                )
            )
            + ' | StandardMobileAssigned='
            + !String.isBlank(retentionLead.MobilePhone)
            + ' | StandardPhoneAssigned='
            + !String.isBlank(retentionLead.Phone)
        );

        Database.SaveResult saveResult =
            Database.insert(retentionLead, false);

        if (saveResult.isSuccess()) {
            retentionLead.Id = saveResult.getId();

            System.debug(
                LoggingLevel.INFO,
                'insertRetentionLead SUCCESS'
                + ' | LeadId=' + retentionLead.Id
            );

            return;
        }

        List<String> errors = new List<String>();

        for (Database.Error errorItem : saveResult.getErrors()) {
            String fields =
                errorItem.getFields() == null
                || errorItem.getFields().isEmpty()
                ? ''
                : ' | Fields: '
                    + String.join(
                        errorItem.getFields(),
                        ', '
                    );

            String errorText =
                String.valueOf(errorItem.getStatusCode())
                + ' | '
                + errorItem.getMessage()
                + fields;

            errors.add(errorText);

            System.debug(
                LoggingLevel.ERROR,
                'insertRetentionLead FAILED'
                + ' | ' + errorText
            );
        }

        throw new AuraHandledException(
            'Retention Lead could not be created. '
            + String.join(errors, ' || ')
        );
    }

    private static String getPhotoUrl(
    String imageUrl,
    String photographHtml,
    String photoUrl
) {
    if (!String.isBlank(imageUrl)) {
        return imageUrl;
    }

    if (!String.isBlank(photographHtml)) {
        Matcher matcher = Pattern.compile(
            '(?i)<img[^>]+src\\s*=\\s*["\\\']([^"\\\']+)["\\\']'
        ).matcher(photographHtml);

        if (matcher.find()) {
            return matcher.group(1);
        }
    }

    return null; // don't fall back to PhotoUrl — it's always a silhouette when empty
}

    private static String riskLevel(
        Decimal dpd,
        Decimal bounces
    ) {
        if (nz(dpd) >= 30 || nz(bounces) >= 2) {
            return 'High';
        }

        if (nz(dpd) > 0 || nz(bounces) > 0) {
            return 'Medium';
        }

        return 'Low';
    }

    private static String riskReason(
        Decimal dpd,
        Decimal bounces
    ) {
        List<String> values = new List<String>();

        if (nz(dpd) > 0) {
            values.add(
                String.valueOf(dpd.setScale(0))
                + ' DPD'
            );
        }

        if (nz(bounces) > 0) {
            values.add(
                String.valueOf(bounces.setScale(0))
                + ' bounce(s)'
            );
        }

        return values.isEmpty()
            ? 'No DPD or bounce count is available on this Application.'
            : String.join(values, ' · ');
    }

    private static String maskPhone(String phoneNumber) {
        if (String.isBlank(phoneNumber)) {
            return 'blank';
        }

        String digits = phoneNumber.replaceAll('[^0-9]', '');

        if (digits.length() <= 4) {
            return '****';
        }

        return '******'
            + digits.substring(
                digits.length() - 4,
                digits.length()
            );
    }

    private static String maskOtp(String otp) {
        if (String.isBlank(otp)) {
            return 'blank';
        }

        if (otp.length() <= 2) {
            return '**';
        }

        return '****'
            + otp.substring(
                otp.length() - 2,
                otp.length()
            );
    }

    private static Decimal nz(Decimal value) {
        return value == null ? 0 : value;
    }

    private static Decimal firstNonNull(
        Decimal firstValue,
        Decimal secondValue
    ) {
        return firstValue == null
            ? secondValue
            : firstValue;
    }

    private static Decimal roundMoney(Decimal value) {
        return value == null
            ? null
            : value.setScale(2);
    }

    private static String formatMoney(Decimal value) {
        return value == null
            ? '—'
            : '₹' + String.valueOf(value.setScale(0));
    }

    private static String firstNonBlank(List<String> values) {
        for (String value : values) {
            if (!String.isBlank(value)) {
                return value;
            }
        }

        return null;
    }

    private static String joinAddress(List<String> values) {
        List<String> output = new List<String>();

        for (String value : values) {
            if (!String.isBlank(value)) {
                output.add(value);
            }
        }

        return String.join(output, ', ');
    }

    private static String initials(String name) {
        if (String.isBlank(name)) {
            return 'NA';
        }

        String output = '';

        for (String part : name.split(' ')) {
            if (
                !String.isBlank(part)
                && output.length() < 2
            ) {
                output += part.substring(0, 1).toUpperCase();
            }
        }

        return output;
    }

