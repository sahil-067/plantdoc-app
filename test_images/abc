    private static RestRequest buildRequest(String source, String mode, String appId) {
        RestRequest req = new RestRequest();
        req.requestURI = '/services/apexrest/PayFunction';
        req.httpMethod = 'POST';
        req.requestBody = Blob.valueOf(
            '[{"EMPCode":"ISFC1949","Amount":"1000","purpose":"Pre-EMI",' +
            '"Source":"' + source + '","DepositorPhone":"9999999999",' +
            '"Mode":"' + mode + '","AppId":"' + appId + '"}]'
        );
        return req;
    }
    
    
    
