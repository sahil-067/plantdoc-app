    // Test the Queue Enqueues and the main API Callout (Massive Coverage)
    @isTest
    static void testMethodNormalAPI_And_ParseXML(){
        Test.setMock(HttpCalloutMock.class, new MockForCibilIntegration());
        
        Account acc = [SELECT Id, PersonEmail, City__pc, Pin_Code__pc, State_Code__c, Address_Line_1__pc, Address_Line_2__pc, Date_Of_Birth__pc, FirstName, LastName, Sex__pc, Mobile__pc FROM Account LIMIT 1];
        acc.Pan_Card_No__pc = 'NRM123456A';
        update acc;
        
        Opportunity opp = [Select Id from Opportunity LIMIT 1];
        
        Customer__c cus = [Select Id, Customer_Status__c, LoanAppID__c from Customer__c LIMIT 1];
        cus.LoanAppID__c = opp.Id;
        
        Map<Id, Customer__c> oldMap = new Map<Id, Customer__c>();
        Customer__c oldCus = cus.clone(true, false, false, false);
        oldCus.Customer_Status__c = 'Pending';
        oldMap.put(oldCus.Id, oldCus);
        
        cus.Customer_Status__c = 'Approved';
        
        Test.startTest();
        // Fallback testing default Queue Enqueue routing inside generateCIBILFromCustomer logic
        CIBILIntegrationTriggerHelper.generateCIBILFromCustomer(new List<Customer__c>{cus}, oldMap);
        
        // Execute manual generation to trigger HTTP callout heavily and deep XML parsing via DOM
        String serialAcc = JSON.serialize(acc);
        CIBILIntegrationTriggerHelper.generateCIBILNew(serialAcc, 2000);
        
        // Retain original invocations requested to remain from original Test Class
        try {
            system.enqueueJob(new CibiliIntegartionQueue(serialAcc,2000));
        } catch(Exception e){}
        try {
            CibilUploadDocumentByTriggerQueue.uploadDocumentMethod(opp.Id,'5570439',acc.Id);
        } catch(Exception e){}
        
        Test.stopTest();
    }
    
    // Covers all Data Format Validation Errors resulting in "addError" inside generateCIBILNew
    @isTest
    static void testGenerateCIBILNewDataValidations(){
        Account acc = [SELECT Id FROM Account LIMIT 1];
        
        Test.startTest();
        
        // Error Scenario 1: First Name < 3, DOB < 16, No Identifiers
        Account acc1 = acc.clone(true, false, false, false);
        acc1.FirstName = 'A';
        acc1.LastName = 'B';
        acc1.Date_Of_Birth__pc = Date.today().addYears(-10);
        acc1.Sex__pc = 'Third Gender';
        acc1.Mobile__pc = null;
        acc1.Pan_Card_No__pc = null;
        acc1.Passport_No__pc = null;
        acc1.Voter_Card__pc = null;
        acc1.Drv_Licn__pc = null;
        acc1.Ration_Card__pc = null;
        acc1.Aadhar_Card__pc = null;
        CIBILIntegrationTriggerHelper.generateCIBILNew(JSON.serialize(acc1), 2000);
        
        // Error Scenario 2: Contains '&' special char in critical string fields
        Account acc2 = acc.clone(true, false, false, false);
        acc2.Mobile__pc = '123&456';
        acc2.Pan_Card_No__pc = 'ABC&123';
        acc2.Address_Line_1__pc = 'abc&def';
        acc2.Address_Line_2__pc = 'abc&def';
        acc2.City__pc = 'a&b';
        acc2.State_Code__c = '1&';
        CIBILIntegrationTriggerHelper.generateCIBILNew(JSON.serialize(acc2), 2000);
        
        // Error Scenario 3: Pincode explicitly ends with '000'
        Account acc3 = acc.clone(true, false, false, false);
        acc3.Pin_Code__pc = 120000;
        CIBILIntegrationTriggerHelper.generateCIBILNew(JSON.serialize(acc3), 2000);
        
        // Error Scenario 4: Pincode possesses strictly < 6 digits
        Account acc4 = acc.clone(true, false, false, false);
        acc4.Pin_Code__pc = 12345;
        CIBILIntegrationTriggerHelper.generateCIBILNew(JSON.serialize(acc4), 2000);
        
        // Error Scenario 5: Address lines possessing precisely < 3 characters
        Account acc5 = acc.clone(true, false, false, false);
        acc5.Address_Line_1__pc = 'a';
        acc5.Address_Line_2__pc = 'b';
        CIBILIntegrationTriggerHelper.generateCIBILNew(JSON.serialize(acc5), 2000);
        
        Test.stopTest();
    }
