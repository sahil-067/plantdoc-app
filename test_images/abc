        // Mocks a request where Mobile parameter is missing to hit the ELSE block (400)
        RestRequest req = new RestRequest();
        RestResponse res = new RestResponse();
        
        req.requestURI = '/services/apexrest/dashboardApiV1/getDetail';
        req.httpMethod = 'GET';
        // Intentionally leaving 'Mobile' param blank/missing
        req.params.put('currentVersion', '1.0'); 
        
        RestContext.request = req;
        RestContext.response = res;
        
        Test.startTest();
        DashboardApi_V1.WrapperClass responseWrapper = DashboardApi_V1.getDetail();
        Test.stopTest();
        
        // Assertions
        System.assertNotEquals(null, responseWrapper, 'Wrapper should not be null');
        System.assertEquals('400', responseWrapper.response.resCode, 'Response Code should be 400');
        System.assertEquals('required parameter is empty', responseWrapper.response.resMessage, 'Appropriate error message expected');
    }
    
    @isTest
    static void testGetDetail_ExceptionCatchBlock() {
        // Setting RestContext.request to null forces a NullPointerException 
        // when the controller executes mapdata=request.params; covering the Catch block.
        RestContext.request = null;
        RestContext.response = new RestResponse();
        
        Test.startTest();
        DashboardApi_V1.WrapperClass responseWrapper = DashboardApi_V1.getDetail();
        Test.stopTest();
        
        // Assertions
        System.assertNotEquals(null, responseWrapper, 'Wrapper should not be null');
        System.assertEquals('400', responseWrapper.response.resCode, 'Response Code should be 400 from exception catch block');
        System.assert(responseWrapper.response.resMessage.contains('line number'), 'Exception message should be captured');
    }
