        : app.Loan_Number__c;

/*
 * Foreclosure policy:
 * MOB > 24 months  -> 4.5%
 * MOB <= 24 months -> 6%
 *
 * If MOB is blank, default to 6% because it is not more than 24.
 */
result.charges.foreclosureRate =
    app.MOB__c != null && app.MOB__c > 24
        ? FORECLOSURE_RATE_MOB_MORE_THAN_24
        : FORECLOSURE_RATE_MOB_24_OR_LESS;

