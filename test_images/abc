// Second Queueable class for handling additional callouts
global class ProcessReceiptStep2 implements Queueable, Database.AllowsCallouts {
    private Id recordId;
    private Collection__c collist;
    private Opportunity oplist;
    private String accesstoken;
    private String strCheck;
    
    // Constructor to initialize data
    public ProcessReceiptStep2(Id recordId, Collection__c collist, Opportunity oplist, String accesstoken,string strCheck) {
        this.recordId = recordId;
        this.collist = collist;
        this.oplist = oplist;
        this.accesstoken = accesstoken;
        this.strCheck=strCheck;
    }
    
    public void execute(QueueableContext context) {
        // New Logic added by AT 17-09-2024
        Id clientRT = SObjectType.Adhoc_charges__c.getRecordTypeInfosByDeveloperName().get('Record_Type_Cash').getRecordTypeId();
        List<Adhoc_charges__c> adlList = new List<Adhoc_charges__c>();
        List<Collection__c> colListn = new List<Collection__c>();
        
        // STEP 1: MAKE ADDITIONAL CALLOUTS
        String duedate;
        if(collist.Date_of_Collection__c != Null) {
            Integer day = collist.Date_of_Collection__c.day();
            Integer month = collist.Date_of_Collection__c.month();
            String daystr = day <= 9 ? '0' + day : String.valueof(day);
            String monthstr = month <= 9 ? '0' + month : String.valueof(month);
            duedate = daystr + '/' + monthstr + '/' + collist.Date_of_Collection__c.Year();
        }
        System.debug('strCheck 2 '+strCheck);
        if(strCheck.containsIgnoreCase('success')){
        if((collist.Nature_of_Collection__c=='Emi/Advances/Part Payment' || collist.Nature_of_Collection__c=='Pre-EMI') && collist.Status__c!='Cancelled' && collist.Instrument__c=='Cash') {
            String bdy;
            try {
                Adhoc_charges__c adh = new Adhoc_charges__c();
                Adhoc_creation__mdt dfd = [Select Id, API_End_Point_URL__c,autoAuthorizeFlag__c,branchId__c,businessPatnerId__c,businessPatnerTypeCode__c,chargeId__c,dueAmount__c,dynamicFieldsData__c,property1__c,property2__c,reasonCode__c,remarks__c,requestChannel__c,requestHeader__c,tenantId__c,userCode__c,userDetail__c from Adhoc_creation__mdt];
                
                bdy = '{"autoAuthorizeFlag":"'+dfd.autoAuthorizeFlag__c+'","businessPatnerId":'+Integer.valueof(dfd.businessPatnerId__c)+',"businessPatnerTypeCode":"'+dfd.businessPatnerTypeCode__c+'","chargeId":'+Integer.valueof(dfd.chargeId__c)+',"dueAmount":'+Integer.valueof(dfd.dueAmount__c)+',"dueDate":"'+duedate+'","dynamicFieldsData":{"property1":{},"property2":{}},"loanAccountNumber":"'+oplist.Finnone_Loan_Id__c+'","reasonCode":"'+dfd.reasonCode__c+'","remarks":"'+dfd.remarks__c+'","requestChannel":"'+dfd.requestChannel__c+'","requestHeader":{"tenantId":"'+dfd.tenantId__c+'","userDetail":{"branchId":5000232,"userCode":"'+dfd.userCode__c+'"}}}'; 
                System.debug('bdy '+bdy);
                
                Http hreq = new Http();
                HttpRequest req = new HttpRequest();
                
                req.setHeader('Content-type', 'application/json');   
                req.setHeader('access_token',accesstoken);
                req.setEndpoint(dfd.API_End_Point_URL__c);
                req.setTimeout(120000);
                req.setMethod('POST');
                req.setBody(bdy);
                System.debug('Helloooo req '+req);
                
                adh.Adhoc_Request__c = bdy;
                adh.URL__c = dfd.API_End_Point_URL__c;
                adh.recordTypeId = clientRT;
                
                String str = '';
                HttpResponse res = hreq.send(req);
                system.debug('response---->' + res);
                system.debug('response---->' + res.getbody());
                
                adh.Adhoc_Response__c = res.getbody();
                adh.Collection__c = collist.Id;
                adh.recordTypeId = clientRT;
                
                // ADD NULL CHECK HERE
                adhocApex successWrapperList;
                try {
                    successWrapperList = adhocApex.parse(res.getbody());
                    if(successWrapperList != null && successWrapperList.success != null) {
                        System.debug('successWrapperList.success.transactionReferenceNumber '+successWrapperList.success.transactionReferenceNumber);
                        collist.transactionReferenceNumber__c = String.valueof(successWrapperList.success.transactionReferenceNumber);
                        colListn.add(collist);
                        adlList.add(adh);
                    } else {
                        system.debug('successWrapperList is null or success is null');
                    }
                } catch(Exception e) {
                    system.debug('Error parsing adhoc response: ' + e.getMessage());
                }
                
                // Always add the record regardless of parsing success
                adlList.add(adh);
                colListn.add(collist);
            } catch(Exception e) {
                Adhoc_charges__c adh = new Adhoc_charges__c();
                adh.Adhoc_Request__c = bdy;
                adh.Adhoc_Response__c = e.getMessage() + ' and Error Line Number' + e.getLineNumber();
                adlList.add(adh);
            }
        } 
        else if((collist.Nature_of_Collection__c=='Emi/Advances/Part Payment' || collist.Nature_of_Collection__c=='Pre-EMI') && collist.Status__c=='Cancelled' && collist.Instrument__c=='Cash') {
            string strbody;
            try {
                Adhoc_charges__c adh = new Adhoc_charges__c();
                Adhoc_cancellation__mdt ad = [Select Id, attachmentReferenceId__c,End_Point_URL__c,autoAuthorizeFlag__c,branchId__c,cancelreason__c,remarks__c,requestHeader__c,tenantId__c,transactionReferenceNumber__c,userCode__c from Adhoc_cancellation__mdt];
                
                strbody = '{"attachmentReferenceId":"'+ad.attachmentReferenceId__c+'","autoAuthorizeFlag":"'+ad.autoAuthorizeFlag__c+'","cancelreason":"'+ad.cancelreason__c+'","remarks":"'+ad.remarks__c+'","requestHeader":{"tenantId":'+Integer.valueof(ad.tenantId__c)+',"userDetail":{"branchId":'+Integer.valueof(ad.branchId__c)+',"userCode":"'+ad.userCode__c+'"}},"transactionReferenceNumber":'+Integer.valueof(collist.transactionReferenceNumber__c)+'}';
                
                Http hreq = new Http();
                HttpRequest req = new HttpRequest();
                
                req.setHeader('Content-type', 'application/json');   
                req.setHeader('access_token',accesstoken);
                req.setEndpoint(ad.End_Point_URL__c);
                req.setTimeout(120000);
                req.setMethod('POST');
                req.setBody(strbody);
                System.debug('Helloooo req '+req);
                
                String str = '';
                HttpResponse res = hreq.send(req);
                system.debug('response---->' + res.getBody());
                
                adh.Adhoc_Request__c = strbody;
                adh.URL__c = String.valueof(ad.End_Point_URL__c);
                adh.Adhoc_Response__c = res.getBody();
                adh.Collection__c = collist.Id;
                adh.recordTypeId = clientRT;
                adlList.add(adh);
                colListn.add(collist);
            } catch(Exception e) {
                Adhoc_charges__c adh = new Adhoc_charges__c();
                adh.Adhoc_Request__c = strbody;
                adh.Adhoc_Response__c = e.getMessage() + ' and Error Line Number' + e.getLineNumber();
                adlList.add(adh);
            }
        }
        
        // STEP 2: PERFORM ALL DML OPERATIONS AFTER ALL CALLOUTS
        try {
            Set<Collection__c> colSet=new Set<Collection__c>(colListn);
            List<Collection__c> coListUp=new List<Collection__c>(colSet);
            if(coListUp.size() > 0) {
                System.debug('colListn '+coListUp);
                update coListUp;
            }
            Set<Adhoc_charges__c> adhSet=new Set<Adhoc_charges__c>(adlList);
            List<Adhoc_charges__c> adhListIn=new List<Adhoc_charges__c>(adhSet);
            if(adhListIn.size() > 0) {
                System.debug('adlList '+adhListIn);
                insert adhListIn;
            }
        }
        catch(Exception e) {
            System.debug('Error Message '+e.getMessage());
            System.debug('Error Line Number '+e.getLineNumber());
        }
            }
    }
}
