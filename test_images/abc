public class WebmergeDocForAccFormstack {
    public List<Account> accObj {get; set;}
    public List<Formstack_Document__c> fsObj {get; set;}
    public Id appId {get; set;}
    public Boolean checkButton {get; set;}
    public string filename{get;set;}
    public List<String> selectedValues{get;set;}
    public String attid{get; set;}
    public webmergeDocForAccFormstack(ApexPages.StandardController controller){
        fsObj = new List<Formstack_Document__c>();
        appId = ApexPages.currentPage().getParameters().get('Id');
        system.debug('Apppp IDdd'+appId);
        if(appId == null){
            ApexPages.addMessage(new ApexPages.message(ApexPages.Severity.Error,('No account Selected')));
        }
        else{
            if(appId!= null){
                accObj = [Select ID,Select_Docs_To_Generate__pc From Account where ID =: appId];
                system.debug('acc ID'+accObj);
            }
            if(!accObj.isEmpty()){
                fsObj = [SELECT Name,Select_Docs_To_Generate__c,Application__c, Loan_Number__c From Formstack_Document__c WHERE Account__c = :accObj[0].ID order by CreatedDate desc limit 1];
                system.debug('fsObj ID'+fsObj);
            }
        }
        if(fsObj.size()>0 && fsObj[0].Loan_Number__c!= null && fsObj[0].name!= null){
            filename = fsObj[0].Loan_Number__c +'='+ fsObj[0].name;
        }
        if(!accObj.isEmpty() && accObj[0].Select_Docs_To_Generate__pc != null){
            selectedValues = accObj[0].Select_Docs_To_Generate__pc.split(';');
        }
    }
    public  void createFSRecord(){
        try {
            Formstack_Document__c myNewContact = new Formstack_Document__c();
            myNewContact.Account__c = appId;
            Insert myNewContact;
            system.debug('new sf record '+myNewContact);
        } catch (DMLException e) {
            System.debug('Exception occured : ' + e.getMessage());
        }
    }
    public PageReference mulDocument(){
        checkButton = true;
        fsObj = new List<Formstack_Document__c>();
        if (appId != null) {
            List < webm__Webmerge_Mapping__c > mappingQuery = [SELECT Id, name FROM webm__Webmerge_Mapping__c WHERE Name = 'Account Mapping Formstack' LIMIT 1];
            system.debug('mapping query '+mappingQuery);
            webm__Webmerge_Mapping__c mapping = new webm__Webmerge_Mapping__c();
            if(mappingQuery.size()>0){
                mapping = mappingQuery[0];
                System.debug('@@@@@@--------->' + mapping);
            }
            accObj = [Select ID, Add_On_Proof__pc, Identity_Proof__pc, Select_Docs_To_Generate__pc From Account where ID =: appId];
            if(!accObj.isEmpty()){
                fsObj = [SELECT Name, Select_Docs_To_Generate__c, Loan_Number__c, Add_On_Proof__c, Identity_Proof__c From Formstack_Document__c WHERE Account__c = :accObj[0].ID order by CreatedDate desc limit 1];
                System.debug('opp '+accObj+'  fsss '+fsObj);
            }
            List < Attachment > generatedAttachments = new List < Attachment >();
            if(!Test.isRunningTest()){
                generatedAttachments = webm.WebmergeGenerator.generateDocumentGetAttachments(
                    mapping.Id,
                    fsObj[0].Id,
                    'Formstack_Document__c'
                );
            }
            else
                if(Test.isRunningTest()){
                    system.debug('inside test ');
                    generatedAttachments = [Select Id, ParentID From Attachment Limit 1];
                    system.debug('gen reata '+generatedAttachments);
                }
            //system.debug('gen mapping '+mapping.Id+'fsobj ' +fsObj[0].Id+' Formstack_Document__c');
            system.debug('generatedAttachments '+generatedAttachments);
            for (attachment att: generatedAttachments) {
                if (att != null &&  !accObj.isEmpty()) {
                    if(!Test.isRunningTest()) {
                        if(accObj[0].Select_Docs_To_Generate__pc == 'Form 60'){
                            att.Description = 'Form 60';
                        }
                        else{
                            att.Description = 'Illetrate Certificate';
                        }
                        att.ParentID = accObj[0].Id;
                        attid = att.Id;
                        insert att;
                        
                        Account acc = new Account();
                        acc.Id = accObj[0].Id;
                        if(accObj[0].Select_Docs_To_Generate__pc == 'Form 60'){
                            acc.is_Form_60_Generated__c = true;
                        }
                        else{
                            acc.is_Illetrate_Certificate_Generated__c = true;
                        }
                        update acc;
                        
                        if(accObj[0].Select_Docs_To_Generate__pc == 'Form 60'){
                            fsObj[0].Add_On_Proof__c = accObj[0].Add_On_Proof__pc;
                            fsObj[0].Identity_Proof__c = accObj[0].Identity_Proof__pc;
                        }
                        update fsObj;
                    }
                    String redirect = '/servlet/servlet.FileDownload?file=' + att.Id;
                    PageReference ref = new PageReference(redirect);
                    ref.setRedirect(true);
                    return ref;
                }
            }
        }
        else {
            ApexPages.addMessage(new ApexPages.message(ApexPages.Severity.error, 'Application Not Found'));
        }
        return null;
    }
