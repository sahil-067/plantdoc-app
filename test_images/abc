public class MockProcessReceiptSuccess implements HttpCalloutMock {
        public HTTPResponse respond(HTTPRequest req) {
            HttpResponse res = new HttpResponse();
            res.setHeader('Content-Type', 'application/json');
            res.setStatusCode(200);
            // Universal JSON body to satisfy both Token parsing and Payload parsing
            res.setBody('{"access_token":"token123", "responseCode":"success", "payload":{"messages":[{"messageArguments":["123456"]}]}, "dummy":"with Receipt # 12345\"", "value":"Status:Cleared"}');
            return res;
        }
    }

    public class MockProcessReceiptError implements HttpCalloutMock {
        public HTTPResponse respond(HTTPRequest req) {
            HttpResponse res = new HttpResponse();
            res.setHeader('Content-Type', 'application/json');
            res.setStatusCode(500);
            // Universal JSON body for the Error path
            res.setBody('{"access_token":"token123", "responseCode":"error", "value":"Status:Failed"}');
            return res;
        }
    }
