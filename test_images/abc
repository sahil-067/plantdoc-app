    private static String getLoanAmountBand(Decimal Amount) {

        if (amount == null) {
            return 'Not captured';
        }
        if (amount <= 0) {
            return 'Not captured';
        }

        if (amount < 500000)  {
            return '< 5L';
        }
        if (amount < 1000000) {
            return '5-10L';
        }
        if (amount < 2000000) {
            return '10-20L';
        }
        if (amount < 3000000) {
            return '20-30L';
        }
        if (amount < 4000000) {
            return '30-40L';
        }
        return '40L+';
    }

    private static String getLanguageFromSouthState(String stateName) {
        if (stateName == null) return null;
        String upper = stateName.toUpperCase();
        if (upper.contains('TAMIL NADU') || upper.contains('PUDUCHERRY') || upper.contains('PONDI') || upper.contains('KERALA') || upper.contains('SOUTH')) {
            return 'TAMIL';
        }
        if (upper.contains('TELANGANA') || upper.contains('ANDHRA PRADESH')) {
            return 'TELUGU';
        }
        if (upper.contains('KARNATAKA')) {
            return 'KANNADA';
        }
        return null;
    }

    private static String getSouthLanguageFromText(String text) {
        if (String.isBlank(text)) return null;
        String upperText = text.toUpperCase();
        
        //If lang name in campaign field
        if (upperText.contains('TAMIL') || upperText.contains('PUDUCHERRY')) {
            return 'TAMIL';
        }
        if (upperText.contains('TELUGU') || upperText.contains('TELANGANA') || upperText.contains('ANDHRA')) {
            return 'TELUGU';
        }
        if (upperText.contains('KANNADA') || upperText.contains('KARNATAKA')) {
            return 'KANNADA';
        }

        //If south state name in campaign field
        for (String southState : SOUTH_STATES.keySet()) {
            if (upperText.contains(southState)) {
                return getLanguageFromSouthState(southState);
            }
        }
        return null;
    }
}
