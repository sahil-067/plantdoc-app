            formStackDoc.DOB_as_per_Driving_License__c = dobAsPerDrivingLicense != '' ? changeDateFormat(dobAsPerDrivingLicense) : 'N/A';
            formStackDoc.DOB_as_per_Aadhar_Card__c = dobAsPerAadharCard != '' ? changeDateFormat(dobAsPerAadharCard) : 'N/A';
            formStackDoc.Sign_as_per_PAN_Card__c = signAsPerPANCard;
            formStackDoc.Sign_as_per_Passport__c = signAsPerPassport;
            formStackDoc.HLA_Signed_Date__c = accIdToHLASignDateMap.get(recordId);
            if(correctDocument == 'PAN Card'){
                formStackDoc.Correct_Document_Name__c = correctDocument;
                formStackDoc.Correct_Date_of_Birth__c = dobAsPerPANCard;
            }
            if(correctDocument == 'Voter Card'){
                formStackDoc.Correct_Document_Name__c = correctDocument;
                formStackDoc.Correct_Date_of_Birth__c = dobAsPerVoterCard;
            }
            if(correctDocument == 'Passport'){
                formStackDoc.Correct_Document_Name__c = correctDocument;
                formStackDoc.Correct_Date_of_Birth__c = dobAsPerPassport;
            }
            if(correctDocument == 'Driving License'){
                formStackDoc.Correct_Document_Name__c = correctDocument;
                formStackDoc.Correct_Date_of_Birth__c = dobAsPerDrivingLicense;
            }
            if(correctDocument == 'Aadhar Card'){
                formStackDoc.Correct_Document_Name__c = correctDocument;
                formStackDoc.Correct_Date_of_Birth__c = dobAsPerAadharCard;
            }
            insert formStackDoc;
        }
        catch(Exception ex){
            System.debug(ex.getLineNumber()+'=========='+ex.getMessage());
        }
    }
    
