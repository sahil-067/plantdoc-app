    public void validateHLAValues(Opportunity opportunityRecord) {
        try {
            List<HLA_Audit_Trail__c> auditTrailList = [
                SELECT Id, Sanctioned_Amount__c, Sanctioned_Date__c, NHB_Categories__c,Sanctioned_EMI__c,
                Sanctioned_Tenure__c, Sanctioned_ROI__c, Collateral_Address_1__c,
                Collateral_Address_2__c, Collateral_Address_3__c, Collateral_City__c,
                Collateral_District__c, Collateral_Pin_Code__c, Collateral_State__c,
                Collateral_Pin_Code_New__c, Loan_Type__c, Loan_Product__c,
                Name_of_Property_Owner__c, CreatedDate,Processing_Fees__c
                FROM HLA_Audit_Trail__c
                WHERE Application__c = :opportunityRecord.Id
                ORDER BY CreatedDate DESC
                LIMIT 1
            ];
            if (auditTrailList.isEmpty()) {
                ApexPages.addMessage(new ApexPages.Message(
                    ApexPages.Severity.ERROR,
                    'Please generate the New HLA, as sanctioned values have been altered.'
                ));
                showDocTypeDropdown = false;
                return;
            }
            HLA_Audit_Trail__c latestAudit = auditTrailList[0];
            if (
                opportunityRecord.Sanctioned_Amont__c != latestAudit.Sanctioned_Amount__c ||
                opportunityRecord.Sanctioned_Date__c != latestAudit.Sanctioned_Date__c ||
                opportunityRecord.NHB_Categories__c != latestAudit.NHB_Categories__c ||
                opportunityRecord.Sanctioned_Tenure__c != latestAudit.Sanctioned_Tenure__c ||
                opportunityRecord.Sanctioned_ROI__c != latestAudit.Sanctioned_ROI__c ||
                opportunityRecord.CollAdd1__c != latestAudit.Collateral_Address_1__c ||
                opportunityRecord.CollAdd2__c != latestAudit.Collateral_Address_2__c ||
                opportunityRecord.CollAdd3__c != latestAudit.Collateral_Address_3__c ||
                opportunityRecord.CollCity__c != latestAudit.Collateral_City__c ||
                opportunityRecord.C_District__c != latestAudit.Collateral_District__c ||
                opportunityRecord.ColPin__c != latestAudit.Collateral_Pin_Code__c ||
                opportunityRecord.Coll_State__c != latestAudit.Collateral_State__c ||
                opportunityRecord.Collateral_Pin_Code_New__c != latestAudit.Collateral_Pin_Code_New__c ||
                opportunityRecord.Loan_Type__c != latestAudit.Loan_Type__c ||
                String.valueOf(opportunityRecord.Loan_Product__r.Name) != latestAudit.Loan_Product__c ||
                opportunityRecord.Name_of_Property_Owner__c != latestAudit.Name_of_Property_Owner__c ||
                opportunityRecord.Sanc_EMI__c != latestAudit.Sanctioned_EMI__c ||
                opportunityRecord.Effective_PF__c != latestAudit.Processing_Fees__c
                //    opportunityRecord.Sanc_EMI__c != latestAudit.Sanctioned_EMI__c // Update for Coll 4
            ) {
                System.debug('Entered in If Block');
                ApexPages.addMessage(new ApexPages.Message(
                    ApexPages.Severity.ERROR,
                    'Please generate the New HLA, as sanctioned values have been altered.'
                ));
                showDocTypeDropdown = false;
                return;
            }
        } catch (Exception ex) {
            System.debug('ex :: '+ex);
            ApexPages.addMessage(new ApexPages.Message(
                ApexPages.Severity.ERROR,
                'An unexpected error occurred while validating HLA values: ' + ex.getMessage()
            ));
        }
    }
