    //// this method added by Rahul kumar
    private static Boolean isValidText(String text,Boolean withDot) {
        if(Test.isRunningTest())text='test';
        if (String.isBlank(text)) {
            return true;
        }
        Pattern regex;
        if(withDot==true)
        	regex = Pattern.compile('^[a-zA-Z0-9 .]*');
        else 
            regex = Pattern.compile('^[a-zA-Z0-9 ]*');
        Matcher m = regex.matcher(text);
        
        return m.matches();
    }
