    // 1. Covers requestAccessToken() JSON parsing + buttonCall()
    @isTest
    static void testRequestAccessTokenAndButtonCall() {
        Opportunity opp = [SELECT Id FROM Opportunity LIMIT 1];
        Nucleus_Deposit_Bank__c bank = [SELECT Id FROM Nucleus_Deposit_Bank__c WHERE BankType__c = 'Cheque' LIMIT 1];

        Collection__c col = buildCollection(
            opp.Id, bank.Id, 'Cheque', 'Bounced', 'Deposited',
            'Emi/Advances/Part Payment', System.today(), System.today(), 1234
        );
        insert col;

        String tokenAndSuccessJson = '{' +
            '"access_token": "mock_access_token_123",' +
            '"responseCode": "success",' +
            '"payload": {"messages": [{"messageArguments": ["11014697"], "value": "with Receipt # 11014697"}]}' +
        '}';
        Test.setMock(HttpCalloutMock.class, new ProcessReceiptMock(200, tokenAndSuccessJson));

        Test.startTest();
        String token = ProcessReceiptService.requestAccessToken();
        System.assertEquals('mock_access_token_123', token);
        ProcessReceiptService.buttonCall(col.Id);
        Test.stopTest();
    }

    // 2. Covers Cash SQL filter, trStatus = 'C', IMD receiptPurpose, blank cheque no, Dec 2021 date,
    //    ResponseWrapper success, FinnOne_ReceiptID__c update, and Nucleus_Reciept__c insertion
    @isTest
    static void testDoPostCashClearedSuccessAndIMD() {
        Opportunity opp = [SELECT Id FROM Opportunity LIMIT 1];
        Nucleus_Deposit_Bank__c cashBank = [SELECT Id FROM Nucleus_Deposit_Bank__c WHERE BankType__c = 'Cash' LIMIT 1];

        List<Nucleus_Receipt_For_Collection__mdt> imdMdt = [
            SELECT MasterLabel
            FROM Nucleus_Receipt_For_Collection__mdt
            WHERE Receipt_Purpose_Type__c = 'IMD'
            LIMIT 1
        ];
        String nature = imdMdt.isEmpty() ? 'Emi/Advances/Part Payment' : imdMdt[0].MasterLabel;

        Collection__c col = buildCollection(
            opp.Id, cashBank.Id, 'Cash', 'Active', 'Cleared',
            nature, Date.newInstance(2021, 12, 15), null, null
        );
        insert col;

        Test.setMock(HttpCalloutMock.class, new ProcessReceiptMock(200, getSuccessResponseBody()));

        Test.startTest();
        String result = ProcessReceiptService.doPost(col.Id, 'C');
        Test.stopTest();

        System.assertNotEquals(null, result);
        Collection__c updatedCol = [SELECT FinnOne_ReceiptID__c, Receipt_Generated__c FROM Collection__c WHERE Id = :col.Id];
        System.assertEquals(11014697, updatedCol.FinnOne_ReceiptID__c);
    }

    // 3. Covers EasyPay + Pay_Slip__c (Dec 2021 dates), null Account_No__c fallback,
    //    non-HL01 Scheme_Master__mdt, Auto_Allocation__c = 'N' allocationBreakUpDetails, and trStatus = '' Active/Cleared
    @isTest
    static void testDoPostEasyPayWithPaySlipAndAutoAllocN() {
        Opportunity opp = [SELECT Id, Loan_Product__c FROM Opportunity LIMIT 1];
        Nucleus_Deposit_Bank__c easyPayBank = [SELECT Id FROM Nucleus_Deposit_Bank__c WHERE BankType__c = 'EasyPay' LIMIT 1];

        // Switch Loan Product to a non-HL01 scheme if available
        List<Scheme_Master__mdt> nonHlSchemes = [
            SELECT MasterLabel
            FROM Scheme_Master__mdt
            WHERE Product_code__c != 'HL01'
            LIMIT 1
        ];
        if (!nonHlSchemes.isEmpty()) {
            Loan_Product__c lp = new Loan_Product__c(Id = opp.Loan_Product__c, Name = nonHlSchemes[0].MasterLabel);
            update lp;
        }

        // Pick a metadata record that triggers the Auto_Allocation__c == 'N' allocationBreakUpDetails block
        List<Nucleus_Receipt_For_Collection__mdt> autoAllocNMdt = [
            SELECT MasterLabel
            FROM Nucleus_Receipt_For_Collection__mdt
            WHERE Auto_Allocation__c = 'N'
              AND Chargeid__c != null
              AND Chargecode__c != null
              AND Receipt_Purpose_Type__c != 'IMD'
            LIMIT 1
        ];
        String nature = autoAllocNMdt.isEmpty() ? 'Emi/Advances/Part Payment' : autoAllocNMdt[0].MasterLabel;

        Date dec2021 = Date.newInstance(2021, 12, 10);
        Collection__c col = buildCollection(
            opp.Id, easyPayBank.Id, 'EasyPay', 'Active', 'Cleared',
            nature, dec2021, null, 5678
        );
        insert col;

        Pay_Slip__c pay = new Pay_Slip__c(
            Collection__c = col.Id,
            Date__c = dec2021,
            In_Favour_Of__c = 'Test Drawer',
            PS_Created__c = dec2021,
            Cheque_Date__c = dec2021
        );
        insert pay;

        Test.setMock(HttpCalloutMock.class, new ProcessReceiptMock(200, getSuccessResponseBody()));

        Test.startTest();
        String result = ProcessReceiptService.doPost(col.Id, '');
        Test.stopTest();

        System.assertNotEquals(null, result);
    }

    // 4. Covers trStatus = '' -> 'B' (Bounced Cheque), Date_of_Cancellation__c in Dec 2021,
    //    and deactivating existing Nucleus_Reciept__c
    @isTest
    static void testDoPostBouncedCheque() {
        Opportunity opp = [SELECT Id FROM Opportunity LIMIT 1];
        Nucleus_Deposit_Bank__c chequeBank = [SELECT Id FROM Nucleus_Deposit_Bank__c WHERE BankType__c = 'Cheque' LIMIT 1];

        Collection__c col = buildCollection(
            opp.Id, chequeBank.Id, 'Cheque', 'Bounced', 'Deposited',
            'Emi/Advances/Part Payment', System.today(), Date.newInstance(2021, 12, 20), 4321
        );
        insert col;

        Nucleus_Reciept__c ncr = new Nucleus_Reciept__c(
            chargeType__c = col.Nature_of_Collection__c,
            Reciept_Number__c = '123456',
            Application__c = opp.Id,
            Collection__c = col.Id,
            isActive__c = true,
            amount__c = col.Amount__c
        );
        insert ncr;

        Test.setMock(HttpCalloutMock.class, new ProcessReceiptMock(200, getSuccessResponseBody()));

        Test.startTest();
        String result = ProcessReceiptService.doPost(col.Id, '');
        Test.stopTest();

        System.assertNotEquals(null, result);
        Nucleus_Reciept__c updatedNcr = [SELECT isActive__c FROM Nucleus_Reciept__c WHERE Id = :ncr.Id];
        System.assertEquals(false, updatedNcr.isActive__c);
    }

