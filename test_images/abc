    private static void putFirstActiveUpdateablePicklistValue(
        SObject recordValue,
        String fieldApiName
    ) {
        Map<String, Schema.SObjectField> fields =
            recordValue.getSObjectType()
            .getDescribe()
            .fields
            .getMap();
        
        if (!fields.containsKey(fieldApiName)) {
            return;
        }
        
        Schema.DescribeFieldResult fieldDescribe =
            fields.get(fieldApiName).getDescribe();
        
        if (!fieldDescribe.isUpdateable()) {
            return;
        }
        
        if (
            fieldDescribe.getType() != Schema.DisplayType.Picklist
            && fieldDescribe.getType() != Schema.DisplayType.MultiPicklist
        ) {
            return;
        }
        
        for (Schema.PicklistEntry picklistValue : fieldDescribe.getPicklistValues()) {
            if (picklistValue.isActive()) {
                recordValue.put(fieldApiName, picklistValue.getValue());
                return;
            }
        }
    }
    
