    private static final String VRM                  = 'VRM';
    private static final String LS_LOGIN_APPROVED    = 'Login Approved';
    private static final String LS_LOGIN_COMPLETE    = 'Login Complete';
    private static final Set<String> LS_FTR_PENDING  = new Set<String>{'Pending', 'Submit Application'};
    private static final Set<String> LS_FY_BUCKETS   = new Set<String>{'Login Complete', 'Pending', 'Submit Application', 'Login Approved'};
    private static final Set<String> LS_VENDOR_PD    = new Set<String>{'In process', 'Login Approved', 'Login Complete'};
