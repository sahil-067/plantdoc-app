                        }
                        denominationList.remove(denominationList.size()-1);
                    }
                    else if(maxDenomination == 300){
                        remainder = math.mod(stampDutyAmount, 300);
                        quotient = stampDutyAmount/300;
                        stampDutyAmount = remainder;
                        if(quotient > 0){
                            count += quotient;
                        }else{
                            count += 1;
                            break;
                        }
                        denominationList.remove(denominationList.size()-1);
                    }
                    else if(maxDenomination == 200){
                        remainder = math.mod(stampDutyAmount, 200);
                        quotient = stampDutyAmount/200;
                        stampDutyAmount = remainder;
                        if(quotient > 0){
                            count += quotient;
                        }else{
                            count += 1;
                            break;
                        }
                        denominationList.remove(denominationList.size()-1);
                    }
                    else if(maxDenomination == 100){
                        remainder = math.mod(stampDutyAmount, 100);
                        quotient = stampDutyAmount/100;
                        stampDutyAmount = remainder;
                        if(quotient > 0){
                            count += quotient;
                        }else{
                            count += 1;
                            break;
                        }
                        denominationList.remove(denominationList.size()-1);
                    }
                    else if(maxDenomination == 50){
                        remainder = math.mod(stampDutyAmount, 50);
                        quotient = stampDutyAmount/50;
                        stampDutyAmount = remainder;
                        if(quotient > 0){
                            count += quotient;
                        }else{
                            count += 1;
                            break;
                        }
                        denominationList.remove(denominationList.size()-1);
                    }
                    else if(maxDenomination == 20){
                        remainder = math.mod(stampDutyAmount, 20);
                        quotient = stampDutyAmount/20;
                        stampDutyAmount = remainder;
                        if(quotient > 0){
                            count += quotient;
                        }else{
                            count += 1;
                            break;
                        }
                        denominationList.remove(denominationList.size()-1);
                    }
                    else if(maxDenomination == 10){
                        remainder = math.mod(stampDutyAmount, 10);
                        quotient = stampDutyAmount/10;
                        stampDutyAmount = remainder;
                        if(quotient > 0){
                            count += quotient;
                        }else{
                            count += 1;
                            break;
                        }
                        denominationList.remove(denominationList.size()-1);
                    }
                }else{
                    stampDutyAmount = 0;
                }
            }
        }
        if(chargeType == true && opp.Coll_State__c == 'Madhya Pradesh'){
