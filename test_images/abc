    // Covers line conditions where PWA Records match your Account PAN Card
    @isTest
    static void testMethodPWA_Coverage(){
        Account acc = [SELECT Id, Pan_Card_No__pc FROM Account LIMIT 1];
        acc.Pan_Card_No__pc = 'PWA123456A';
        update acc;
        
        PWA__c pwa = new PWA__c(PAN_Number__c='PWA123456A');
        insert pwa;
        
        Attachment att = new Attachment(Name='CIBIL.html', ParentId=pwa.Id, Body=Blob.valueOf('test'));
        insert att;
        
        Cibil_Data__c cd = new Cibil_Data__c(PAN_Number__c='PWA123456A', Cibil_Score__c='750');
        insert cd;
        
        Customer__c cus = [Select Id, Customer_Status__c, LoanAppID__c from Customer__c LIMIT 1];
        Opportunity opp = [Select Id from Opportunity LIMIT 1];
        cus.LoanAppID__c = opp.Id;
        
        Map<Id, Customer__c> oldMap = new Map<Id, Customer__c>();
        Customer__c oldCus = cus.clone(true, false, false, false);
        oldCus.Customer_Status__c = 'Pending';
        oldMap.put(oldCus.Id, oldCus);
        
        cus.Customer_Status__c = 'Approved';
        
        Test.startTest();
        CIBILIntegrationTriggerHelper.generateCIBILFromCustomer(new List<Customer__c>{cus}, oldMap);
        Test.stopTest();
        
        System.assertEquals('Approved', cus.Customer_Status__c);
    }
    
