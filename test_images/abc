@isTest
public class ProcessReceiptStep2Test {
    
    // =======================================================================
    // 1. HTTP Callout Mock Class
    // =======================================================================
    private class MockHttpResponse implements HttpCalloutMock {
        String responseBody;
        Integer statusCode;

        public MockHttpResponse(String responseBody, Integer statusCode) {
            this.responseBody = responseBody;
            this.statusCode = statusCode;
        }

        public HTTPResponse respond(HTTPRequest req) {
            HttpResponse res = new HttpResponse();
            res.setHeader('Content-Type', 'application/json');
            res.setBody(responseBody);
            res.setStatusCode(statusCode);
            return res;
        }
    }

    // =======================================================================
    // 2. Setup Test Data
    // =======================================================================
    @testSetup
    static void setupTestData() {
        // Setup Account (Required for standardized Opportunities)
        Account acc = new Account(Name = 'Test Account for Queueable');
        insert acc;

        // Setup Opportunity
        Opportunity opp = new Opportunity(
            Name = 'Test Opp',
            AccountId = acc.Id,
            StageName = 'Closed Won',
            CloseDate = Date.today(),
            Finnone_Loan_Id__c = 'LN1234567890'
        );
        insert opp;

        // Setup Collection 1: For Creation Scenario 
        // Note: Using single-digit month/day to cover 'day <= 9' padding logic
        Collection__c colCreate = new Collection__c(
            Opportunity__c = opp.Id,
            Nature_of_Collection__c = 'Emi/Advances/Part Payment',
            Status__c = 'Receipted', // Will trigger Creation
            Instrument__c = 'Cash',
            Date_of_Collection__c = Date.newInstance(2024, 5, 5) 
        );
        insert colCreate;

        // Setup Collection 2: For Cancellation Scenario
        // Note: Using double-digit month/day to cover the else 'day > 9' condition
        Collection__c colCancel = new Collection__c(
            Opportunity__c = opp.Id,
            Nature_of_Collection__c = 'Pre-EMI',
            Status__c = 'Cancelled', // Will trigger Cancellation
            Instrument__c = 'Cash',
            Date_of_Collection__c = Date.newInstance(2024, 11, 15),
            transactionReferenceNumber__c = '987654321'
        );
        insert colCancel;
    }
    
    // =======================================================================
    // 3. Test Methods
    // =======================================================================
    
    @isTest
    static void testExecuteCreationSuccess() {
        Opportunity opp = [SELECT Id, Finnone_Loan_Id__c FROM Opportunity LIMIT 1];
        Collection__c col = [SELECT Id, Date_of_Collection__c, Nature_of_Collection__c, Status__c, Instrument__c FROM Collection__c WHERE Status__c = 'Receipted' LIMIT 1];
        
        // JSON block formatted to match the expected 'adhocApex.parse' wrapper result
        String jsonResponse = '{"success": {"transactionReferenceNumber": 12345678}}';
        Test.setMock(HttpCalloutMock.class, new MockHttpResponse(jsonResponse, 200));

        Test.startTest();
        ProcessReceiptStep2 queueableJob = new ProcessReceiptStep2(col.Id, col, opp, 'mock-access-token', 'success');
        System.enqueueJob(queueableJob);
        Test.stopTest();

        // Verification
        Collection__c updatedCol = [SELECT transactionReferenceNumber__c FROM Collection__c WHERE Id = :col.Id];
        System.assertEquals('12345678', updatedCol.transactionReferenceNumber__c, 'Transaction Reference Number should be updated upon success');
        
        List<Adhoc_charges__c> adhocCharges = [SELECT Id, Adhoc_Request__c, Adhoc_Response__c FROM Adhoc_charges__c WHERE Collection__c = :col.Id];
        System.assertEquals(1, adhocCharges.size(), 'One Adhoc_charges__c record should be created.');
    }
    
    @isTest
    static void testExecuteCancellationSuccess() {
        Opportunity opp = [SELECT Id, Finnone_Loan_Id__c FROM Opportunity LIMIT 1];
        Collection__c col = [SELECT Id, Date_of_Collection__c, Nature_of_Collection__c, Status__c, Instrument__c, transactionReferenceNumber__c FROM Collection__c WHERE Status__c = 'Cancelled' LIMIT 1];
        
        String jsonResponse = '{"status": "Success", "message": "Cancelled Successfully"}';
        Test.setMock(HttpCalloutMock.class, new MockHttpResponse(jsonResponse, 200));

        Test.startTest();
        ProcessReceiptStep2 queueableJob = new ProcessReceiptStep2(col.Id, col, opp, 'mock-access-token', 'success');
        System.enqueueJob(queueableJob);
        Test.stopTest();

        // Verification
        List<Adhoc_charges__c> adhocCharges = [SELECT Id, Adhoc_Request__c, Adhoc_Response__c FROM Adhoc_charges__c WHERE Collection__c = :col.Id];
        System.assertEquals(1, adhocCharges.size(), 'One Adhoc_charges__c record should be created for cancellation path.');
        System.assert(adhocCharges[0].Adhoc_Response__c.contains('Cancelled Successfully'), 'Callout response body mapped incorrectly.');
    }
    
    @isTest
    static void testExecuteCreationException() {
        // Passing null Opportunity object to intentionally trigger a NullPointerException at oplist.Finnone_Loan_Id__c
        Collection__c col = [SELECT Id, Date_of_Collection__c, Nature_of_Collection__c, Status__c, Instrument__c FROM Collection__c WHERE Status__c = 'Receipted' LIMIT 1];
        Test.setMock(HttpCalloutMock.class, new MockHttpResponse('{}', 200));

        Test.startTest();
        ProcessReceiptStep2 queueableJob = new ProcessReceiptStep2(col.Id, col, null, 'mock-access-token', 'success');
        System.enqueueJob(queueableJob);
        Test.stopTest();

        // Verification: Catch block should insert an Adhoc_charges__c with the error message logged
        List<Adhoc_charges__c> adhocCharges = [SELECT Id, Adhoc_Response__c FROM Adhoc_charges__c];
        System.assert(!adhocCharges.isEmpty(), 'Error Adhoc charge record should be created inside the catch block');
        System.assert(adhocCharges[0].Adhoc_Response__c.contains('Error Line Number'), 'System exception message not caught correctly');
    }

    @isTest
    static void testExecuteCancellationException() {
        Opportunity opp = [SELECT Id, Finnone_Loan_Id__c FROM Opportunity LIMIT 1];
        Collection__c col = [SELECT Id, Date_of_Collection__c, Nature_of_Collection__c, Status__c, Instrument__c, transactionReferenceNumber__c FROM Collection__c WHERE Status__c = 'Cancelled' LIMIT 1];
        
        // Introduce TypeException intentionally by breaking Integer.valueOf(collist.transactionReferenceNumber__c)
        col.transactionReferenceNumber__c = 'ALPHABETICAL_STRING'; 
        Test.setMock(HttpCalloutMock.class, new MockHttpResponse('{}', 200));

        Test.startTest();
        ProcessReceiptStep2 queueableJob = new ProcessReceiptStep2(col.Id, col, opp, 'mock-access-token', 'success');
        System.enqueueJob(queueableJob);
        Test.stopTest();

        // Verification: Cancellation catch block should trigger
        List<Adhoc_charges__c> adhocCharges = [SELECT Id, Adhoc_Response__c FROM Adhoc_charges__c];
        System.assert(!adhocCharges.isEmpty(), 'Error record should be created for cancellation failure');
        System.assert(adhocCharges[0].Adhoc_Response__c.contains('Error Line Number'), 'System exception message not caught correctly');
    }
    
    @isTest
    static void testExecuteFailedStrCheck() {
        Opportunity opp = [SELECT Id, Finnone_Loan_Id__c FROM Opportunity LIMIT 1];
        Collection__c col = [SELECT Id, Date_of_Collection__c, Nature_of_Collection__c, Status__c, Instrument__c FROM Collection__c WHERE Status__c = 'Receipted' LIMIT 1];
        
        Test.startTest();
        // Send a parameter that DOES NOT contain "success" in `strCheck`
        ProcessReceiptStep2 queueableJob = new ProcessReceiptStep2(col.Id, col, opp, 'mock-access-token', 'RandomFailureString');
        System.enqueueJob(queueableJob);
        Test.stopTest();

        // Verification: Code should skip everything. Nothing should be created.
        List<Adhoc_charges__c> adhocCharges = [SELECT Id FROM Adhoc_charges__c];
        System.assertEquals(0, adhocCharges.size(), 'Logic gate bypassed incorrectly. No Adhoc charge should be inserted.');
    }
    
    @isTest
    static void testExecuteWithEmptyAdhocParse() {
        Opportunity opp = [SELECT Id, Finnone_Loan_Id__c FROM Opportunity LIMIT 1];
        Collection__c col = [SELECT Id, Date_of_Collection__c, Nature_of_Collection__c, Status__c, Instrument__c FROM Collection__c WHERE Status__c = 'Receipted' LIMIT 1];
        
        // Mock a response that DOES NOT contain the exact payload, meaning successWrapperList will evaluate as null
        String jsonResponse = '{"error": "Unauthorized / Bad Request"}';
        Test.setMock(HttpCalloutMock.class, new MockHttpResponse(jsonResponse, 400));

        Test.startTest();
        ProcessReceiptStep2 queueableJob = new ProcessReceiptStep2(col.Id, col, opp, 'mock-access-token', 'success');
        System.enqueueJob(queueableJob);
        Test.stopTest();

        // Verification: Ensuring the inner null check behaves correctly and bypasses Assignment gracefully
        Collection__c updatedCol = [SELECT transactionReferenceNumber__c FROM Collection__c WHERE Id = :col.Id];
        System.assertEquals(null, updatedCol.transactionReferenceNumber__c, 'Transaction ref shouldn\'t map anything if parse is null/failed.');
        
        List<Adhoc_charges__c> adhocCharges = [SELECT Id, Adhoc_Request__c, Adhoc_Response__c FROM Adhoc_charges__c WHERE Collection__c = :col.Id];
        System.assert(!adhocCharges.isEmpty(), 'A standard adhoc tracking log still needs to be inserted.');
    }
}
