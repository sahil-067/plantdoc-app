        ApexPages.currentPage().getParameters().put('appId', disbRec.Application__c);
        ApexPages.currentPage().getParameters().put('tranch', 'First');

        RunLoanServiceClass runLoan = new RunLoanServiceClass();
        runLoan.loanService(); // Test method execution logic
        Test.stopTest();
    }

