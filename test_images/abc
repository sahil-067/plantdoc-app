    // Method to calculate disbursement LTV After Insert
   public static void calculateDisbursementLTV(List<Disbursement__c> disbursements) {
        if(label.disbursementLTV=='Yes')
  		{
       Date createddateval=date.newInstance(2025,02,18);
            Set<Id> opportunityIds = new Set<Id>();
            for (Disbursement__c disbursement : disbursements) {
                if (disbursement.Application__c != null) {
                    opportunityIds.add(disbursement.Application__c);
                }
            }
            Map<String, Decimal> opMap = new Map<String, Decimal>();
             Map<String, String> opMapName = new Map<String, String>();
            List<Opportunity> opList = [SELECT Id,Name, Sanctioned_Amont__c FROM Opportunity WHERE Id IN :opportunityIds];
            for (Opportunity op : opList) {
                opMap.put(op.Id, op.Sanctioned_Amont__c);
                opMapName.put(op.Id, op.Name);
            }
            Map<Id, Technical_Verification__c> latestTechnicalVerifications = new Map<Id, Technical_Verification__c>();
            for (Technical_Verification__c tv : [
                SELECT Id, Construction_FF_Total_Value__c, lastmodifieddate,Application__c, CreatedDate,Vendor_Request__r.Date_First_Submitted__c
                FROM Technical_Verification__c
                WHERE Application__c IN :opportunityIds AND Status__c = 'Approved'
                ORDER BY CreatedDate  DESC LIMIT 1
            ]) {
                if (!latestTechnicalVerifications.containsKey(tv.Application__c)) {
                    latestTechnicalVerifications.put(tv.Application__c, tv);
                }
            }
            System.debug('latestTechnicalVerifications'+latestTechnicalVerifications);
        
            List<Disbursement__c> disbursementsToUpdate = new List<Disbursement__c>();
        
            for (Disbursement__c disbursement : disbursements) {
                if(disbursement.CreatedDate>=createddateval)
                {
                String opName=opMapName.get(disbursement.Application__c);
                if(!opName.containsIgnoreCase('Cloned'))
                {     
                 if(latestTechnicalVerifications.size()<=0)
               {
                    disbursement.Disb_Status__c.addError('Disbursement Not allowed as Technical is not approved within 90 days.');
                   break;
               }
                if (disbursement.Application__c != null && latestTechnicalVerifications.containsKey(disbursement.Application__c)) {
                    Technical_Verification__c latestTV = latestTechnicalVerifications.get(disbursement.Application__c);
                    Decimal constructionFFTotalValue = latestTV.Construction_FF_Total_Value__c;
                  
                     DateTime latestVerificationDate = latestTV.Vendor_Request__r.Date_First_Submitted__c;//CreatedDate;
                          

                    if (latestVerificationDate < System.now().addDays(-90)) {
                        disbursement.Disb_Status__c.addError('Disbursement Not allowed as Technical is not approved within 90 days.');
                        continue; // Skip further calculations for this disbursement
                    }
        
                    if (constructionFFTotalValue != null) {
                        if (disbursement.tranch_details__c == 'First') {
                            Decimal TmpLtv=(disbursement.Disbursement_Amount__c / constructionFFTotalValue) * 100;
                            Decimal tempval=TmpLtv*disbursement.Disbursement_Amount__c;
                            Decimal tempval1=opMap.get(disbursement.Application__c);
                            System.debug('Temp LTV'+TmpLtv.setScale(2, RoundingMode.HALF_UP));
                             disbursement.disbursement_LTV__c = TmpLtv.setScale(2, RoundingMode.HALF_UP);
                            if((tempval.setScale(2, RoundingMode.HALF_UP))>(tempval1.setScale(2, RoundingMode.HALF_UP)))
                                {
                                   // disbursement.addError('Disbursement Amount Can not Greater Than Sanctioned Amount! '+(disbursement.Disbursement_Amount__c*TmpLtv).setScale(2, RoundingMode.HALF_UP)+' Disbursement Amount is Max Limit');
                                }
                            else
                            {
                                // Condition 1: First Tranch
                            disbursement.disbursement_LTV__c = TmpLtv; // Convert to percentage
                            }
                            
                        } 
                        else if (disbursement.tranch_details__c == 'Subsequent') {
                            // Condition 2: Subsequent Tranch
                            Decimal totalPreviousDisbursedAmount = 0;
        
                            // Sum of all previous Disbursements related to the same Opportunity
                            for (Disbursement__c previousDisb : [
                                SELECT Disbursement_Amount__c 
                                FROM Disbursement__c 
                                WHERE Application__c = :disbursement.Application__c 
                                AND Id != :disbursement.Id AND disb_Status__c!='Cancelled'
                            ]) {
                                totalPreviousDisbursedAmount += previousDisb.Disbursement_Amount__c;
                            }
                            Decimal tempLtv=((totalPreviousDisbursedAmount + disbursement.Disbursement_Amount__c) / constructionFFTotalValue) * 100;
                               Decimal tempval2=opMap.get(disbursement.Application__c); 
                            Decimal tmpvall=totalPreviousDisbursedAmount*tempLtv;
                             disbursement.disbursement_LTV__c = tempLtv;
                             System.debug('Temp LTV Sub'+tempLtv.setScale(2, RoundingMode.HALF_UP));
                             disbursement.disbursement_LTV__c = tempLtv; 
                            if((tmpvall.setScale(2, RoundingMode.HALF_UP))>(tempval2.setScale(2, RoundingMode.HALF_UP)))
                                {
                                    //disbursement.addError('Disbursement Amount Can not Greater Than Sanctioned Amount! '+totalPreviousDisbursedAmount*tempLtv+' Disbursement Amount is Max Limit');
                                }
                            else
                            {
                                 // Calculate LTV for Subsequent Tranch and convert to percentage
                          //  disbursement.disbursement_LTV__c = tempLtv; 
                            }
                           
                        }
                        // Add to list of disbursements to update
                        disbursementsToUpdate.add(disbursement);
                    }
                }
                     }
            }
        }
            system.debug('disbursementsToUpdate'+disbursementsToUpdate);
    
       }
