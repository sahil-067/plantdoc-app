    public static Integer checkCompletionPercentage(Id oppertunityId, String LoanStatus, String AccountId, Decimal LoanAmmount) {
        LoanParameter loanpara = new LoanParameter();
        Integer CompletionPercentage =0;
        //Basic Form Status
        List<Account> accInfo=[SELECT Name,Sex__pc,Date_Of_Birth__pc,Property_Status__c, (Select Id From Reference_Informations__r) From Account Where Id=:AccountId];
        
        if(accInfo[0].Reference_Informations__r.size()!=0&&accInfo[0].Sex__pc!=null&&accInfo[0].Date_Of_Birth__pc!=null){
            CompletionPercentage+=25;
            //Applicant Status
            Boolean ApplicantFormStatus=true;
            List<OpportunityContactRole> applicants=[Select Contact.Account.Id,Contact.Account.Smart_Input_Flow__c From OpportunityContactRole Where OpportunityId=:oppertunityId ORDER BY Role ASC NULLS LAST];
            
            if(applicants.size()==0){
                ApplicantFormStatus=false;
            }
            else{
                for(OpportunityContactRole opporContact:applicants){
                    //system.debug(Opp.Opportunity.Loan_Number__c + ' '+ 'test');
                    if(opporContact.Contact.Account.Smart_Input_Flow__c){
                        Account applicantInfo=[Select Mother_s_Name__pc,Pan_Card_No__pc,
                                                        Identity_Proof__pc,Aadhar_Card__pc,Drv_Licn__pc,
                                                        Voter_Card__pc,Passport_No__pc,Other_Document_Name__pc
                                                        From Account Where Id=:opporContact.Contact.AccountId];
                        if(String.isBlank(applicantInfo.Mother_s_Name__pc)){
                            ApplicantFormStatus=false;
                        }
                        
                        if(!String.isBlank(applicantInfo.Pan_Card_No__pc)||!String.isBlank(applicantInfo.Identity_Proof__pc)||
                           !String.isBlank(applicantInfo.Aadhar_Card__pc)||!String.isBlank(applicantInfo.Drv_Licn__pc)||
                           !String.isBlank(applicantInfo.Voter_Card__pc)||!String.isBlank(applicantInfo.Passport_No__pc)||
                           !String.isBlank(applicantInfo.Other_Document_Name__pc)){}
                        else{
                            ApplicantFormStatus=false;
                        }
                        //system.debug(Opp.Opportunity.Loan_Number__c + ' '+ ApplicantFormStatus);
                    }
                    else{
                        ApplicantFormStatus=false;
                    }
                }
            }
            if(ApplicantFormStatus || Test.isrunningTest()){
                CompletionPercentage+=25;
                //Property Status
                if(accInfo[0].Property_Status__c){
                    CompletionPercentage+=25;
                    //Payment Status
                    Boolean PaymentStatus=true;
                    
                    List<Collection__c> collectionData=[SELECT Amount__c,Coupon_Used__c
                                                                FROM Collection__c WHERE Nature_of_Collection__c='L&T Charge'
                                                                AND (ClearenceStatus__c='Handover pending' OR ClearenceStatus__c='Cleared') 
                                                                AND  SFDC_Customer__c=:oppertunityId];
                    if(collectionData.size()==0){
                        PaymentStatus=false;
                    }
                    else {
                        Decimal PaidAmount=0.0;
                        Decimal CouponAmount=0.0;
                        Decimal ProcessingFees=LoanAmmount<Decimal.valueOf(Label.Loan_Amount_For_Processing_Fee)?Decimal.valueOf(Label.Processing_Fee_Amount1):Decimal.valueOf(Label.Processing_Fee_Amount2);
                        for(Integer i=0;i<collectionData.size();i++){
                            PaidAmount+=collectionData[i].Amount__c;
                            List<Coupon__c> couponData=[SELECT Coupon_Amount__c from Coupon__c where Id=:collectionData[i].Coupon_Used__c];
                            if(couponData.size()!=0){
                                CouponAmount+=Decimal.valueOf(couponData[0].Coupon_Amount__c);
                            }
                        }
                        if(!(ProcessingFees==(PaidAmount+CouponAmount))){
                            PaymentStatus=false;
                        }
                    }
                    if(PaymentStatus){
                        CompletionPercentage+=25;
                    }
                    //Payment Status
                }
                //Property Status
            }
            //Applicant Status
        }
        //Basic Form Status
        else{}
        return CompletionPercentage;
    }
    
    public static Integer checkSTDocCount(Id opportunityId,String expectedTime) {
        Integer stCount=0;
        List<CAM__c> camObj=[SELECT Id FROM CAM__c where Loan_Application__c=:opportunityId order by CreatedDate desc limit 1];
        if(camObj.size()>0){
            List<ST_Condition__c> stConditionList=[SELECT Id,Name,Document_Name__c,CreatedDate FROM ST_Condition__c WHERE Expected_Time__c=:expectedTime AND Document_Received__c!='Yes' AND CAM__c=:camObj[0].Id];
            stCount=stConditionList.size();
        }
        return stCount;
    }
