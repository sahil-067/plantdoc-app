    private static void runScenario(
        CAM__c cam,
        Id branchId,
        String occ,
        String loanType,
        Boolean highExposure,
        Boolean selfOccupied,
        Integer highestIncomeIdx
    ) {
        cam.Branch__c = branchId;
        cam.Occupation__c = occ;
        cam.Occ_2__c = occ;
        cam.Occ_3__c = occ;
        cam.Occ_4__c = occ;
        // Uncomment the line below ONLY if CAM_Profile__c is a writable field (not a formula):
        // cam.CAM_Profile__c = occ;
        cam.Loan_Type__c = loanType;
        cam.Property_is_self_occupied_residential_pr__c = selfOccupied;

        if (highExposure) {
            cam.Existing_Loan_Amount__c = 400000;
            cam.LnApp__c = 400001;
        } else {
            cam.Existing_Loan_Amount__c = 100000;
            cam.LnApp__c = 100000;
        }

        cam.Income__c   = (highestIncomeIdx == 1) ? 100000 : 10000;
        cam.Income_2__c = (highestIncomeIdx == 2) ? 100000 : 10000;
        cam.Income_3__c = (highestIncomeIdx == 3) ? 100000 : 10000;
        cam.Income_4__c = (highestIncomeIdx == 4) ? 100000 : 10000;

        update cam;

        PageReference pageRef = Page.GenerateROI;
        pageRef.getParameters().put('id', String.valueOf(cam.Id));
        Test.setCurrentPage(pageRef);

        GenerateROI ctrl = new GenerateROI(new ApexPages.StandardController(cam));
        ctrl.generate();
        ctrl.doMappingPage();
    }

    @isTest
    static void testSalariedBranchB_AllScenarios() {
        Branch__c branchB = [SELECT Id FROM Branch__c WHERE Branch_Category__c = 'B' LIMIT 1];
        Opportunity lapp = [SELECT Id, Loan_Type__c FROM Opportunity LIMIT 1];
        CAM__c cam = [SELECT Id FROM CAM__c LIMIT 1];

        // Baseroi < 15.00 so all variance queries + all 4 Bureau income branches run
        insert new Base_Rate__c(
            Base_ROI__c = 10,
            Branch_Category_New__c = 'B',
            Branch_Category__c = 'B',
            Condition1__c = 0,
            Condition_2__c = 99999999,
            Combined_Exposure_Start__c = '0 Lakhs',
            Combined_Exposure_End__c = '100 Lakhs',
            Loan_Type__c = lapp.Loan_Type__c,
            Profile__c = 'Salaried'
        );

        Test.startTest();
        runScenario(cam, branchB.Id, 'Salaried', 'Home Loan (HL)', false, true,  1);
        runScenario(cam, branchB.Id, 'Salaried', 'LAP',            false, false, 2);
        runScenario(cam, branchB.Id, 'Salaried', 'Home Loan (HL)', true,  true,  3);
        runScenario(cam, branchB.Id, 'Salaried', 'LAP',            true,  false, 4);
        Test.stopTest();
    }

