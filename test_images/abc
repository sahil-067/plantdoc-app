    /**
     * Credit Trajectory: CIBIL score of every applicant related to the
     * Application. Application -> Customer__c (LoanAppID__c) ->
     * Accounts (Household__c), plus Application.Household__c.
     * Main Applicant is listed first.
     * Read-only.
     */
    @AuraEnabled(cacheable=true)
    public static List<CreditTrajectoryData> getCreditTrajectory(Id applicationId) {
        List<CreditTrajectoryData> result = new List<CreditTrajectoryData>();

        if (applicationId == null) {
            return result;
        }

        Set<Id> customerIds = new Set<Id>();
        for (Customer__c cust : [
            SELECT Id
            FROM Customer__c
            WHERE LoanAppID__c = :applicationId
        ]) {
            customerIds.add(cust.Id);
        }

        /*
         * Fallback / union: the console's Applicants tab already resolves
         * applicants through Application.Household__c, so include it too.
         * This keeps Credit Trajectory consistent with the Applicants tab
         * even when no Customer__c record points back via LoanAppID__c.
         */
        for (Opportunity appRow : [
            SELECT Household__c
            FROM Opportunity
            WHERE Id = :applicationId
            LIMIT 1
        ]) {
            if (appRow.Household__c != null) {
                customerIds.add(appRow.Household__c);
            }
        }

        if (customerIds.isEmpty()) {
            return result;
        }

        List<CreditTrajectoryData> others = new List<CreditTrajectoryData>();

        for (Account acc : [
            SELECT Id, Name, RecordType.Name, CIBIL_Score__pc
            FROM Account
            WHERE Household__c IN :customerIds
            ORDER BY Name ASC
            LIMIT 200
        ]) {
            CreditTrajectoryData row = new CreditTrajectoryData();
            row.id = acc.Id;
            row.role = acc.RecordType.Name;
            row.applicantName = acc.Name;
            row.cibilScore = acc.CIBIL_Score__pc == null
                ? null : String.valueOf(acc.CIBIL_Score__pc);

            if (row.role != null && row.role.containsIgnoreCase('Main Applicant')) {
                result.add(row);
            } else {
                others.add(row);
            }
        }

        result.addAll(others);
        return result;
    }

