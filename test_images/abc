    public static void qcAssignmentWhenDisbursmentStatusChange(List<Disbursement__c> dmList, Map<Id, Disbursement__c> oldMap){
        System.debug('inDisbursementUpdateHandler');
        Set<Id> appIdSet = new Set<Id>();
        Set<Id> custIdSet = new Set<Id>();
        Map<String, String> mapAppIdDistStatus = new Map<String, String>();
        for(Disbursement__c ds : dmList){
            if( oldMap != null && (ds.Disb_Status__c != oldMap.get(ds.Id).Disb_Status__c || ds.Tranch_Details__c != oldMap.get(ds.Id).Tranch_Details__c ) && ds.Tranch_Details__c == 'First' && (ds.Disb_Status__c == 'Payment Under Process' || ds.Disb_Status__c == 'Payment Processed')){
                appIdSet.add(ds.Application__c);
                mapAppIdDistStatus.put(ds.Application__c, ds.Disb_Status__c );
            }
            else if(oldMap == null && ds.Tranch_Details__c == 'First' && (ds.Disb_Status__c == 'Payment Under Process' || ds.Disb_Status__c == 'Payment Processed')){
                appIdSet.add(ds.Application__c);
                mapAppIdDistStatus.put(ds.Application__c, ds.Disb_Status__c );
            }
        }
        
        if(!appIdSet.isEmpty()){
            
            List<Opportunity> oppList = [SELECT Id, CmitDisAmt__c, Disbursed_Amount__c, Household__c FROM Opportunity WHERE Id IN : appIdSet];
            for(Opportunity opp : oppList){
                if(opp.Household__c != null){
                    custIdSet.add(opp.Household__c);
                }
            }
            
            Map<Id, Customer__c> appIdMap = new  Map<Id, Customer__c>([SELECT Id,Name, Disbursement_QC_Assign_to__c, Physical_file_QC_assign_to__c, SFDC_Loan_App_ID__c FROM Customer__c WHERE Id IN : custIdSet]);
            List<Customer__c> custForPhysicalAssignList = new List<Customer__c>();
            List<Customer__c> custForDisbursmentAssignList = new List<Customer__c>();
            
            for(Opportunity opp : oppList){
                if(opp.Household__c != null &&  mapAppIdDistStatus.get(opp.Id) == 'Payment Processed'){
                    custForPhysicalAssignList.add(appIdMap.get(opp.Household__c));
                }
                else if(opp.Household__c != null &&  mapAppIdDistStatus.get(opp.Id) == 'Payment Under Process' && (opp.CmitDisAmt__c > 0 || opp.Disbursed_Amount__c > 0)){
                    custForDisbursmentAssignList.add(appIdMap.get(opp.Household__c));
                }
            }
            
            if(!custForPhysicalAssignList.isEmpty()){
                QC_PhysicalChecklistAssignmentRule.QC_PhysicalAssignment(custForPhysicalAssignList);
            }
            
            if(!custForDisbursmentAssignList.isEmpty()){
