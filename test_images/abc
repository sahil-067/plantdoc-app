    // ═════════════════════════════════════════════════════════════
    //  1. GET CASES FOR DASHBOARD
    //  Opportunity  = loan application record
    //  Account      = applicant (Account.Name, Account.Type)
    //
    //  Returns every application that falls in at least one ribbon
    //  bucket; each row carries a flag per bucket:
    //    MTD / FTD Sanction  — CAM: First Sanctioned this month / today,
    //                          Case approved by != Restructuring,
    //                          Final Decision = Approved or blank
    //    Bucket 4.2          — Loan Status = Login Complete, created this FY
    //    Bucket 4.1          — Loan Status = Pending / Submit Application, created this FY
    //    Today / Month FTR   — Customer First Login Approval Date today / this month
    //    Bucket 4.0          — Loan Status = Login Approved, Login Status = Approved, BM PD not done, created this FY
    //    Bucket 5.0          — Loan Status = Login Approved, BM PD done, created this FY
    //    Vendor PD           — Vendor PD report requested this month,
    //                          Loan Status = In process / Login Approved / Login Complete
    //  All buckets: Case Origination System = VRM
    // ═════════════════════════════════════════════════════════════
    @AuraEnabled(cacheable=false)
    public static String getCasesForDashboard() {
        try {
            Date today = Date.today();
            Integer fyStartMonth = [SELECT FiscalYearStartMonth FROM Organization LIMIT 1].FiscalYearStartMonth;
            Date fyStart = Date.newInstance(today.month() >= fyStartMonth ? today.year() : today.year() - 1, fyStartMonth, 1);

            // MTD / FTD Sanction — counted per CAM record, like the report;
            // amount is the application's Sanctioned Amount
            Map<Id, Integer> mtdSancCount  = new Map<Id, Integer>();
            Map<Id, Integer> ftdSancCount  = new Map<Id, Integer>();
            for (CAM__c cam : [
                SELECT Loan_Application__c, First_Sanctioned_Date__c
                FROM CAM__c
                WHERE First_Sanctioned_Date__c = THIS_MONTH
                  AND Loan_Application__c != null
                  AND Loan_Application__r.Household__r.Case_Oringination_System__c = :VRM
                  AND Case_approved_by__c != :CASE_APPROVED_BY_EXCL
                  AND (Final_Decision__c = 'Approved' OR Final_Decision__c = null)
            ]) {
                Id oppId = cam.Loan_Application__c;
                mtdSancCount.put(oppId, (mtdSancCount.containsKey(oppId) ? mtdSancCount.get(oppId) : 0) + 1);
                if (cam.First_Sanctioned_Date__c.date() == today) {
                    ftdSancCount.put(oppId, (ftdSancCount.containsKey(oppId) ? ftdSancCount.get(oppId) : 0) + 1);
                }
            }

            // Vendor PD — counted per Vendor Request record, like the report;
            // the latest request per application feeds the Vendor PD columns
            Map<Id, Integer> vendorPdCount = new Map<Id, Integer>();
            Map<Id, Vendor_Request__c> vendorPdLatest = new Map<Id, Vendor_Request__c>();
            for (Vendor_Request__c vr : [
                SELECT Application__c, Name, Date_Requested__c, Date_Recevied__c,
                       Report_Type__c, Vendor_PD_Report_status__c, Status__c
                FROM Vendor_Request__c
                WHERE Request_Type__c = :VENDOR_PD_REQ_TYPE
                  AND Date_Requested__c = THIS_MONTH
                  AND Application__c != null
                  AND Application__r.Household__r.Case_Oringination_System__c = :VRM
                  AND Application__r.LM_Loan_Status__c IN :LS_VENDOR_PD
                ORDER BY CreatedDate DESC
            ]) {
                Id oppId = vr.Application__c;
                vendorPdCount.put(oppId, (vendorPdCount.containsKey(oppId) ? vendorPdCount.get(oppId) : 0) + 1);
                if (!vendorPdLatest.containsKey(oppId)) vendorPdLatest.put(oppId, vr);
            }

            Set<Id> extraOppIds = new Set<Id>();
            extraOppIds.addAll(mtdSancCount.keySet());
            extraOppIds.addAll(vendorPdCount.keySet());

            List<Opportunity> loans = [
                SELECT Id, Name,
                       Household__c,
                       Household__r.OwnerId,
                       Household__r.Owner.Name,
                       Household__r.Assigned_VCM__c,
                       Household__r.Assigned_VCM__r.Name,
                       Household__r.VCM_Status__c,
                       Household__r.First_Login_Approval_Date__c,
                       Household__r.Customer_Status__c,
                       Household__r.Case_Oringination_System__c,
                       Household__r.Sales_v2__c,
                       Household__r.ED_FPR_Person_Name__c,
                       Account.Name,
                       Account.Designation_Occupation__c,
                       Account.Bureau_Flag__c,
                       Account.EKYC_Completed__c,
                       LM_Loan_Status__c,
                       Loan_Amount_Applied__c,
                       Purpose_of_loan__c,
                       StageName,
                       OwnerId, Owner.Name,
                       LO__r.Name,
                       Loan_Number__c, Loan_Product__c, Loan_Product__r.Name,
                       Branch__r.Name, Branch__r.Zone__c,
                       Risk_Weight__c, LTV__c,
                       Login_Date__c, BM_PD_Done__c,
                       Sanctioned_Amont__c, DateLogin__c, Lo_Submitted_Date__c,
                       CreatedDate
                FROM Opportunity
                WHERE Id IN :extraOppIds
                   OR (Household__r.Case_Oringination_System__c = :VRM
                       AND ((LM_Loan_Status__c IN :LS_FY_BUCKETS AND CreatedDate = THIS_FISCAL_YEAR)
                            OR Household__r.First_Login_Approval_Date__c = THIS_MONTH))
                ORDER BY CreatedDate ASC
            ];

            // Main Applicant state per Customer__c: Residential State, else Communication State
            Set<Id> householdIds = new Set<Id>();
            for (Opportunity l : loans) {
                if (l.Household__c != null) householdIds.add(l.Household__c);
            }
            Map<Id, String> mainApplicantState = new Map<Id, String>();
            Map<Id, String> mainApplicantCity  = new Map<Id, String>();
            for (Account a : [
                SELECT Household__c, Residential_State__c, Communication_State__pc, Communication_City__pc
                FROM Account
                WHERE Household__c IN :householdIds AND RecordType.DeveloperName = 'Main_Applicant'
            ]) {
                mainApplicantState.put(a.Household__c, String.isNotBlank(a.Residential_State__c)
                                                         ? a.Residential_State__c
                                                         : a.Communication_State__pc);
                mainApplicantCity.put(a.Household__c, a.Communication_City__pc);
            }

            List<CaseRow> rows = new List<CaseRow>();

            for (Opportunity l : loans) {
                CaseRow r         = new CaseRow();
                r.id              = l.Id;
                r.leadId          = l.Loan_Number__c;
                r.loanNumber      = l.Name;
                // Customer (Account) → Applicant Name + Occupation/Designation
                r.applicantName   = l.Account != null ? l.Account.Name : '';
                r.applicantType   = l.Account != null ? l.Account.Designation_Occupation__c : '';
                r.applicantState  = mainApplicantState.get(l.Household__c);
                r.applicantCity   = mainApplicantCity.get(l.Household__c);
                // Application → Applied Amount
                r.amount          = l.Loan_Amount_Applied__c != null ? l.Loan_Amount_Applied__c.longValue() : 0;
                // Application → Loan Product
                r.product         = l.Loan_Product__c != null ? l.Loan_Product__r.Name : '';
                // Application → Branch Name; Branch → Zone (Bra_State__c)
                r.branch          = l.Branch__r != null ? l.Branch__r.Name : '';
                r.region          = l.Branch__r != null && l.Branch__r.Zone__c != null ? l.Branch__r.Zone__c.toUpperCase() : '';
                // Application → Purpose of Loan
                r.appType         = l.Purpose_of_loan__c;
                Datetime finalApprDate = l.Household__r != null ? l.Household__r.First_Login_Approval_Date__c : null;
                if(finalApprDate != null)
                	r.finalApprovalDate = finalApprDate.date();
                
                String vcmSt      = l.Household__r != null ? l.Household__r.VCM_Status__c : null;
                r.status          = finalApprDate != null
                                        ? 'COMPLETED'
                                        : (String.isNotBlank(vcmSt) ? normaliseVcmStatus(vcmSt) : normaliseStatus(l.StageName));
                r.priority        = 'NA';//'MEDIUM';
                // Opportunity → LTV (Applied Amount / Property Value, stored on Opp)
                r.ltv             = l.LTV__c != null ? l.LTV__c.intValue() : 0;
                r.riskScore       = parseRiskWeight(l.Risk_Weight__c);
                // Assigned To: VCM if set on Customer__c, else Customer__c owner
                if (l.Household__r != null && l.Household__r.Assigned_VCM__c != null) {
                    r.assignedTo  = l.Household__r.Assigned_VCM__r != null ? l.Household__r.Assigned_VCM__r.Name : null;
                    r.assigneeId  = l.Household__r.Assigned_VCM__c;
                } else if (l.Household__r != null) {
                    r.assignedTo  = l.Household__r.Owner != null ? l.Household__r.Owner.Name : null;
                    r.assigneeId  = l.Household__r.OwnerId;
                } else {
                    r.assignedTo  = null;
                    r.assigneeId  = null;
                }
                r.householdId     = l.Household__c;
                r.assignedVcmId   = l.Household__r != null ? l.Household__r.Assigned_VCM__c : null;
                r.ageDays         = (l.Login_Date__c != null ? l.Login_Date__c : l.CreatedDate.date()).daysBetween(today);
                // Last 3 cols: BM PD (Opportunity), No Bureau (Account), eKYC (Account)
                r.bmVisitRequired = l.BM_PD_Done__c;
                r.noBureau        = l.Account != null ? l.Account.Bureau_Flag__c : false;
                r.eKycFailed      = l.Account == null || l.Account.EKYC_Completed__c != 'Yes';
                r.loanStatus      = l.LM_Loan_Status__c;

                // Ribbon buckets
                Boolean inScope   = l.Household__r != null
                                    && l.Household__r.Case_Oringination_System__c == VRM;
                Boolean inFy      = l.CreatedDate.date() >= fyStart;
                // First_Login_Approval_Date__c is Date/Time in prod (Date in some sandboxes) — go via Datetime
                Date ftrDate      = finalApprDate != null ? finalApprDate.date() : null;
                String ls         = l.LM_Loan_Status__c;
                r.bucket40        = inScope && inFy && ls == LS_LOGIN_APPROVED && !l.BM_PD_Done__c
                                    && l.Household__r.Customer_Status__c == 'Approved';
                r.bucket50        = inScope && inFy && ls == LS_LOGIN_APPROVED && l.BM_PD_Done__c;
                r.bucket41        = inScope && inFy && LS_FTR_PENDING.contains(ls);
                r.bucket42        = inScope && inFy && ls == LS_LOGIN_COMPLETE;
                r.todayFtr        = inScope && ftrDate == today;
                r.monthFtr        = inScope && ftrDate != null && ftrDate.year() == today.year() && ftrDate.month() == today.month();
                r.sanctionedAmount  = l.Sanctioned_Amont__c != null ? l.Sanctioned_Amont__c : 0;
                r.mtdSanctionCount  = mtdSancCount.containsKey(l.Id)  ? mtdSancCount.get(l.Id)  : 0;
                r.mtdSanctionAmount = r.mtdSanctionCount > 0 ? r.sanctionedAmount : 0;
                r.ftdSanctionCount  = ftdSancCount.containsKey(l.Id)  ? ftdSancCount.get(l.Id)  : 0;
                r.ftdSanctionAmount = r.ftdSanctionCount > 0 ? r.sanctionedAmount : 0;
                r.vendorPdCount     = vendorPdCount.containsKey(l.Id) ? vendorPdCount.get(l.Id) : 0;

                // Per-tab columns
                r.loName            = l.LO__r != null ? l.LO__r.Name : null;
                r.salesCoordinator  = l.Household__r != null ? l.Household__r.Sales_v2__c : null;
                r.edFprPersonName   = l.Household__r != null ? l.Household__r.ED_FPR_Person_Name__c : null;
                r.dateOfLogin       = l.DateLogin__c;
                r.loSubmittedTat    = l.Lo_Submitted_Date__c != null ? l.Lo_Submitted_Date__c.date().daysBetween(today) : null;
                r.firstLoginApprovalTat = ftrDate != null ? ftrDate.daysBetween(today) : null;
                Vendor_Request__c vr = vendorPdLatest.get(l.Id);
                if (vr != null) {
                    r.vendorRequestName     = vr.Name;
                    r.vendorDateRequested   = vr.Date_Requested__c;
                    r.vendorDateReceived    = vr.Date_Recevied__c;
                    r.vendorReportType      = vr.Report_Type__c;
                    r.vendorPdReportStatus  = vr.Vendor_PD_Report_status__c;
                    r.vendorStatus          = vr.Status__c;
                }
                rows.add(r);
            }
            return JSON.serialize(rows);

        } catch (Exception e) {
            throw new AuraHandledException('getCasesForDashboard: ' + e.getMessage());
        }
    }

    // ═════════════════════════════════════════════════════════════
    //  2. ASSIGN VCM — stores verifier on Customer__c.Assigned_VCM__c
    // ═════════════════════════════════════════════════════════════
    @AuraEnabled
    public static void assignVerifier(String customerId, String verifierUserId, Boolean isEscalated, String vcmStatus) {
        try {
            Customer__c cust = new Customer__c(Id = customerId);
            if (String.isNotBlank(verifierUserId)) {
                cust.Assigned_VCM__c = verifierUserId;
            }
            if (isEscalated == true) {
                cust.Case_Escalated__c = true;
            }
            if (String.isNotBlank(vcmStatus)) {
                cust.VCM_Status__c = vcmStatus;
            }
            update cust;
        } catch (Exception e) {
            throw new AuraHandledException('assignVerifier: ' + e.getMessage());
        }
    }

    // ═════════════════════════════════════════════════════════════
    //  2b. BULK ASSIGN VCM — Manual Allocate multi-select; one DML
    // ═════════════════════════════════════════════════════════════
    @AuraEnabled
    public static void assignVerifierBulk(List<String> customerIds, String verifierUserId, String vcmStatus) {
        try {
            List<Customer__c> custs = new List<Customer__c>();
            for (String customerId : new Set<String>(customerIds)) {
                Customer__c cust = new Customer__c(Id = customerId, Assigned_VCM__c = verifierUserId);
                if (String.isNotBlank(vcmStatus)) {
                    cust.VCM_Status__c = vcmStatus;
                }
                custs.add(cust);
            }
            update custs;
        } catch (Exception e) {
            throw new AuraHandledException('assignVerifierBulk: ' + e.getMessage());
        }
    }

    // ═════════════════════════════════════════════════════════════
    //  3. GET VERIFIERS FOR ALLOCATION
    // ═════════════════════════════════════════════════════════════
    @AuraEnabled(cacheable=false)
    public static String getVerifiersForAlloc() {
            // Collect User IDs from the VCM_Auto_Allocate public group
            Set<Id> userIds = new Set<Id>();
            for (GroupMember gm : [
                SELECT UserOrGroupId
                FROM GroupMember
                WHERE Group.DeveloperName = 'VCM_Auto_Allocate'
                  AND Group.Type = 'Regular'
            ]) {
                if (String.valueOf(gm.UserOrGroupId).startsWith('005')) {
                    userIds.add(gm.UserOrGroupId);
                }
            }

            List<User> users = userIds.isEmpty() ? new List<User>() : [
                SELECT Id, Name, Title, Department, IsActive
                FROM User
                WHERE Id IN :userIds AND IsActive = true
                ORDER BY Name ASC
            ];

            List<VerifierRow> rows = new List<VerifierRow>();
            if(users.size() > 0){
                for (User u : users) {
                    VerifierRow v    = new VerifierRow();
                    v.id             = u.Id;
                    v.name           = u.Name;
                    v.initials       = initials(u.Name);
                    v.role           = u.Title != null ? u.Title : 'Verifier';
                    v.region         = u.Department;
                    v.regions        = parseList(u.Department);
                    v.specialisms    = new List<String>();
                    v.openCases      = 0;
                    v.completedToday = 0;
                    v.avgTat         = '—';
                    v.status         = u.IsActive ? 'online' : 'offline';
                    rows.add(v);
                }
            }
            return JSON.serialize(rows);
    }

    // ═════════════════════════════════════════════════════════════
    //  4. VCM USERS FOR THE USER FILTER TILES
    //  Every configured user gets a tile, in the configured order.
    //  Matched on Username / Email prefix so sandbox suffixes
    //  (.sandboxname / .invalid) still match; a user missing from
    //  the org keeps a static tile (id = username, so it matches no case)
    // ═════════════════════════════════════════════════════════════
    @AuraEnabled(cacheable=false)
    public static String getVcmFilterUsers() {
        try {
            List<String> patterns = new List<String>();
            for (String u : VCM_FILTER_USERS.keySet()) patterns.add(u + '%');

            List<User> users = [
                SELECT Id, Username, Email
                FROM User
                WHERE Username LIKE :patterns OR Email LIKE :patterns
            ];

            List<VcmUserTile> tiles = new List<VcmUserTile>();
            for (String u : VCM_FILTER_USERS.keySet()) {
                VcmUserTile t = new VcmUserTile();
                t.id       = u;
                t.name     = VCM_FILTER_USERS.get(u);
                t.initials = initials(t.name);
                for (User usr : users) {
                    if (usr.Username.startsWithIgnoreCase(u) || (usr.Email != null && usr.Email.startsWithIgnoreCase(u))) {
                        t.id = usr.Id;
                        break;
                    }
                }
                tiles.add(t);
            }
            return JSON.serialize(tiles);
        } catch (Exception e) {
            throw new AuraHandledException('getVcmFilterUsers: ' + e.getMessage());
        }
    }

    // ── Helpers ────────────────────────────────────────────────────

    // Maps Customer__c.VCM_Status__c picklist → dashboard status constants
    private static String normaliseVcmStatus(String s) {
        if (String.isBlank(s)) return 'PENDING';
        Map<String, String> norm = new Map<String, String>{
            'Allocated'    => 'ALLOCATED',
            'In Review'    => 'IN_REVIEW',
            'Escalated'    => 'ESCALATED',
            'Completed'    => 'COMPLETED',
            'Pending'      => 'PENDING'
        };
        return norm.containsKey(s) ? norm.get(s) : 'PENDING';
    }

    // Maps Opportunity StageName → dashboard status constants
    private static String normaliseStatus(String s) {
        if (String.isBlank(s)) return 'PENDING';
        String key = s.toUpperCase().replaceAll('[^A-Z0-9]', '_');
        Map<String, String> norm = new Map<String, String>{
            'PROSPECTING'         => 'PENDING',
            'QUALIFICATION'       => 'PENDING',
            'PENDING'             => 'PENDING',
            'PENDING_REVIEW'      => 'PENDING',
            'NEW'                 => 'PENDING',
            'VALUE_PROPOSITION'   => 'ALLOCATED',
            'ALLOCATED'           => 'ALLOCATED',
            'PERCEPTION_ANALYSIS' => 'IN_REVIEW',
            'IN_REVIEW'           => 'IN_REVIEW',
            'UNDER_REVIEW'        => 'IN_REVIEW',
            'OBSERVATIONS_SHARED' => 'IN_REVIEW',
            'CLOSED_WON'          => 'COMPLETED',
            'APPROVED'            => 'COMPLETED',
            'COMPLETED'           => 'COMPLETED',
            'ESCALATED'           => 'ESCALATED',
            'CLOSED_LOST'         => 'ESCALATED'
        };
        return norm.containsKey(key) ? norm.get(key) : 'PENDING';
    }

    // Risk_Weight__c is free text in prod ("50", "50%", "12.5 %") — keep the
    // number, default to 50 when nothing parseable is left
    private static Integer parseRiskWeight(String s) {
        if (String.isBlank(s)) return 50;
        Matcher m = Pattern.compile('\\d+(\\.\\d+)?').matcher(s);
        return m.find() ? Decimal.valueOf(m.group()).intValue() : 50;
    }

    private static String initials(String name) {
        if (String.isBlank(name)) return '?';
        List<String> parts = name.trim().split('\\s+');
        String i = parts[0].substring(0, 1).toUpperCase();
        if (parts.size() > 1) i += parts[parts.size()-1].substring(0, 1).toUpperCase();
        return i;
    }

    private static List<String> parseList(String val) {
        if (String.isBlank(val)) return new List<String>();
        List<String> out = new List<String>();
        for (String s : val.split('[,;]')) { if (String.isNotBlank(s.trim())) out.add(s.trim()); }
        return out;
    }

