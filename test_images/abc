    // ---------- 2. determinePageBlock* branch coverage ---------------
    // Covers: empty-string default assignment, "value <= fixed" success path,
    // and the "value > fixed" warning path, for all four editable fields.
    @isTest
    static void testDeterminePageBlocksAllBranches() {
        PayUControllerNNew obj = new PayUControllerNNew();
        obj.Total_Sum = 1000;
        // --- Bouncing Arrear field ---
        obj.NewBouncingChargeArrearfixed = '100';
        obj.firstEdit = '0';
        obj.NewBouncingChargeArrear = ''; // hits '' -> '0' default branch
        obj.NewBouncingChargeFTM = '10';
        try { obj.determinePageBlock(); } catch (Exception ex) { System.debug(ex.getMessage()); }
        obj.NewBouncingChargeArrearfixed = '50';
        obj.NewBouncingChargeArrear = '200'; // value > fixed -> warning branch
        try { obj.determinePageBlock(); } catch (Exception ex) { System.debug(ex.getMessage()); }
        obj.NewBouncingChargeArrearfixed = '100';
        obj.firstEdit = '10';
        obj.NewBouncingChargeArrear = '40'; // valid update branch
        obj.NewBouncingChargeFTM = '10';
        try { obj.determinePageBlock(); } catch (Exception ex) { System.debug(ex.getMessage()); }
        // --- EMI Arrears field ---
        obj.NewEMIArrearsfixed = '100';
        obj.SecondEdit = '0';
        obj.NewEMIArrears = ''; // '' -> '0'
        obj.NewEMIForthemonth = '10';
        try { obj.determinePageBlock1(); } catch (Exception ex) { System.debug(ex.getMessage()); }
        obj.NewEMIArrearsfixed = '20';
        obj.NewEMIArrears = '500'; // warning branch
        try { obj.determinePageBlock1(); } catch (Exception ex) { System.debug(ex.getMessage()); }
        obj.NewEMIArrearsfixed = '100';
        obj.SecondEdit = '10';
        obj.NewEMIArrears = '40';
        obj.NewEMIForthemonth = '10';
        try { obj.determinePageBlock1(); } catch (Exception ex) { System.debug(ex.getMessage()); }
        // --- LPP Charges field ---
        obj.NewLPPChargesfixed = '100';
        obj.thirdEdit = '0';
        obj.NewLPPCharges = ''; // '' -> '0'
        try { obj.determinePageBlock2(); } catch (Exception ex) { System.debug(ex.getMessage()); }
        obj.NewLPPChargesfixed = '5';
        obj.NewLPPCharges = '999'; // warning branch
        try { obj.determinePageBlock2(); } catch (Exception ex) { System.debug(ex.getMessage()); }
        obj.NewLPPChargesfixed = '100';
        obj.thirdEdit = '10';
        obj.NewLPPCharges = '40';
        try { obj.determinePageBlock2(); } catch (Exception ex) { System.debug(ex.getMessage()); }
        // --- Cash Handling Charges field ---
        obj.NewCashHandlingChargesfixed = '100';
        obj.fourthEdit = '0';
        obj.NewCashHandlingCharges = ''; // '' -> '0'
        try { obj.determinePageBlock3(); } catch (Exception ex) { System.debug(ex.getMessage()); }
        obj.NewCashHandlingChargesfixed = '5';
        obj.NewCashHandlingCharges = '999'; // warning branch
        try { obj.determinePageBlock3(); } catch (Exception ex) { System.debug(ex.getMessage()); }
        obj.NewCashHandlingChargesfixed = '100';
        obj.fourthEdit = '10';
        obj.NewCashHandlingCharges = '40';
        try { obj.determinePageBlock3(); } catch (Exception ex) { System.debug(ex.getMessage()); }
    }
    
