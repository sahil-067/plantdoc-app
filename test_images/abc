                else if(atendanceMap.get(key).Active__c == true){
                    activeCount++;
                    rec.status = 'Active';
                    locations.add(rec);
                }
                else if(atendanceMap.get(key).Active__c == false){
                    inActiveCount++;
                    rec.status = 'Inactive';
                    locations.add(rec);
                }
            }
            
            recordWrp.totalInActive = inActiveCount;
            recordWrp.totalActive	= activeCount;
            recordWrp.locationWrapperList = locations;
            return recordWrp;
        }
        catch(Exception e){
            System.debug('Error: ' + e.getMessage() + ' Line: ' + e.getLineNumber());
            return null;
        }
    }
    
    
