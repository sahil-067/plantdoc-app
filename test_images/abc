    public static void updateLoanStatus(List<Disbursement__c> disbList,Map<Id,Disbursement__c> oldMap){
        //set for store all application
        set<Id> applicationIdSet = new set<Id>();
        for(Disbursement__c disb:disbList)
        {
            if(disb.Disb_Status__c == 'Handed over customer' && disb.Disb_Status__c != oldmap.get(disb.Id).Disb_Status__c )
            {
                applicationIdSet.add(disb.Application__c);
            } 
        }
        if(applicationIdSet.size()>0)
        {
            List<Opportunity> oppToUpdateList = new List<Opportunity>();
            Decimal totalamount;
            for(Opportunity opp: [Select Id,Sanctioned_Amont__c,LM_Loan_Status__c,(Select Id,Disbursement_Amount__c FROM Disbursements__r WHERE Disb_Status__c != 'Cancelled') FROM Opportunity 
                                  WHERE Id IN : applicationIdSet]){
                                      totalamount = 0;
                                      for(Disbursement__c dmObj : opp.Disbursements__r){
                                          if(dmObj.Disbursement_Amount__c != NULL){
                                              totalamount += dmObj.Disbursement_Amount__c;
                                          }
                                      }
                                      
                                      System.debug('Total Amount calculated @@@@    '+totalamount);
                                      System.debug('opp Sanctioned_Amont__c    @@@@    '+opp.Sanctioned_Amont__c);
                                      
                                      if(totalamount == opp.Sanctioned_Amont__c){
                                          System.debug('Equal Condition');   
                                          oppToUpdateList.add(new Opportunity(Id = opp.Id,LM_Loan_Status__c = 'Fully Disbursed (Active)')); 
                                      }else if(totalamount < opp.Sanctioned_Amont__c){
                                          System.debug('Not  Equal Condition');  
                                          oppToUpdateList.add(new Opportunity(Id = opp.Id,LM_Loan_Status__c = 'Partially Disbursed')); 
                                      }                             
                                      
                                  }
            
            if(!oppToUpdateList.isEmpty()){
                System.debug('#####oppToUpdateListBefore----> '+oppToUpdateList);
                UPDATE oppToUpdateList;
                System.debug('#####oppToUpdateListAfter----> '+oppToUpdateList);
            }
        }
        
    }
    
    //show error message
    public static void showErrorMessage(List<Disbursement__c> DisbursementList){
        Map<Id,boolean> errorMap = new Map<Id,boolean>();
        Map<Id,boolean> errorMapNew = new Map<Id,boolean>();
        map<Id,Decimal> applicationMap = new Map<Id,Decimal>(); 
        Set<Id> applicationErrorIdSet=new Set<Id>();
        for(Disbursement__c dis:DisbursementList)
        {
            if( dis.Tranch_Details__c == 'Subsequent'){
                applicationErrorIdSet.add(dis.Application__c);
            }
            
        }
        if(applicationErrorIdSet.size()>0)
        {
            for(Opportunity oppRec : [select Id,Balance_Collectable__c from Opportunity 
                                      where Id IN: applicationErrorIdSet]){
                                          applicationMap.put(oppRec.Id,oppRec.Balance_Collectable__c);                 
                                      }
            for(Disbursement__c dmObj : [Select Id,Disbursement_Amount__c,Disb_Status__c,createdDate,Application__c  FROM Disbursement__c WHERE Application__c In : applicationErrorIdSet]){
                if(dmObj.Disb_Status__c == 'Handed over customer' || dmObj.Disb_Status__c == 'Cancelled'){
                    if(applicationMap.containsKey(dmObj.Application__c) && applicationMap.get(dmObj.Application__c) != 0.00){
                        errorMapNew.put(dmObj.Application__c , true);
                    }
                }else{
                    system.debug('Createddate'+dmObj.createdDate+'today'+system.now());
                    if(dmObj.createdDate < System.today() || (applicationMap.containsKey(dmObj.Application__c) && applicationMap.get(dmObj.Application__c) != 0.00)){
                        errorMap.put(dmObj.Application__c , true);
                    }
                }
            }
            
            System.debug('errorMap @@@@@     '+errorMap);
             Map<String,String> divMap=new Map<String,String>(); 
            for(Disbursement__c dm : DisbursementList){
                if(errorMap.containsKey(dm.Application__c) && errorMap.get(dm.Application__c)){
                    list<Deviation__c> divList=[SELECT Id,Opportunity__c FROM Deviation__c WHERE Opportunity__c IN : applicationErrorIdSet AND Waiver__c='2nd Day DM Creation without Realization'];
                    for(Deviation__c dv:divList)
                    {
                        divMap.put(dv.Opportunity__c,dv.Id);
                    }
 					System.debug('divMap'+divMap);
                    if(divMap.get(dm.Application__c)==Null)
                    dm.addError('DM creation is not allowed as previous DM is not realized.');
                }else if(errorMapNew.containsKey(dm.Application__c) && errorMapNew.get(dm.Application__c)){
                    dm.addError('DM creation is not allowed as Balance Collectable is not equal to 0.');
                }
            }
        }
    }
    
    
