    private static String getValidOpportunityStageName() {
        for (
            Schema.PicklistEntry picklistValue :
            Opportunity.StageName.getDescribe().getPicklistValues()
        ) {
            if (picklistValue.isActive()) {
                return picklistValue.getValue();
            }
        }
        
        return 'Prospecting';
    }
    
    private static String getValidLeadStatus() {
