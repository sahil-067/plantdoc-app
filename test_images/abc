    public static List<BCM_AND_CO_Wrapper> getBCMCODetails(Map<String, Attendance__c> attMap, List<Attendance__c> bcmcoEmpCodeList,Boolean status){
        System.debug('attMap :: '+attMap);
        System.debug('bcmcoEmpCodeList :: '+bcmcoEmpCodeList);
        
        List<BCM_AND_CO_Wrapper> bcmcoWrapList = new List<BCM_AND_CO_Wrapper>();
        DateTime gmtNow = DateTime.now();
        TimeZone istTimeZone = TimeZone.getTimeZone('Asia/Kolkata'); 
        Integer offsetToIST = istTimeZone.getOffset(gmtNow); 
        DateTime now = gmtNow.addSeconds(offsetToIST / 1000);
        for(Attendance__c att : bcmcoEmpCodeList){
            BCM_AND_CO_Wrapper bcmcoWrap = new BCM_AND_CO_Wrapper();
            if(attMap.containskey(att.Account__r.Empl_Code__pc)){
                bcmcoWrap.name = attMap.get(att.Account__r.Empl_Code__pc).Account__r.Name;
                bcmcoWrap.employeeId = attMap.get(att.Account__r.Empl_Code__pc).Account__r.Empl_Code__pc;
                Long diffMillis = now.getTime() - attMap.get(att.Account__r.Empl_Code__pc).Date__c.addSeconds(offsetToIST / 1000).getTime();
                Decimal diffMinutes = diffMillis / 60000.0;
                
                if (diffMinutes >= 45) {
                    bcmcoWrap.isActive = false;
                } else {
                    bcmcoWrap.isActive = attMap.get(att.Account__r.Empl_Code__pc).Active__c;
                }
                // coWrap.isActive = userMap.get(usr.Account__r.Empl_Code__pc).Active__c;
                bcmcoWrap.designation = employeeDesignationMap.containsKey(att.Account__r.Empl_Code__pc) ? employeeDesignationMap.get(att.Account__r.Empl_Code__pc) : '';
                bcmcoWrap.mobileNumber = attMap.get(att.Account__r.Empl_Code__pc).Account__r.Mobile__pc;                
                bcmcoWrap.lastLogin = (attMap.containsKey(att.Account__r.Empl_Code__pc) && attMap.get(att.Account__r.Empl_Code__pc).Date__c != null) 
                    ? String.ValueOf(attMap.get(att.Account__r.Empl_Code__pc).Date__c.format('dd-MM-yyyy hh:mm a')) 
                    : '';
                bcmcoWrap.allocatedCases = EmpIdByCasesMap.containsKey(att.Account__r.Empl_Code__pc) ? EmpIdByCasesMap.get(att.Account__r.Empl_Code__pc) :null;
				if(status != null){
                    if(bcmcoWrap.isActive && status){
                        bcmcoWrapList.add(bcmcoWrap); 
                    }
                    if(!bcmcoWrap.isActive && !status){
                        bcmcoWrapList.add(bcmcoWrap); 
                    }
                }else{
                    bcmcoWrapList.add(bcmcoWrap);    
                }
            }
        }
        System.debug('coWrapList :: '+bcmcoWrapList);
        return bcmcoWrapList;
    }
    
    
    
    @AuraEnabled(cacheable=true)
    public static UserWrapper getUserDetails() {
        
        String currentUserId = UserInfo.getUserId();
        //  currentUserId = '0052K00000BQ15KQAT';
        User currentUser = [SELECT Id, Name, Branch__c, EmployeeNumber,MobilePhone FROM User WHERE Id = :currentUserId LIMIT 1];
        
        UserWrapper result = new UserWrapper();
        result.name = currentUser.Name;
        result.employeeId = currentUser.EmployeeNumber;
        result.mobileNumber = currentUser.MobilePhone;
        
        if (currentUser.Branch__c == 'Headoffice') {
            result.designation = 'HO';
        } else {
            List<Branch__c> branches = [
                SELECT Collection_Manager__c, Branch_Area_Collection__c, Branch_Regional_Collection__c,
                Zonal_Collection_Manager__c, National_Collection_Manager__c
                FROM Branch__c
                WHERE Branch_Area_Collection__c = :currentUserId
                OR Branch_Regional_Collection__c = :currentUserId
                OR Zonal_Collection_Manager__c = :currentUserId
                OR National_Collection_Manager__c = :currentUserId
                LIMIT 1
            ];
            
            if (!branches.isEmpty()) {
                Branch__c b = branches[0];
                
                if (b.National_Collection_Manager__c == currentUserId) {
                    result.designation = 'NCM';
                } else if (b.Zonal_Collection_Manager__c == currentUserId) {
                    result.designation = 'ZCM';
                } else if (b.Branch_Regional_Collection__c == currentUserId) {
                    result.designation = 'RCM';
                } else if (b.Branch_Area_Collection__c == currentUserId) {
                    result.designation = 'ACM';
                }
            }
        }
        return result;
    }
    
