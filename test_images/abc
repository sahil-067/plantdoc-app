    @isTest
    static void testJSONDeserialization() {
        // A condensed JSON string that hits key points in the hierarchy to test JSON.deserialize
        String jsonString = '{' +
            '\"requestHeader\": {' +
                '\"tenantId\": 123,' +
                '\"userDetail\": {' +
                    '\"userCode\": \"USR-001\",' +
                    '\"branchId\": 1001' +
                '}' +
            '},' +
            '\"loanBookingRequest\": {' +
                '\"loanDetail\": {' +
                    '\"loanRefId\": \"REF-555\",' +
                    '\"netMarkup\": 10.5,' +
                    '\"loanDisbursalDetails\": [' +
                        '{' +
                            '\"disbursalAmount\": 400000,' +
                            '\"disbursalBreakUpDetails\": [' +
                                '{' +
                                    '\"disbursalChargeAmount\": 5000.0' +
                                '}' +
                            ']' +
                        '}' +
                    ']' +
                '}' +
            '}' +
        '}';
        
        LoanServiceWrapper parsedResult = (LoanServiceWrapper) JSON.deserialize(jsonString, LoanServiceWrapper.class);
        
        // Assertions to verify the JSON mapped correctly
        System.assertNotEquals(null, parsedResult, 'Parsed result should not be null');
        System.assertEquals(123, parsedResult.requestHeader.tenantId, 'tenantId should parse correctly');
        System.assertEquals('USR-001', parsedResult.requestHeader.userDetail.userCode, 'userCode should parse correctly');
        System.assertEquals('REF-555', parsedResult.loanBookingRequest.loanDetail.loanRefId, 'loanRefId should parse correctly');
        System.assertEquals(10.5, parsedResult.loanBookingRequest.loanDetail.netMarkup, 'netMarkup should parse correctly');
        System.assertEquals(400000, parsedResult.loanBookingRequest.loanDetail.loanDisbursalDetails[0].disbursalAmount, 'disbursalAmount should parse correctly');
    }
