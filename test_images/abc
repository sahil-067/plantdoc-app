    private static List<ApplicantData> loadApplicants(
    Opportunity app
) {
    List<ApplicantData> output = new List<ApplicantData>();

    /*
     * Applicant tab:
     * Application → Household__c → child Account records.
     */
    if (app.Household__c == null) {
        return output;
    }

   List<Account> accounts = [
    SELECT Id,
           Name,
           RecordTypeId,
           RecordType.DeveloperName,
           Mobile__pc,
           Personal_email__pc,
           Date_Of_Birth__pc,
           Address__pc,
           Client_ID__pc,
           ClientNum__pc,
           Sex__pc,
           Marital_Status__pc,
           Qualification__pc,
           Aadhar_Card__pc,
           Pan_Card_No__pc,
           Image_URL__pc,
           Photograph__pc
    FROM Account
    WHERE Household__c = :app.Household__c
    ORDER BY CreatedDate ASC
];
    Integer index = 0;

    for (Account row : accounts) {
        index++;

        ApplicantData item = new ApplicantData();

        item.id = String.valueOf(row.Id);
        item.name = row.Name;

        /*
         * Main Applicant is the Account directly linked to Application.
         * Other Accounts under the same Household are Co-Applicants.
         */
        String recordTypeName = row.RecordType == null
    ? ''
    : row.RecordType.DeveloperName;

if (
    recordTypeName == 'Main_Applicant' ||
    recordTypeName == 'MainApplicant'
) {
    item.role = 'Main Applicant';
} else if (
    recordTypeName == 'Co_Applicant' ||
    recordTypeName == 'CoApplicant'
) {
    item.role = 'Co-Applicant';
} else {
    /*
     * Fallback protects old records where Record Type is not correctly set.
     */
    item.role = row.Id == app.AccountId
        ? 'Main Applicant'
        : 'Co-Applicant';
}

        item.color = colorFor(index);

        item.clientId = firstNonBlank(
            new List<String>{
                row.Client_ID__pc,
                row.ClientNum__pc,
                '—'
            }
        );

        item.dob = row.Date_Of_Birth__pc == null
            ? '—'
            : String.valueOf(row.Date_Of_Birth__pc);

        item.gender = row.Sex__pc;
        item.marital = row.Marital_Status__pc;
        item.qual = row.Qualification__pc;

        item.mobile = firstNonBlank(
            new List<String>{
                row.Mobile__pc,
                '—'
            }
        );

        item.email = row.Personal_email__pc;
        item.addr = row.Address__pc;

        item.kyc =
            (String.isBlank(row.Aadhar_Card__pc)
                ? 'Aadhaar pending'
                : 'Aadhaar available')
            + ' · '
            + (String.isBlank(row.Pan_Card_No__pc)
                ? 'PAN pending'
                : 'PAN available');

        item.photoUrl = getPhotoUrl(
            row.Image_URL__pc,
            row.Photograph__pc,
            null
        );

        output.add(item);
    }

    return output;
}

    private static CustomerData buildCustomer(
        List<ApplicantData> applicants,
        Opportunity app
    ) {
        CustomerData customer = new CustomerData();

        if (applicants.isEmpty()) {
            customer.name = 'Applicant not linked';
