        acc.Pan_Card_No__pc = null;
        acc.Ration_Card__pc = null;
        acc.Passport_No__pc = null;
        acc.Voter_Card__pc = null;
        acc.Drv_Licn__pc = null;
        acc.Aadhar_Card__pc = null;
