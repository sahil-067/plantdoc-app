    @isTest
    static void testGetNCMDetailsAndHOWrapper() {
        User ncmUser = getUserByEmpNum('EMP_NCM');
        Map<String, User> userMap = new Map<String, User>{ ncmUser.EmployeeNumber => ncmUser };

        Test.startTest();
        List<AttendanceCalculator.NCMWrapper> ncmList = AttendanceCalculator.getNCMDetails(
            userMap,
            new List<String>{ ncmUser.EmployeeNumber }
        );
        AttendanceCalculator.HOWrapper hoWrap = new AttendanceCalculator.HOWrapper();
        hoWrap.name = 'HO Test';
        hoWrap.children = ncmList;
        Test.stopTest();

        System.assertEquals(1, ncmList.size());
        System.assertEquals('EMP_NCM', ncmList[0].employeeId);
    }

    @isTest
    static void testGetUserDetails_AllRoles() {
        Test.startTest();

        System.runAs(getUserByEmpNum('EMP_HO')) {
            AttendanceCalculator.UserWrapper hoWrap = AttendanceCalculator.getUserDetails();
            System.assertNotEquals(null, hoWrap);
        }
        System.runAs(getUserByEmpNum('EMP_NCM')) {
            AttendanceCalculator.UserWrapper ncmWrap = AttendanceCalculator.getUserDetails();
            System.assertEquals('NCM', ncmWrap.designation);
        }
        System.runAs(getUserByEmpNum('EMP_ZCM')) {
            AttendanceCalculator.UserWrapper zcmWrap = AttendanceCalculator.getUserDetails();
            System.assertEquals('ZCM', zcmWrap.designation);
        }
        System.runAs(getUserByEmpNum('EMP_RCM')) {
            AttendanceCalculator.UserWrapper rcmWrap = AttendanceCalculator.getUserDetails();
            System.assertEquals('RCM', rcmWrap.designation);
        }
        System.runAs(getUserByEmpNum('EMP_ACM')) {
            AttendanceCalculator.UserWrapper acmWrap = AttendanceCalculator.getUserDetails();
            System.assertEquals('ACM', acmWrap.designation);
        }
        System.runAs(getUserByEmpNum('EMP_NONE')) {
            AttendanceCalculator.UserWrapper noneWrap = AttendanceCalculator.getUserDetails();
            System.assertEquals(null, noneWrap.designation);
        }

        Test.stopTest();
    }

    @isTest
    static void testGetOpportunities() {
        Test.startTest();

        List<Opportunity> foundOpps = AttendanceCalculator.getOpportunities('EMP_BCM1');
        System.assertNotEquals(null, foundOpps);
        System.assertEquals(1, foundOpps.size());

        List<Opportunity> notFoundOpps = AttendanceCalculator.getOpportunities('INVALID_CODE');
        System.assertEquals(null, notFoundOpps);

        List<Opportunity> blankOpps = AttendanceCalculator.getOpportunities('');
        System.assertEquals(null, blankOpps);

        List<Opportunity> nullOpps = AttendanceCalculator.getOpportunities(null);
        System.assertEquals(null, nullOpps);

        Test.stopTest();
    }
}
