  public static Map<String, String> encrypt(String plainText, String keyStr) {
    Map<String, String> result = new Map<String, String>();
    try {
        String base64IV = '6543210987654321'; // 16-byte IV
        Blob key = Blob.valueOf(keyStr); // Must be 16 characters
        Blob iv = Blob.valueOf(base64IV);
        Blob input = Blob.valueOf(plainText);

        Blob encrypted = Crypto.encrypt('AES128', key, iv, input);
        String base64Encoded = EncodingUtil.base64Encode(encrypted);

        // Make Base64 URL-safe
        String urlSafeEncoded = base64Encoded.replace('+', '-').replace('/', '_').replace('=', '');

        result.put('base64Ciphertext', urlSafeEncoded);
        result.put('base64IV', EncodingUtil.base64Encode(iv)); // You can also make IV URL-safe if needed
    } catch (Exception e) {
        System.debug('❌ Encryption error: ' + e.getMessage());
        throw new DecryptionException('Encryption failed: ' + e.getMessage());
    }
    return result;
}

public static String decryptFinal(String base64Ciphertext, String base64IV, String keyStr) {
    base64IV = 'NjU0MzIxMDk4NzY1NDMyMQ=='; // Example IV
    keyStr = '1234567890123456'; // 16-byte key

    // Restore original Base64 format
    String base64 = base64Ciphertext.replace('-', '+').replace('_', '/');
    while (Math.mod(base64.length(), 4) != 0) {
   		 base64 += '=';
	}


    Blob key = Blob.valueOf(keyStr);
    Blob iv = EncodingUtil.base64Decode(base64IV);
    Blob encrypted = EncodingUtil.base64Decode(base64);

    try {
        Blob decrypted = Crypto.decrypt('AES128', key, iv, encrypted);
        String result = decrypted.toString();
        System.debug('✅ Decrypted: ' + result);
        return result;
    } catch (Exception e) {
        System.debug('❌ Decryption error: ' + e.getMessage());
        throw new DecryptionException('Decryption failed: ' + e.getMessage());
    }
}

    
    
	
	public class DecryptionException extends Exception {}

