    @future(callout=true)
    public static void fncSendPaymentLink(set<Id> SetPaySlipId, integer Amount){
        List<PayU_Payment_Status__c> UpdatePayUPaymentStatus=New List<PayU_Payment_Status__c> ();
        List<Pay_Slip__c> UpdatePaySlip=new  List<Pay_Slip__c> ();
        
        List<Pay_Slip__c> ListPaySlip = [Select Id,Name,Name_of_Customer__c,Depositor_Email__c,Deposited__c,Amount__c,Deposited_Amount__c,CustomerMobile__c,
                                          Depositor_Phone_Number__c,
                                         (select id from PayU_Payment_Status__r),
                                         Application__r.Customer_Mobile__c,Application__r.Person_Email__c,CustomerAppID__c 
                                         from Pay_Slip__c Where Id IN: SetPaySlipId];
        string UniqueNumberForPayU='TRAN'+string.valueOf(Math.round((Math.random() * (900000) + 100000)));
        if(ListPaySlip.size()>0){
            string sMobileNumber;
            if(ListPaySlip[0].Depositor_Phone_Number__c==null)
                sMobileNumber=ListPaySlip[0].CustomerMobile__c;
            else
                sMobileNumber=ListPaySlip[0].Depositor_Phone_Number__c;
            
            if(sMobileNumber!=null){
                PayU__c ObjPayU = PayU__c.getValues('MtQShL');
                Wrapper objWrapper=New Wrapper();
                objWrapper.amount= string.valueOf(Amount);
                objWrapper.txnid='TRAN-'+string.valueOf(Math.round((Math.random() * (900000) + 100000)))+'-'+ListPaySlip[0].Name; 
                objWrapper.productinfo='India Shelter HL';
                objWrapper.firstname='Customer Name';
                //commented on 10/8/2020 by tarun (devender)
                //string.valueOf(ListPaySlip[0].Name_of_Customer__c);
                objWrapper.email=string.valueOf(ListPaySlip[0].Depositor_Email__c);
                objWrapper.phone=sMobileNumber;
                objWrapper.address1='XZY';
                objWrapper.city='Delhi';
                objWrapper.state='Delhi';
                objWrapper.country='India';
                objWrapper.zipcode='110012';
                objWrapper.template_id=ObjPayU.template_id__c;//1404
                objWrapper.validation_period='2';
                objWrapper.send_email_now='1';
                objWrapper.send_sms='1';
                objWrapper.udf1=string.valueOf(ListPaySlip[0].CustomerAppID__c);
                objWrapper.udf2=string.valueOf(ListPaySlip[0].Name);
                objWrapper.udf3=string.valueOf(ListPaySlip[0].Id);
                objWrapper.udf4='iCollectionApp';
                if(!string.isEmpty(string.valueOf(ObjPayU.SMS_Template_ID__c)))
                    objWrapper.sms_template_id=string.valueOf(ObjPayU.SMS_Template_ID__c);
                string sData=''+ObjPayU.sKey__c+'|create_invoice|'+JSON.serialize(objWrapper)+'|'+ObjPayU.sSolt__c+'';
                Blob macBlob = Crypto.generateDigest('SHA512', Blob.valueOf(sData));
                string sBody= 'key='+ObjPayU.sKey__c+'&command=create_invoice&var1='+JSON.serialize(objWrapper)+'&hash='+EncodingUtil.convertToHex(macBlob);
                HttpRequest request = new HttpRequest(); 
                request.setEndpoint(ObjPayU.SendLinkUrl__c); 
                request.setMethod('POST'); 
               // request.setHeader('Accept', 'application/x-www-form-urlencoded');
                request.setHeader('Content-Type','application/x-www-form-urlencoded');  
                request.setBody(sBody);
                try{ 
                    System.debug(' ** request ** : ' + request); 
                    Http http = new Http();  
                    HttpResponse response = new HttpResponse();
                    if(!Test.isRunningTest()) {
                    response = http.send(request); 
                    
                    System.debug(' ** response ** : ' + response.getStatusCode()); 
                        if (response.getStatusCode() == 200 ) {               
                            System.debug(' ** wrapper 12 ** : ' +response); 
                            System.debug(' ** wrapper ** : ' +response.getBody()); 
                        } else { 
                            System.debug(' Response ' + response.getBody() ); 
                            throw new CalloutException( response.getBody() ); 
                        } 
                    }
                    
                    for(ID iID: SetPaySlipId){
                        
                        Pay_Slip__c paySlip = new Pay_Slip__c();
                        paySlip.id=iID;
                        paySlip.Transcation_Id__c=objWrapper.txnid;
                        paySlip.UniqueNumberForPayU__c=UniqueNumberForPayU;
                        PayU_Payment_Status__c obj=new PayU_Payment_Status__c();
                        obj.Status__c='Requested';
                        obj.Pay_Slip__c=iID;
                        obj.Resquest__c=string.valueOf(sData);
                        obj.Transaction_Id__c=objWrapper.txnid;
                        obj.Response__c=response.getBody();
                        UpdatePayUPaymentStatus.add(obj) ;
                        UpdatePaySlip.add(paySlip);
                    }
                    if(UpdatePayUPaymentStatus.size()>0){
                        insert UpdatePayUPaymentStatus;
                    }
                    if(UpdatePaySlip.size()>0){
                        update UpdatePaySlip;
                    }
                    
                }catch( System.Exception e) { 
                    System.debug('ERROR: '+ e); 
                    throw e; 
                }
            }
        }
    }
