        wrap.ocr = ocr;
        wrap.isSelected = true;
        wrap.isSign = true;
        //  wrap.otpVerificationCode = '123456';
        wrap.isOtpSent = true;
        wrap.isVerified = true;
        wrap.errorMessage = 'Test Error';
        wrap.showSendButton = false;
        wrap.disableSendButton = true;
        wrap.showResendButton = true;
        wrap.disableResendButton = false;
        
        Test.startTest();  
        PageEsignNewControllerClone pageEsignNewControllerObj1 = new PageEsignNewControllerClone();
        pageEsignNewControllerObj1.selectedType = 'Loan - Guarantor';
        pageEsignNewControllerObj1.recordId = acc.Id;
        pageEsignNewControllerObj1.mobileNumber = acc.Phone;
        pageEsignNewControllerObj1.otpType = 'SMS';
        pageEsignNewControllerObj1.withStamp = true;
        
        pageEsignNewControllerObj1.updateStampDropdownValues();
        pageEsignNewControllerObj1.getchooseType();
        pageEsignNewControllerObj1.sendMobileOtp();
        
        
        
        OTP_Authorization__c otp = [SELECT Id,OTP__c FROM OTP_Authorization__c LIMIT 1]; //WHERE APP_ID__c =:pageEsignNewControllerObj1.mobileNumber
        
        System.debug('otp in Test ::'+otp);
