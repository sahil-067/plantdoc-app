    private static String resolveLeadSource(String rawSource, String campName) {
        if (String.isBlank(rawSource)) return 'unknown';
        String cleanSource = rawSource.trim();
        if (cleanSource.equalsIgnoreCase('website') || cleanSource.equalsIgnoreCase('website (organic)')) {
            if (campName.contains('ag_') || campName.contains('gclid')) return 'google (via website)';
            if (campName.contains('unb_metaweb')) return 'facebook (via website)';
            return 'website (organic)';
        }
        return cleanSource;
    }

    private static String inferLanguageFromCampaign(String campName) {
