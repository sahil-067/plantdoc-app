@isTest
public class showValuationsControllerTest {

    @testSetup
    static void setupTestData() {
        // Standard org configuration and master records
        insert new Config__c(Name__c = 'Test Config', Value__c = '009870');

        Branch__c branch = new Branch__c(Name = 'Jaipur-1');
        insert branch;

        insert new Pincode_Master__c(Name = '600001', State_Name__c = 'Tamil Nadu');

        Customer__c cus = new Customer__c(Name = 'Rahul');
        insert cus;

        // Primary Opportunity + 3 Opportunities for Year 1, Year 2, and Year 3 CAM buckets
        List<Opportunity> oppList = new List<Opportunity>{
            new Opportunity(
                Name = 'Rahul Main',
                StageName = 'Prospecting',
                CloseDate = System.today(),
                Household__c = cus.Id,
                Customer_Location__Latitude__s = 28.4595,
                Customer_Location__Longitude__s = 77.0266
            ),
            new Opportunity(
                Name = 'Rahul Y1',
                StageName = 'Prospecting',
                CloseDate = System.today(),
                Household__c = cus.Id,
                Customer_Location__Latitude__s = 28.4600,
                Customer_Location__Longitude__s = 77.0270
            ),
            new Opportunity(
                Name = 'Rahul Y2',
                StageName = 'Prospecting',
                CloseDate = System.today(),
                Household__c = cus.Id,
                Customer_Location__Latitude__s = 28.4610,
                Customer_Location__Longitude__s = 77.0280
            ),
            new Opportunity(
                Name = 'Rahul Y3',
                StageName = 'Prospecting',
                CloseDate = System.today(),
                Household__c = cus.Id,
                Customer_Location__Latitude__s = 28.4620,
                Customer_Location__Longitude__s = 77.0290
            )
        };
        insert oppList;

        // Primary CAM (created today)
        CAM__c mainCam = new CAM__c(
            Loan_Application__c = oppList[0].Id,
            Final_Decision__c = 'Pending',
            Approval_Date__c = Date.today(),
            LvalMtr__c = 10000,
            Land_Area__c = 500,
            Build_Up_Area__c = 1000
        );

        // Year 1 CAM (Flat: Land_Area__c == 0 && Build_Up_Area__c != 0)
        CAM__c camY1 = new CAM__c(
            Loan_Application__c = oppList[1].Id,
            Final_Decision__c = 'Pending',
            Approval_Date__c = Date.today().addMonths(-6),
            LvalMtr__c = 12000,
            Land_Area__c = 0,
            Build_Up_Area__c = 800
        );

        // Year 2 CAM (Land: else branch)
        CAM__c camY2 = new CAM__c(
            Loan_Application__c = oppList[2].Id,
            Final_Decision__c = 'Pending',
            Approval_Date__c = Date.today().addMonths(-18),
            LvalMtr__c = 10000,
            Land_Area__c = 400,
            Build_Up_Area__c = 900
        );

        // Year 3 CAM (Land)
        CAM__c camY3 = new CAM__c(
            Loan_Application__c = oppList[3].Id,
            Final_Decision__c = 'Pending',
            Approval_Date__c = Date.today().addMonths(-30),
            LvalMtr__c = 8000,
            Land_Area__c = 600,
            Build_Up_Area__c = 1100
        );

        insert new List<CAM__c>{ mainCam, camY1, camY2, camY3 };

        // Backdate CreatedDate so records fall inside the 1st, 2nd, and 3rd year windows
        Test.setCreatedDate(camY1.Id, Datetime.now().addMonths(-6));
        Test.setCreatedDate(camY2.Id, Datetime.now().addMonths(-18));
        Test.setCreatedDate(camY3.Id, Datetime.now().addMonths(-30));
    }

    private static showValuationsController initController(CAM__c cam) {
        PageReference pageRef = new PageReference('/apex/showValuations');
        pageRef.getParameters().put('CAMID', cam.Id);
        Test.setCurrentPage(pageRef);
        ApexPages.StandardController sc = new ApexPages.StandardController(cam);
        return new showValuationsController(sc);
    }

    @isTest
    static void testCalculationsAndSubmitSuccess() {
        List<Opportunity> opps = [SELECT Id, Name FROM Opportunity ORDER BY Name ASC];
        CAM__c mainCam = [SELECT Id FROM CAM__c WHERE Loan_Application__r.Name = 'Rahul Main' LIMIT 1];

        Test.startTest();
        showValuationsController ctrl = initController(mainCam);

        // Covers Calculations() with valid lat/lon and Test.isRunningTest() branch
        ctrl.Calculations();
        System.assertEquals(true, ctrl.displayTable);
        System.assertEquals(false, ctrl.displayError);

        // Populate OppListRadialLow, OppListRadialHigh, and opplist to cover Low/High loops (Flat & Land) + all 3 years
        ctrl.OppListRadialLow = opps;
        ctrl.OppListRadialHigh = opps;
        for (Opportunity o : opps) {
            ctrl.opplist.add(o.Id);
        }

        ctrl.calculateAverage('Low');
        ctrl.calculateAverage('High');

        System.assertEquals(true, ctrl.displayRadialLow);
        System.assertEquals(true, ctrl.displayRadialHigh);
        System.assert(ctrl.lstWrapperClass.size() > 0);
        System.assert(ctrl.lstWrapperClass1.size() > 0);
        System.assertEquals(true, ctrl.frstyear);
        System.assertEquals(true, ctrl.scondyear);
        System.assertEquals(true, ctrl.tirdyear);

        // Cover Submit() success path
        ctrl.Submit();
        System.assertEquals(true, ctrl.DisplayDone);
        System.assertEquals(false, ctrl.displayTable);

        // Cover Done() and cancel1()
        PageReference donePr = ctrl.Done();
        PageReference cancelPr = ctrl.cancel1();
        System.assertEquals('/' + mainCam.Id, donePr.getUrl());
        System.assertEquals('/' + mainCam.Id, cancelPr.getUrl());
        Test.stopTest();
    }

    @isTest
    static void testAllFinalAverageBranchesAndEmptyLists() {
        Opportunity oppY1 = [SELECT Id FROM Opportunity WHERE Name = 'Rahul Y1' LIMIT 1];
        Opportunity oppY2 = [SELECT Id FROM Opportunity WHERE Name = 'Rahul Y2' LIMIT 1];
        Opportunity oppY3 = [SELECT Id FROM Opportunity WHERE Name = 'Rahul Y3' LIMIT 1];
        CAM__c mainCam = [SELECT Id FROM CAM__c WHERE Loan_Application__r.Name = 'Rahul Main' LIMIT 1];

        Test.startTest();
        showValuationsController ctrl = initController(mainCam);

        // Empty Radial Low & High -> covers else branches (displayRadialLow/High = false, OppListRadialLow empty else queries, finalavg = 0)
        ctrl.OppListRadialLow = new List<Opportunity>();
        ctrl.OppListRadialHigh = new List<Opportunity>();
        ctrl.opplist = new Set<Id>();
        ctrl.calculateAverage('Low');
        ctrl.calculateAverage('High');
        System.assertEquals(false, ctrl.displayRadialLow);
        System.assertEquals(false, ctrl.displayRadialHigh);
        System.assertEquals(0, ctrl.finalavg);

        // Combination 1: Y1 + Y2 (Y3 null)
        resetYearAverages(ctrl);
        ctrl.opplist = new Set<Id>{ oppY1.Id, oppY2.Id };
        ctrl.calculateAverage('Low');
        System.assertNotEquals(0, ctrl.finalavg);

        // Combination 2: Y1 + Y3 (Y2 null)
        resetYearAverages(ctrl);
        ctrl.opplist = new Set<Id>{ oppY1.Id, oppY3.Id };
        ctrl.calculateAverage('Low');
        System.assertNotEquals(0, ctrl.finalavg);

        // Combination 3: Y2 + Y3 (Y1 null)
        resetYearAverages(ctrl);
        ctrl.opplist = new Set<Id>{ oppY2.Id, oppY3.Id };
        ctrl.calculateAverage('Low');
        System.assertNotEquals(0, ctrl.finalavg);

        // Combination 4: Only Y3
        resetYearAverages(ctrl);
        ctrl.opplist = new Set<Id>{ oppY3.Id };
        ctrl.calculateAverage('Low');
        System.assertNotEquals(0, ctrl.finalavg);

        // Combination 5: Only Y2
        resetYearAverages(ctrl);
        ctrl.opplist = new Set<Id>{ oppY2.Id };
        ctrl.calculateAverage('Low');
        System.assertNotEquals(0, ctrl.finalavg);

        // Combination 6: Only Y1
        resetYearAverages(ctrl);
        ctrl.opplist = new Set<Id>{ oppY1.Id };
        ctrl.calculateAverage('Low');
        System.assertNotEquals(0, ctrl.finalavg);

        // Cover else if (CAM == null) in Calculations()
        ctrl.CAM = null;
        ctrl.Calculations();
        System.assertEquals(false, ctrl.displayTable);
        System.assertEquals(true, ctrl.displayError);
        Test.stopTest();
    }

    @isTest
    static void testSubmitExceptionBranch() {
        CAM__c mainCam = [SELECT Id FROM CAM__c WHERE Loan_Application__r.Name = 'Rahul Main' LIMIT 1];

        Test.startTest();
        showValuationsController ctrl = initController(mainCam);

        // Force DML exception on update (missing Id) to cover catch block in Submit()
        ctrl.CAM = new CAM__c();
        ctrl.Submit();
        System.assertEquals(true, ctrl.displayTable);
        System.assertEquals(false, ctrl.DisplayDone);
        Test.stopTest();
    }

    private static void resetYearAverages(showValuationsController ctrl) {
        ctrl.yearonedataavg = null;
        ctrl.yeartwodataavg = null;
        ctrl.tearthreedataavg = null;
        ctrl.finalavg = null;
    }
}
