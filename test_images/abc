    /*
     * CUSTOMER          -> Main Applicant Account Mobile__pc
     * BRANCH_APPROVER   -> Opportunity.Branch__r.Branch_Approver__r.MobilePhone
     * EBS_BRANCH_USER   -> Opportunity.Branch__r.Branch_User__r.MobilePhone
     */
    @AuraEnabled
    public static Map<String, Object> sendForeclosureOtp(
        Id applicationId,
        String otpRecipient
    ) {
        System.debug(
            LoggingLevel.INFO,
            'RetentionConsoleController.sendForeclosureOtp START'
            + ' | ApplicationId=' + applicationId
            + ' | Recipient=' + otpRecipient
        );

        try {
            OtpContext context = getOtpContext(applicationId, otpRecipient);
            String otp = generateSixDigitOtp();

            System.debug(
                LoggingLevel.INFO,
                'OTP recipient resolved'
                + ' | AccountId=' + context.account.Id
                + ' | Recipient=' + context.recipient
                + ' | Mobile=' + maskPhone(context.phoneNumber)
                + ' | OTP=' + maskOtp(otp)
            );

            /*
             * IMPORTANT:
             * HTTP callout must happen BEFORE any DML update.
             */
            Map<String, Object> response =
                RetentionConsoleHelper.sendOtpToPhone(
                    context.phoneNumber,
                    otp
                );

            System.debug(
                LoggingLevel.INFO,
                'OTP SMS response'
                + ' | ApplicationId=' + applicationId
                + ' | Recipient=' + context.recipient
                + ' | Response=' + JSON.serialize(response)
            );

            Boolean smsSent = response != null
                && Boolean.valueOf(String.valueOf(response.get('success')));

            if (!smsSent) {
                System.debug(
                    LoggingLevel.ERROR,
                    'OTP SMS failed'
                    + ' | ApplicationId=' + applicationId
                    + ' | Recipient=' + context.recipient
                    + ' | Response=' + JSON.serialize(response)
                );

                return response == null
                    ? new Map<String, Object>{
                        'success' => false,
                        'message' => 'OTP could not be sent.'
                    }
                    : response;
            }

            /*
             * Save OTP only after successful SMS API callout.
             */
            Account otpAccountToUpdate = new Account(
                Id = context.account.Id
            );

            if (context.recipient == 'CUSTOMER') {
                otpAccountToUpdate.CustomerOtp__c = otp;
            } else if (context.recipient == 'BRANCH_APPROVER') {
                otpAccountToUpdate.Underwriter_Otp__c = otp;
            } else {
                otpAccountToUpdate.EBSOtp__c = otp;
            }

            System.debug(
                LoggingLevel.INFO,
                'Saving OTP in Account'
                + ' | AccountId=' + otpAccountToUpdate.Id
                + ' | Recipient=' + context.recipient
            );

            update otpAccountToUpdate;

            System.debug(
                LoggingLevel.INFO,
                'RetentionConsoleController.sendForeclosureOtp SUCCESS'
                + ' | AccountId=' + otpAccountToUpdate.Id
                + ' | Recipient=' + context.recipient
            );

            return response;

        } catch (Exception ex) {
            System.debug(
                LoggingLevel.ERROR,
                'RetentionConsoleController.sendForeclosureOtp FAILED'
                + ' | ApplicationId=' + applicationId
                + ' | Recipient=' + otpRecipient
                + ' | Message=' + ex.getMessage()
                + ' | Line=' + ex.getLineNumber()
                + ' | Stack=' + ex.getStackTraceString()
            );

            throw new AuraHandledException(
                'Unable to send OTP. ' + ex.getMessage()
            );
        }
    }

    @AuraEnabled(cacheable=true)
public static List<CloneApplicationData> getHouseholdApplications(
    Id mainApplicationId
) {
    if (
        mainApplicationId == null ||
        mainApplicationId.getSObjectType() != Opportunity.SObjectType
    ) {
        throw new AuraHandledException(
            'A valid Main Application Id is required.'
        );
    }

    Opportunity mainApplication = [
        SELECT Id,
               Household__c
        FROM Opportunity
        WHERE Id = :mainApplicationId
        LIMIT 1
    ];

    List<CloneApplicationData> output =
        new List<CloneApplicationData>();

    if (mainApplication.Household__c == null) {
        return output;
    }

    /*
     * Main Application
     *      ↓
     * Household__c
     *      ↓
     * Other Opportunities under the same Household
     */
    List<Opportunity> householdApplications = [
        SELECT Id,
               Name,
               Loan_Number__c,
               AccountId,
               Account.Name,
               Loan_Product__r.Name,
               CreatedDate
        FROM Opportunity
        WHERE Household__c = :mainApplication.Household__c
          AND Id != :mainApplicationId
        ORDER BY CreatedDate DESC
        LIMIT 100
    ];

    for (Opportunity applicationRecord : householdApplications) {
        CloneApplicationData row = new CloneApplicationData();

        row.id = applicationRecord.Id;
        row.applicationName = applicationRecord.Name;

        row.loanNumber =
            String.isBlank(applicationRecord.Loan_Number__c)
                ? '—'
                : applicationRecord.Loan_Number__c;

        row.applicantName =
            applicationRecord.AccountId == null
                ? 'Applicant not linked'
                : applicationRecord.Account.Name;

        row.product =
            applicationRecord.Loan_Product__r == null
                ? 'Not available'
                : applicationRecord.Loan_Product__r.Name;

        output.add(row);
    }

    return output;
}

    /*
     * Linked Application tab:
     * 1. Application → Household__c → Applicant Accounts on this
     *    Household → their Finnone_Client_Id__c values.
     * 2. Every Account in the ORG (any Household) sharing any of
     *    those Finnone_Client_Id__c values.
     * 3. All Households those Accounts belong to → all Opportunities
     *    on those Households (same Account/Opportunity grouping the
     *    Applicants tab uses), deduplicated by Opportunity Id and
     *    excluding the Application currently being processed.
     *
     * Read-only lookup. Does not mutate anything and does not
     * affect any other tab or method.
     */
    @AuraEnabled(cacheable=true)
    public static List<LinkedApplicationData> getLinkedApplications(
        Id applicationId
    ) {
        if (
            applicationId == null ||
            applicationId.getSObjectType() != Opportunity.SObjectType
        ) {
            throw new AuraHandledException(
                'A valid Application Id is required.'
            );
        }

        Opportunity currentApplication = [
            SELECT Id,
                   Household__c
            FROM Opportunity
            WHERE Id = :applicationId
            LIMIT 1
        ];

        List<LinkedApplicationData> output =
            new List<LinkedApplicationData>();

        if (currentApplication.Household__c == null) {
            return output;
        }

        /*
         * Step 1: Finnone_Client_Id__c values of the Accounts
         * on the current Application's Household.
         */
        List<Account> currentHouseholdAccounts = [
            SELECT Id,
                   Finnone_Client_Id__c
            FROM Account
            WHERE Household__c = :currentApplication.Household__c
              AND Finnone_Client_Id__c != null
        ];

        Set<String> finnoneClientIds = new Set<String>();

        for (Account accountRow : currentHouseholdAccounts) {
            finnoneClientIds.add(accountRow.Finnone_Client_Id__c);
        }

        if (finnoneClientIds.isEmpty()) {
            return output;
        }

        /*
         * Step 2: every Account in the org (any Household) sharing
         * any of those Finnone_Client_Id__c values.
         */
        List<Account> matchingAccounts = [
            SELECT Id,
                   Household__c
            FROM Account
            WHERE Finnone_Client_Id__c IN :finnoneClientIds
              AND Household__c != null
        ];

        Set<Id> matchedHouseholdIds = new Set<Id>();

        for (Account accountRow : matchingAccounts) {
            matchedHouseholdIds.add(accountRow.Household__c);
        }

        if (matchedHouseholdIds.isEmpty()) {
            return output;
        }

        /*
         * Step 3: all Opportunities on those Households, excluding
         * the Application currently being processed/viewed.
         * Naturally unique - each row keyed by Opportunity Id.
         */
        List<Opportunity> linkedApplications = [
            SELECT Id,
                   Name,
                   Loan_Number__c,
                   AccountId,
                   Account.Name,
                   Loan_Product__r.Name,
                   FinnoneClient_Id__c,
                   Finnone_Loan_Id__c,
                   Interest_Overdue__c,
                   Loan_Outstanding__c,
                   Sanc_EMI__c,
                   DPD_Previous_month_closing__c,
                   DPD_Sub_Reason__c,
                   Whatsapp_Name3__c,
                   DPD_1__c,
                   Ttl_bou__c
            FROM Opportunity
            WHERE Household__c IN :matchedHouseholdIds
              AND Id != :applicationId
            ORDER BY CreatedDate DESC
            LIMIT 200
        ];

        for (Opportunity applicationRecord : linkedApplications) {
            LinkedApplicationData row = new LinkedApplicationData();

            row.id = applicationRecord.Id;
            row.applicationName = applicationRecord.Name;

            row.loanNumber =
                String.isBlank(applicationRecord.Loan_Number__c)
                    ? '—'
                    : applicationRecord.Loan_Number__c;

            row.applicantName =
                applicationRecord.AccountId == null
                    ? 'Applicant not linked'
                    : applicationRecord.Account.Name;

            row.product =
                applicationRecord.Loan_Product__r == null
                    ? 'Not available'
                    : applicationRecord.Loan_Product__r.Name;

            row.finnoneClientId =
                String.isBlank(applicationRecord.FinnoneClient_Id__c)
                    ? 'Not available'
                    : applicationRecord.FinnoneClient_Id__c;

            row.finnoneLoanId =
                String.isBlank(applicationRecord.Finnone_Loan_Id__c)
                    ? 'Not available'
                    : applicationRecord.Finnone_Loan_Id__c;

            row.principalOutstanding = firstNonNull(
                applicationRecord.Interest_Overdue__c,
                applicationRecord.Loan_Outstanding__c
            );

            row.emi = applicationRecord.Sanc_EMI__c;

            row.maxDpd = applicationRecord.DPD_Previous_month_closing__c;

            row.minDpd = applicationRecord.DPD_Sub_Reason__c;

            row.roi = applicationRecord.Whatsapp_Name3__c;

            row.riskLevel = riskLevel(
                applicationRecord.DPD_1__c,
                applicationRecord.Ttl_bou__c
            );

            output.add(row);
        }

        return output;
    }

    @AuraEnabled
    public static OtpResult verifyForeclosureOtp(
        Id applicationId,
        String otpRecipient,
        String enteredOtp
    ) {
        System.debug(
            LoggingLevel.INFO,
            'RetentionConsoleController.verifyForeclosureOtp START'
            + ' | ApplicationId=' + applicationId
            + ' | Recipient=' + otpRecipient
            + ' | EnteredOtp=' + maskOtp(enteredOtp)
        );

        try {
            OtpContext context = getOtpContext(applicationId, otpRecipient);
            String expectedOtp = storedOtp(
                context.account,
                context.recipient
            );

            OtpResult response = new OtpResult();

            response.success =
                !String.isBlank(expectedOtp)
                && !String.isBlank(enteredOtp)
                && expectedOtp == enteredOtp.trim();

            response.message = response.success
                ? 'OTP verified.'
                : 'Enter the correct OTP.';

            System.debug(
                LoggingLevel.INFO,
                'RetentionConsoleController.verifyForeclosureOtp RESULT'
                + ' | AccountId=' + context.account.Id
                + ' | Recipient=' + context.recipient
                + ' | ExpectedOtpPresent=' + !String.isBlank(expectedOtp)
                + ' | Verified=' + response.success
            );

            return response;

        } catch (Exception ex) {
            System.debug(
                LoggingLevel.ERROR,
                'RetentionConsoleController.verifyForeclosureOtp FAILED'
                + ' | ApplicationId=' + applicationId
                + ' | Recipient=' + otpRecipient
                + ' | Message=' + ex.getMessage()
                + ' | Line=' + ex.getLineNumber()
                + ' | Stack=' + ex.getStackTraceString()
            );

            throw new AuraHandledException(
                'Unable to verify OTP. ' + ex.getMessage()
            );
        }
    }

