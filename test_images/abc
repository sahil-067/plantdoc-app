    // ── Thresholds ────────────────────────────────────────────────
    private static final Decimal T_20L = 2000000;
    private static final Decimal T_30L = 3000000;

    // ═════════════════════════════════════════════════════════════
    //  1. GET CASES FOR DASHBOARD
    //  Opportunity  = loan application record
    //  Account      = applicant (Account.Name, Account.Type)
    // ═════════════════════════════════════════════════════════════
    @AuraEnabled(cacheable=false)
    public static String getCasesForDashboard() {
        try {
            Set<String> statusSet = new Set<String>{'In process', 'Login Complete', 'Login Approved'};
            List<Opportunity> loans = [
                SELECT Id, Name,
                       Household__c,
                       Household__r.OwnerId,
                       Household__r.Owner.Name,
                       Household__r.Assigned_VCM__c,
                       Household__r.Assigned_VCM__r.Name,
                       Household__r.VCM_Status__c,
                       Household__r.First_Login_Approval_Date__c,
                       Account.Name,
                       Account.Designation_Occupation__c,
                       Account.Bureau_Flag__c,
                       Account.EKYC_Completed__c,
                       LM_Loan_Status__c,
                       Loan_Amount_Applied__c,
                       Purpose_of_loan__c,
                       StageName,
                       OwnerId, Owner.Name,
                       Loan_Number__c, Loan_Product__c, Loan_Product__r.Name,
                       Branch__r.Name, Branch__r.Zone__c,
                       Risk_Weight__c, LTV__c,
                       Login_Date__c, BM_PD_Done__c,
                       CreatedDate
                FROM Opportunity
                WHERE IsClosed = false AND LM_Loan_Status__c IN :statusSet
                  AND Login_Date__c = LAST_N_DAYS:30
                  AND Id IN (SELECT LoanAppID__c FROM Customer__c WHERE Case_Oringination_System__c = 'VRM')
                ORDER BY CreatedDate ASC
            ];

            List<CaseRow> rows = new List<CaseRow>();
            Date today = Date.today();

            for (Opportunity l : loans) {
                CaseRow r         = new CaseRow();
                r.id              = l.Id;
                r.leadId          = l.Loan_Number__c;
                r.loanNumber      = l.Name;
                // Customer (Account) → Applicant Name + Occupation/Designation
                r.applicantName   = l.Account != null ? l.Account.Name : '';
                r.applicantType   = l.Account != null ? l.Account.Designation_Occupation__c : '';
                // Application → Applied Amount
                r.amount          = l.Loan_Amount_Applied__c != null ? l.Loan_Amount_Applied__c.longValue() : 0;
                // Application → Loan Product
                r.product         = l.Loan_Product__c != null ? l.Loan_Product__r.Name : '';
                // Application → Branch Name; Branch → Zone (Bra_State__c)
                r.branch          = l.Branch__r != null ? l.Branch__r.Name : '';
                r.region          = l.Branch__r != null && l.Branch__r.Zone__c != null ? l.Branch__r.Zone__c.toUpperCase() : '';
                // Application → Purpose of Loan
                r.appType         = l.Purpose_of_loan__c;
                Datetime finalApprDate = l.Household__r != null ? l.Household__r.First_Login_Approval_Date__c : null;
                if(finalApprDate != null)
                	r.finalApprovalDate = finalApprDate.date();
                
                String vcmSt      = l.Household__r != null ? l.Household__r.VCM_Status__c : null;
                r.status          = finalApprDate != null
                                        ? 'COMPLETED'
                                        : (String.isNotBlank(vcmSt) ? normaliseVcmStatus(vcmSt) : normaliseStatus(l.StageName));
                r.priority        = 'NA';//'MEDIUM';
                // Opportunity → LTV (Applied Amount / Property Value, stored on Opp)
                r.ltv             = l.LTV__c != null ? l.LTV__c.intValue() : 0;
                r.riskScore       = l.Risk_Weight__c != null ? Integer.valueOf(l.Risk_Weight__c) : 50;
                // Assigned To: VCM if set on Customer__c, else Customer__c owner
                if (l.Household__r != null && l.Household__r.Assigned_VCM__c != null) {
                    r.assignedTo  = l.Household__r.Assigned_VCM__r != null ? l.Household__r.Assigned_VCM__r.Name : null;
                    r.assigneeId  = l.Household__r.Assigned_VCM__c;
                } else if (l.Household__r != null) {
                    r.assignedTo  = l.Household__r.Owner != null ? l.Household__r.Owner.Name : null;
                    r.assigneeId  = l.Household__r.OwnerId;
                } else {
                    r.assignedTo  = null;
                    r.assigneeId  = null;
                }
                r.householdId     = l.Household__c;
                r.assignedVcmId   = l.Household__r != null ? l.Household__r.Assigned_VCM__c : null;
                r.ageDays         = l.Login_Date__c.daysBetween(today);
                // Last 3 cols: BM PD (Opportunity), No Bureau (Account), eKYC (Account)
                r.bmVisitRequired = l.BM_PD_Done__c;
                r.noBureau        = l.Account != null ? l.Account.Bureau_Flag__c : false;
                r.eKycFailed      = l.Account == null || l.Account.EKYC_Completed__c != 'Yes';
                r.loanStatus      = l.LM_Loan_Status__c;
                rows.add(r);
            }
            return JSON.serialize(rows);

        } catch (Exception e) {
            throw new AuraHandledException('getCasesForDashboard: ' + e.getMessage());
        }
    }

    // ═════════════════════════════════════════════════════════════
    //  2. ASSIGN VCM — stores verifier on Customer__c.Assigned_VCM__c
    // ═════════════════════════════════════════════════════════════
    @AuraEnabled
    public static void assignVerifier(String customerId, String verifierUserId, Boolean isEscalated, String vcmStatus) {
        try {
            Customer__c cust = new Customer__c(Id = customerId);
            if (String.isNotBlank(verifierUserId)) {
                cust.Assigned_VCM__c = verifierUserId;
            }
            if (isEscalated == true) {
                cust.Case_Escalated__c = true;
            }
            if (String.isNotBlank(vcmStatus)) {
                cust.VCM_Status__c = vcmStatus;
            }
            update cust;
        } catch (Exception e) {
            throw new AuraHandledException('assignVerifier: ' + e.getMessage());
        }
    }

    // ═════════════════════════════════════════════════════════════
    //  3. GET VERIFIERS FOR ALLOCATION
    // ═════════════════════════════════════════════════════════════
    @AuraEnabled(cacheable=false)
    public static String getVerifiersForAlloc() {
            // Collect User IDs from the VCM_Auto_Allocate public group
            Set<Id> userIds = new Set<Id>();
            for (GroupMember gm : [
                SELECT UserOrGroupId
                FROM GroupMember
                WHERE Group.DeveloperName = 'VCM_Auto_Allocate'
                  AND Group.Type = 'Regular'
            ]) {
                if (String.valueOf(gm.UserOrGroupId).startsWith('005')) {
                    userIds.add(gm.UserOrGroupId);
                }
            }

            List<User> users = userIds.isEmpty() ? new List<User>() : [
                SELECT Id, Name, Title, Department, IsActive
                FROM User
                WHERE Id IN :userIds AND IsActive = true
                ORDER BY Name ASC
            ];

            List<VerifierRow> rows = new List<VerifierRow>();
            if(users.size() > 0){
                for (User u : users) {
                    VerifierRow v    = new VerifierRow();
                    v.id             = u.Id;
                    v.name           = u.Name;
                    v.initials       = initials(u.Name);
                    v.role           = u.Title != null ? u.Title : 'Verifier';
                    v.region         = u.Department;
                    v.regions        = parseList(u.Department);
                    v.specialisms    = new List<String>();
                    v.openCases      = 0;
                    v.completedToday = 0;
                    v.avgTat         = '—';
                    v.status         = u.IsActive ? 'online' : 'offline';
                    rows.add(v);
                }
            }
            return JSON.serialize(rows);
    }

    // ── Helpers ────────────────────────────────────────────────────

    // Maps Customer__c.VCM_Status__c picklist → dashboard status constants
    private static String normaliseVcmStatus(String s) {
        if (String.isBlank(s)) return 'PENDING';
        Map<String, String> norm = new Map<String, String>{
            'Allocated'    => 'ALLOCATED',
            'In Review'    => 'IN_REVIEW',
            'Escalated'    => 'ESCALATED',
            'Completed'    => 'COMPLETED',
            'Pending'      => 'PENDING'
        };
        return norm.containsKey(s) ? norm.get(s) : 'PENDING';
    }

    // Maps Opportunity StageName → dashboard status constants
    private static String normaliseStatus(String s) {
        if (String.isBlank(s)) return 'PENDING';
        String key = s.toUpperCase().replaceAll('[^A-Z0-9]', '_');
        Map<String, String> norm = new Map<String, String>{
            'PROSPECTING'         => 'PENDING',
            'QUALIFICATION'       => 'PENDING',
            'PENDING'             => 'PENDING',
            'PENDING_REVIEW'      => 'PENDING',
            'NEW'                 => 'PENDING',
            'VALUE_PROPOSITION'   => 'ALLOCATED',
            'ALLOCATED'           => 'ALLOCATED',
            'PERCEPTION_ANALYSIS' => 'IN_REVIEW',
            'IN_REVIEW'           => 'IN_REVIEW',
            'UNDER_REVIEW'        => 'IN_REVIEW',
            'OBSERVATIONS_SHARED' => 'IN_REVIEW',
            'CLOSED_WON'          => 'COMPLETED',
            'APPROVED'            => 'COMPLETED',
            'COMPLETED'           => 'COMPLETED',
            'ESCALATED'           => 'ESCALATED',
            'CLOSED_LOST'         => 'ESCALATED'
        };
        return norm.containsKey(key) ? norm.get(key) : 'PENDING';
    }

    private static String initials(String name) {
        if (String.isBlank(name)) return '?';
        List<String> parts = name.trim().split('\\s+');
        String i = parts[0].substring(0, 1).toUpperCase();
        if (parts.size() > 1) i += parts[parts.size()-1].substring(0, 1).toUpperCase();
        return i;
    }

    private static List<String> parseList(String val) {
        if (String.isBlank(val)) return new List<String>();
        List<String> out = new List<String>();
        for (String s : val.split('[,;]')) { if (String.isNotBlank(s.trim())) out.add(s.trim()); }
        return out;
    }

