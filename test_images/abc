    // --- NEW METHOD 1: Covers all exceptions and null/empty scenarios ---
    @isTest
    public static void testElseAndExceptionCases() {
        // 1. Constructor: appId == null (Covers missing Id else block)
        ApexPages.StandardController scNull = new ApexPages.StandardController(new Account());
        WebmergeDocForAccFormstack objNull = new WebmergeDocForAccFormstack(scNull);
        
        // 2. mulDocument: appId == null (Covers "Application Not Found" else block)
        objNull.mulDocument();
        
        // 3. singleAffidavitGenerateDocuments: recordId == null
        WebmergeDocForAccFormstack.singleAffidavitGenerateDocuments(null);
        
        // 4. Constructor & getAccountDetails with a valid format fake ID (Returns null, empty lists)
        Id fakeAccountId = '001000000000000AAA';
        ApexPages.currentPage().getParameters().put('Id', fakeAccountId);
        WebmergeDocForAccFormstack objFakeId = new WebmergeDocForAccFormstack(scNull);
        
        Account nullAcc = WebmergeDocForAccFormstack.getAccountDetails(fakeAccountId); // Hits the "return NULL;" else block
        
        // 5. getAccountDetails Exception & saveFormStackDocument Exception
        // Passing an invalid ID format ('InvalidId') will throw a QueryException which gets caught in the try-catch block
        String invalidId = 'InvalidId123';
        WebmergeDocForAccFormstack.getAccountDetails(invalidId); 
        WebmergeDocForAccFormstack.saveFormStackDocument(invalidId, 'N1', 'N2', 'N3', 'N4', 'N5', '2015-12-31', '2015-12-31', '2015-12-31', '2015-12-31', '2015-12-31', 'S1', 'S2', 'PAN Card');
        
        // 6. createFSRecord DML Exception
        // Setting an invalid reference (Assigning Contact Id to Account Lookup) triggers a Field Integrity Exception -> hits catch(DMLException)
        Id fakeContactId = '003000000000000AAA';
        objNull.appId = fakeContactId;
        objNull.createFSRecord(); 
        
        // singleAffidavitGenerateDocuments with a fake ID to run the empty List else behavior safely
        WebmergeDocForAccFormstack.singleAffidavitGenerateDocuments(fakeAccountId);
    }
    
