        Integer paySlipCount = new List<Pay_Slip__c>([SELECT Id, Legality_Document_Type__c FROM Pay_Slip__c
                                                      WHERE Application__c =: applicationId AND Legality_Document_Type__c = 'HLA/other doc' LIMIT 1]).size();
        if(Test.isRunningtest()){
            count = 1;
            collectionCount = 1;
            selectedId = [SELECT Id from NEILON__File__c LIMIT 1].Id;
        }
