        System.debug('wrap in Test ::'+wrap);
        
        wrap.otpVerificationCode = otp.OTP__c;
        wrap.disableResendButton = true;
        wrap.showSendButton = false;
        wrap.errorMessage = '';
        wrap.isSelected = false;
        wrap.isSign = false;
