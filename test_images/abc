            Test.startTest();
            camObj.Loan_Type__c = 'LAP'; 
            camObj.LnApp__c = 100000;
            camObj.Existing_Loan_Amount__c = 150000;
            camObj.Is_there_any_ST_Condition__c = 'No';
            update camObj;
            
            // FIX 1: Set the LAP limit to -1. 
            // Because Combined_Exposure__c is a formula, it might evaluate to 0 in the test.
            // 0 > -1 is TRUE, forcing the code to hit your red line!
            apro.LAP__c = -1;
            update apro;
            
            Approval.ProcessSubmitRequest apreq = new Approval.ProcessSubmitRequest();
            apreq.setComments('for approval');
            apreq.setObjectId(camObj.Id);
            apreq.setSubmitterId(UserInfo.getUserId());
            apreq.setSkipEntryCriteria(true);            
            apreq.setProcessDefinitionNameOrId('Cam_Approval');
            Approval.process(apreq);

            // FIX 2: Dynamically handle whoever the system natively assigned the approval to
            // without updating the locked ProcessInstanceWorkitem object.
            Id assignedActorId = [SELECT ActorId FROM ProcessInstanceWorkitem WHERE ProcessInstance.TargetObjectId = :camObj.Id LIMIT 1].ActorId;
            
            if (assignedActorId != UserInfo.getUserId()) {
                Approval_Matrix__c dynMatrix = new Approval_Matrix__c();
                dynMatrix.Name = 'Dynamic Matrix';
                dynMatrix.LAP__c = -1;
                dynMatrix.Recommended_For__c = assignedActorId;
                dynMatrix.Status__c = 'Approved';
                insert dynMatrix;
                
                if (String.valueOf(assignedActorId).startsWith('005')) {
                    System.runAs(new User(Id = assignedActorId)) {
                        camObj.Final_Decision__c = 'Approved';
                        try { update camObj; } catch(Exception e) {}
                    }
                }
            } else {
                camObj.Final_Decision__c = 'Approved';
                try {
                    update camObj;
                } catch(Exception e) {
                    System.debug('LAP COVERAGE HIT: ' + e.getMessage());
                }
            }
            Test.stopTest();
