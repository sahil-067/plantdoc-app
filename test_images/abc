    // Covers normaliseVcmStatus() + Main Applicant Account loop
    @isTest
    static void testGetCasesForDashboard() {
        User u1 = [SELECT Id FROM User WHERE Alias = 'vcm1' LIMIT 1];
        Opportunity opp = [SELECT Id, AccountId, Household__c FROM Opportunity WHERE Name = 'Test Loan' LIMIT 1];
        
        Customer__c cust = new Customer__c(
            Name = 'Test Customer',
            Case_Oringination_System__c = 'VRM',
            Assigned_VCM__c = u1.Id,
            VCM_Status__c = 'Pending'
        );
        cust.Query_Raised_count__c = 17;
        cust.Hindsight_Approval__c = 'Pending';
        cust.Credit_Hindsight_Approval__c = 'Approved';
        cust.Property_Paper_Storage_Date__c = System.today();
        cust.LoanAppID__c = opp.Id;
        insert cust;
    
        opp.Household__c = cust.Id;
        update opp;

        // Link Main Applicant Account to cust so the Account SOQL loop executes
        Account acc = new Account(Id = opp.AccountId, Household__c = cust.Id);
        update acc;
        
        Test.startTest();
        String jsonResult = VlmDashboardController.getCasesForDashboard();
        Test.stopTest();
    }
    
