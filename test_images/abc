);

            System.debug(
                LoggingLevel.INFO,
                'Creating Retention Lead'
                + ' | FirstName=' + retentionLead.FirstName
                + ' | LastName=' + retentionLead.LastName
                + ' | LeadPhone=' + maskPhone(applicant.mobile)
                + ' | BranchId=' + app.Branch__c
                + ' | CaseNumber=' + foreclosureCase.CaseNumber
            );

            insertRetentionLead(retentionLead);

            System.debug(
                LoggingLevel.INFO,
                'Retention Lead created'
                + ' | LeadId=' + retentionLead.Id
                + ' | LeadName=' + retentionLead.Name
            );

            /*
             * Step 4: Clear OTP fields after all records are created.
             */
            Account otpAccountToClear = new Account(
                Id = customerContext.account.Id
            );

            otpAccountToClear.CustomerOtp__c = null;

            if (approvalType == 'BRANCH_APPROVER') {
                otpAccountToClear.Underwriter_Otp__c = null;
            } else {
                otpAccountToClear.EBSOtp__c = null;
            }

            update otpAccountToClear;

            System.debug(
                LoggingLevel.INFO,
                'OTP values cleared'
                + ' | AccountId=' + otpAccountToClear.Id
                + ' | ApprovalType=' + approvalType
            );

            ForeclosureSubmitResult response =
                new ForeclosureSubmitResult();

            response.caseId = foreclosureCase.Id;
            response.caseNumber = foreclosureCase.CaseNumber;
            response.foreclosureRequestId = foreclosureRequest.Id;
            response.leadId = retentionLead.Id;
            response.leadName = retentionLead.Name;
            response.message =
                'Foreclosure Case ' + foreclosureCase.CaseNumber
                + ' and Retention Lead ' + retentionLead.Name
                + ' created successfully.';

            System.debug(
                LoggingLevel.INFO,
                'RetentionConsoleController.submitForeclosureRequest SUCCESS'
                + ' | CaseNumber=' + response.caseNumber
                + ' | LeadId=' + response.leadId
            );

            return response;

        } catch (Exception ex) {
            System.debug(
                LoggingLevel.ERROR,
                'RetentionConsoleController.submitForeclosureRequest FAILED'
                + ' | ApplicationId=' + applicationId
                + ' | ApprovalRecipient=' + approvalRecipient
                + ' | Message=' + ex.getMessage()
                + ' | Line=' + ex.getLineNumber()
                + ' | Stack=' + ex.getStackTraceString()
            );

            throw new AuraHandledException(
                'Unable to create Foreclosure Case and Retention Lead. '
                + ex.getMessage()
            );
        }
    }

    @AuraEnabled(cacheable=true)
    public static List<ApplicationSearchResult> searchApplications(
        String searchText
    ) {
        String term = String.isBlank(searchText)
            ? null
            : searchText.trim();

        if (term == null || term.length() < 2) {
            return new List<ApplicationSearchResult>();
        }

        String likeTerm = '%' + term + '%';

        List<Opportunity> apps = [
            SELECT Id,
                   Name,
                   Loan_Number__c,
                   AccountId,
                   ContactId,
                   Account.Name,
                   Account.Mobile__pc,
                   Account.Client_ID__pc,
                   Account.ClientNum__pc
            FROM Opportunity
            WHERE Name LIKE :likeTerm
               OR Loan_Number__c LIKE :likeTerm
               OR Account.Name LIKE :likeTerm
               OR Account.Mobile__pc LIKE :likeTerm
               OR Account.Client_ID__pc LIKE :likeTerm
               OR Account.ClientNum__pc LIKE :likeTerm
            ORDER BY LastModifiedDate DESC
            LIMIT 25
        ];

        List<ApplicationSearchResult> output =
            new List<ApplicationSearchResult>();

        for (Opportunity app : apps) {
            ApplicationSearchResult row =
                new ApplicationSearchResult();

            row.id = app.Id;
            row.applicationName = app.Name;
            row.loanNumber = firstNonBlank(
                new List<String>{ app.Loan_Number__c, '—' }
            );

            row.applicantName = app.AccountId == null
                ? 'Applicant not linked'
                : app.Account.Name;

            row.mobile = app.AccountId == null
                ? '—'
                : firstNonBlank(
                    new List<String>{
                        app.Account.Mobile__pc,
                        '—'
                    }
                );

            row.clientId = app.AccountId == null
                ? '—'
                : firstNonBlank(
                    new List<String>{
                        app.Account.Client_ID__pc,
                        app.Account.ClientNum__pc,
                        '—'
                    }
                );

            output.add(row);
        }

        return output;
    }

  
    @AuraEnabled(cacheable=true)
public static ConsoleData getRetentionConsoleData(Id recordId) {
    if (recordId == null) {
        throw new AuraHandledException(
            'Select a valid Lead or Application before loading the Retention Console.'
        );
    }

    if (recordId.getSObjectType() == Opportunity.SObjectType) {
        /*
         * Opened from Application:
         * recordId itself is the Application Id.
         */
        return getConsoleDataFromApplication(recordId, null);
    }

    if (recordId.getSObjectType() == Lead.SObjectType) {
        /*
         * Opened from Lead:
         * First identify its Case and Application.
         */
        return getConsoleDataFromLead(recordId);
    }

    throw new AuraHandledException(
        'Retention Console can be opened only from a Lead or Application record.'
    );
}

