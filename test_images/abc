@isTest
public class AttendanceTrackerMapControllerTest {

    @testSetup
    static void setupData() {
        // Get a Profile Id
        Profile p = [SELECT Id FROM Profile WHERE Name != null LIMIT 1];
        
        // Create Branch
        Branch__c branch = new Branch__c(
            Name = 'Test Branch',
            Branch_State__c = 'Delhi',
            Branch_PinCode__c = '110001',
            Branch_User__c = UserInfo.getUserId(),
            Branch_Location__Latitude__s = 28.6139,
            Branch_Location__Longitude__s = 77.2090,
            Geo_tag_for_Technical__Latitude__s = 28.6139,
            Geo_tag_for_Technical__Longitude__s = 77.2090
        );
        insert branch;
        
        // Create Users
        User hoUser = new User(
            Alias = 'huser',
            Email = 'ho@test.com',
            EmailEncodingKey = 'UTF-8',
            LastName = 'HO User',
            LanguageLocaleKey = 'en_US',
            LocaleSidKey = 'en_US',
            TimeZoneSidKey = 'Asia/Kolkata',
            ProfileId = p.Id,
            UserName = 'ho' + DateTime.now().getTime() + '@test.com',
            Base_Location__c = 'HO',
            EmployeeNumber = 'ISFC1234r'
        );
        
        User branchUser = new User(
            Alias = 'buser',
            Email = 'branch@test.com',
            EmailEncodingKey = 'UTF-8',
            LastName = 'Branch User',
            LanguageLocaleKey = 'en_US',
            LocaleSidKey = 'en_US',
            TimeZoneSidKey = 'Asia/Kolkata',
            ProfileId = p.Id,
            UserName = 'branch' + DateTime.now().getTime() + '@test.com',
            Base_Location__c = 'Branch',
            Designation__c = 'RCM',
            EmployeeNumber = 'ISFC1234E'
        );
        insert new List<User>{ hoUser, branchUser };
            
        // Create Employee Account (ISFCL - Employee RecordType)
        Id employeeRecordTypeId;
        try {
            employeeRecordTypeId = Schema.SObjectType.Account.getRecordTypeInfosByName().get('ISFCL - Employee').getRecordTypeId();
        } catch (Exception e) {
            employeeRecordTypeId = [SELECT Id FROM RecordType WHERE SObjectType='Account' LIMIT 1].Id;
        }
        
        // MODIFICATION: Created 3 Accounts to cover all IF/ELSE conditions. 
        // Fixed Designation__pc from 'CO' to 'C.O' so it matches the Controller's SOQL query.
        Account empAcc1 = new Account(LastName = 'Employee One', RecordTypeId = employeeRecordTypeId, Empl_Code__pc = branchUser.EmployeeNumber, Designation__pc = 'C.O', PersonDepartment = 'Collections', Branch__c = branch.Id);
        Account empAcc2 = new Account(LastName = 'Employee Two', RecordTypeId = employeeRecordTypeId, Empl_Code__pc = 'E002', Designation__pc = 'C.O', PersonDepartment = 'Collections', Branch__c = branch.Id);
        Account empAcc3 = new Account(LastName = 'Employee Three', RecordTypeId = employeeRecordTypeId, Empl_Code__pc = 'E003', Designation__pc = 'C.O', PersonDepartment = 'Collections', Branch__c = branch.Id);
        insert new List<Account>{ empAcc1, empAcc2, empAcc3 };
        
        // Update branch relationships
        branch.Zonal_Collection_Manager__c = branchUser.Id;
        branch.Branch_Regional_Collection__c = branchUser.Id;
        branch.Branch_Area_Collection__c = branchUser.Id;
        update branch;
        
        // Attendance RecordType (iCollect)
        Id attRecordTypeId;
        try {
            attRecordTypeId = Schema.sObjectType.Attendance__c.getRecordTypeInfosByName().get('iCollect').getRecordTypeId();
        } catch (Exception e) {
            attRecordTypeId = [SELECT Id FROM RecordType WHERE SObjectType='Attendance__c' LIMIT 1].Id;
        }
        
        // MODIFICATION: Created 3 distinct Attendance records (Active, Inactive, and Time-Lapsed)
        Attendance__c att1 = new Attendance__c(RecordTypeId = attRecordTypeId, Active__c = true, Account__c = empAcc1.Id, Branch__c = branch.Id, Employee_ID__c = 'E001', Current_Location__Latitude__s = 28.7041, Current_Location__Longitude__s = 77.1025);
        Attendance__c att2 = new Attendance__c(RecordTypeId = attRecordTypeId, Active__c = false, Account__c = empAcc2.Id, Branch__c = branch.Id, Employee_ID__c = 'E002', Current_Location__Latitude__s = 28.7041, Current_Location__Longitude__s = 77.1025);
        Attendance__c att3 = new Attendance__c(RecordTypeId = attRecordTypeId, Active__c = true, Account__c = empAcc3.Id, Branch__c = branch.Id, Employee_ID__c = 'E003', Current_Location__Latitude__s = 28.7041, Current_Location__Longitude__s = 77.1025);
        insert new List<Attendance__c>{ att1, att2, att3 };
            
        // MODIFICATION: Push att3's CreatedDate back >45 mins to test the "45 minutes elapsed" inactive branch
        Test.setCreatedDate(att3.Id, DateTime.now().addMinutes(-60));
    }
    
    // ----------------------------------------------------
    // Test: getCurrentUserDetails() - Branch User
    // ----------------------------------------------------
    @isTest
    static void testGetCurrentUserDetails_BranchUser() {
        User branchUser = [SELECT Id FROM User WHERE Base_Location__c = 'Branch' LIMIT 1];
        System.runAs(branchUser) {
            Test.startTest();
            AttendanceTrackerMapController.RecordLocationWrapper result = AttendanceTrackerMapController.getCurrentUserDetails();
            Test.stopTest();
            System.assertNotEquals(null, result);
        }
    }
    
    // ----------------------------------------------------
    // Test: getCurrentUserDetails() - HO User
    // ----------------------------------------------------
    @isTest
    static void testGetCurrentUserDetails_HOUser() {
        User hoUser = [SELECT Id FROM User WHERE Base_Location__c = 'HO' LIMIT 1];
        System.runAs(hoUser) {
            Test.startTest();
            AttendanceTrackerMapController.RecordLocationWrapper result = AttendanceTrackerMapController.getCurrentUserDetails();
            Test.stopTest();
            System.assertNotEquals(null, result);
        }
    }
    
    // ----------------------------------------------------
    // Test: getUserState()
    // ----------------------------------------------------
    @isTest
    static void testGetUserState() {
        User branchUser = [SELECT Id FROM User WHERE Base_Location__c = 'Branch' LIMIT 1];
        Test.startTest();
        List<String> states = AttendanceTrackerMapController.getUserState(branchUser.Id);
        List<String> nullStates = AttendanceTrackerMapController.getUserState(''); // MODIFICATION: covers String.isNotBlank else block
        Test.stopTest();
        System.assertNotEquals(null, states);
    }
    
    // ----------------------------------------------------
    // Test: toggleBranchView()
    // ----------------------------------------------------
    @isTest
    static void testToggleBranchView() {
        User branchUser = [SELECT Id FROM User WHERE Base_Location__c = 'Branch' LIMIT 1];
        Test.startTest();
        List<AttendanceTrackerMapController.LocationWrapper> locs1 = AttendanceTrackerMapController.toggleBranchView(branchUser.Id, 'Delhi', false);
        List<AttendanceTrackerMapController.LocationWrapper> locs2 = AttendanceTrackerMapController.toggleBranchView(branchUser.Id, null, true); // Pan India
        List<AttendanceTrackerMapController.LocationWrapper> locs3 = AttendanceTrackerMapController.toggleBranchView('', 'Delhi', false); // MODIFICATION: covers String.isBlank(selectedUserId)
        Test.stopTest();
    }
    
    // ----------------------------------------------------
    // Test: loadAttendance()
    // ----------------------------------------------------
    @isTest
    static void testLoadAttendance() {
        User branchUser = [SELECT Id FROM User WHERE Base_Location__c = 'Branch' LIMIT 1];
        Test.startTest();
        AttendanceTrackerMapController.RecordLocationWrapper wrapper1 = AttendanceTrackerMapController.loadAttendance(branchUser.Id, 'Delhi', false);
        AttendanceTrackerMapController.RecordLocationWrapper wrapper2 = AttendanceTrackerMapController.loadAttendance(branchUser.Id, 'Delhi', true); // MODIFICATION: covers the isHO branches
        Test.stopTest();
    }
    
    // ----------------------------------------------------
    // Test: loadAttendancePanIndia()
    // ----------------------------------------------------
    @isTest
    static void testLoadAttendancePanIndia() {
        Test.startTest();
        AttendanceTrackerMapController.RecordLocationWrapper wrapper = AttendanceTrackerMapController.loadAttendancePanIndia(true);
        Test.stopTest();
    }
    
    // ----------------------------------------------------
    // MODIFICATION: New Test to cover Catch Blocks
    // ----------------------------------------------------
    @isTest
    static void testExceptionBlocks() {
        Test.startTest();
        // Force errors by passing a deliberately invalid Id to hit the Catch statements
        AttendanceTrackerMapController.RecordLocationWrapper ex1 = AttendanceTrackerMapController.loadAttendance('invalid_id', 'Delhi', false);
        List<String> ex2 = AttendanceTrackerMapController.getUserState('invalid_id');
        
        System.assertEquals(null, ex1);
        System.assertEquals(null, ex2);
        Test.stopTest();
    }
}
