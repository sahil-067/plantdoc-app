        Account badAcc = acc.clone(true, false, false, false);
        badAcc.Pin_Code__pc = 120000; // Ends in 000
        try { CIBILIntegrationTriggerHelper.generateCIBILNew(JSON.serialize(badAcc), 2000); } catch(Exception e){}
        
        Account badAcc2 = acc.clone(true, false, false, false);
        badAcc2.Pin_Code__pc = 12345; // Short length
        try { CIBILIntegrationTriggerHelper.generateCIBILNew(JSON.serialize(badAcc2), 2000); } catch(Exception e){}
        
