@isTest
public class CalculateInsuranceRaiseDevTest {
    
    @testSetup
    static void setupTestData() {
        // Create a base Opportunity to generate a valid real Id for successful DML inserts
        Opportunity testOpp = new Opportunity(
            Name = 'Test Insurance Opp',
            StageName = 'Prospecting',
            CloseDate = Date.today().addDays(30)
        );
        insert testOpp;
    }

    @isTest
    static void testRaisedDeviation_Success() {
        // 1. Get the real Opportunity ID created in testSetup
        Opportunity realOpp = [SELECT Id FROM Opportunity LIMIT 1];
        Id currentUserId = UserInfo.getUserId();
        
        // 2. Mock the Opportunity and its Parent Relationships in memory using JSON
        // This avoids needing to insert Branches, Users, etc., if we don't know your exact schema validations
        String oppJson = '{' +
            '"attributes":{"type":"Opportunity"},' +
            '"Id":"' + realOpp.Id + '",' +
            '"Sanctioned_Tenure__c":120,' +
            '"Branch__r":{' +
                '"attributes":{"type":"Account"},' +
                '"Business_Head__c":"' + currentUserId + '",' +
                '"Business_Head__r":{' +
                    '"attributes":{"type":"User"},' +
                    '"Name":"Test Branch Manager"' +
                '}' +
            '}' +
        '}';
        Opportunity mockedOpp = (Opportunity) JSON.deserialize(oppJson, Opportunity.class);
        List<Opportunity> oppList = new List<Opportunity>{ mockedOpp };
            
        // 3. Mock the CalculateInsurance wrapper list via JSON 
        // This ensures it works even if your wrapper constructors are private or require parameters
        String wrapperJson = '[' +
            '{' +
                '"applicantDetails": "Primary Applicant",' +
                '"applicantName": "John Doe",' +
                '"lifeInsurance": "Yes",' +
                '"FinalLifeInsuranceCompanyName": "LIC",' +
                '"LifeInsurancePremium2": "5000",' +
                '"LifeInsuranceList": [{"isSelected": true, "lifeInsuranceTenure": "5"}],' +
                '"PropertyInsurance": "Yes",' +
                '"FinalPropertyInsuranceCompanyName": "HDFC Ergo",' +
                '"FinalPropertyInsurancePremium": 2000,' +
                '"PropertyInsuranceList": [{"isSelected": true, "propertyTenure": 10}],' +
                '"HealthInsuranceRequired": "Yes",' +
                '"FinalHealthInsuranceCompanyName": "Star Health",' +
                '"FinalHealthInsurancePremium": 3000,' +
                '"HealthInsuranceList": [{"isSelected": true, "HealthInsuranceTenure": 3}]' +
            '}' +
        ']';
        
        List<CalculateInsuranceLWCController.CalculateInsurance> calcInsList = 
            (List<CalculateInsuranceLWCController.CalculateInsurance>) JSON.deserialize(wrapperJson, List<CalculateInsuranceLWCController.CalculateInsurance>.class);
        
        Test.startTest();
        // Execute target method
        String result = CalculateInsuranceRaiseDeviation.raisedDeviation(
            oppList, 
            150000.00, 
            12000.00, 
            calcInsList, 
            'Valid Deviation Reason'
        );
        Test.stopTest();
        
        // Assertions
        System.assertEquals('', result, 'Method should not return an error message on success.');
        
        // Verify Deviation got created
        List<Deviation__c> insertedDeviations = [SELECT Id, Waiver__c, Type_of_Waiver__c FROM Deviation__c WHERE Opportunity__c = :realOpp.Id];
        System.assertEquals(1, insertedDeviations.size(), 'A deviation record should have been inserted successfully.');
        System.assertEquals('Life Insurance Tenure', insertedDeviations[0].Waiver__c, 'Waiver type should map correctly.');
    }

    @isTest
    static void testRaisedDeviation_InsertErrors() {
        // Generate a fake Opportunity ID so that Database.insert() fails gracefully.
        // This is done to hit and cover the "if (!sr.isSuccess())" code block!
        Id fakeOppId = '006000000000000AAA';
        
        String oppJson = '{' +
            '"attributes":{"type":"Opportunity"},' +
            '"Id":"' + fakeOppId + '",' + 
            '"Sanctioned_Tenure__c":120' +
        '}';
        Opportunity mockedOpp = (Opportunity) JSON.deserialize(oppJson, Opportunity.class);
        
        // Passing wrappers with "No" to cover the fallback logical paths
        String wrapperJson = '[{' +
            '"applicantDetails": "Co-Applicant",' +
            '"applicantName": "Jane Doe",' +
            '"lifeInsurance": "No",' +
            '"PropertyInsurance": "No",' +
            '"HealthInsuranceRequired": "No"' +
        '}]';
        
        List<CalculateInsuranceLWCController.CalculateInsurance> calcInsList = 
            (List<CalculateInsuranceLWCController.CalculateInsurance>) JSON.deserialize(wrapperJson, List<CalculateInsuranceLWCController.CalculateInsurance>.class);
        
        Test.startTest();
        String result = CalculateInsuranceRaiseDeviation.raisedDeviation(
            new List<Opportunity>{ mockedOpp }, 
            150000.00, 
            12000.00, 
            calcInsList, 
            'Will fail on save'
        );
        Test.stopTest();
        
        // The fake ID guarantees a database INVALID_CROSS_REFERENCE_KEY error, properly covering your error iteration loop.
        System.assertEquals('', result, 'Result remains empty because Database.insert was called with allOrNone=false');
    }

    @isTest
    static void testRaisedDeviation_ExceptionBlock() {
        Test.startTest();
        try {
            // Intentionally passing null lists to trigger a NullPointerException.
            // This ensures the Catch block and AuraHandledException logic is thoroughly covered.
            CalculateInsuranceRaiseDeviation.raisedDeviation(
                null, 
                150000.00, 
                12000.00, 
                null, 
                'Crash the method'
            );
            System.assert(false, 'Expected an AuraHandledException to be thrown');
        } catch (AuraHandledException e) {
            // Assertion confirms exception was successfully caught and transformed
            System.assert(e != null, 'AuraHandledException was successfully caught.');
        } catch (Exception e) {
            System.assert(false, 'Expected an AuraHandledException, but got a different exception: ' + e.getMessage());
        }
        Test.stopTest();
    }
}

